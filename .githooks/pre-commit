#!/bin/sh
# Opt in with: git config --local core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
# Tests create their own repositories; do not pass this commit's index or Git
# directory into them. Git documents this list for hooks invoking other repos.
git_variables=$(git rev-parse --local-env-vars)
for variable in $git_variables; do
    unset "$variable"
done
# The pre-commit tier; the full suite runs before merge and in CI.
# Eask on PATH works offline; MEVEDEL_TEST_JOBS limits the test workers.
if command -v eask >/dev/null 2>&1; then
    exec eask run script check -- --affected
fi
exec npx @emacs-eask/cli run script check -- --affected
