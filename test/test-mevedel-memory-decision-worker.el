(mevedel-deftest mevedel-memory-decision-schedule-recovery/dispatch ()
  ,test
  (test)
  :doc "native admission IO remains observed and reentrant scheduling cannot replace its callback"
  (dolist (failure '(nil error quit replacement cleanup-cancel))
    (let* ((root (make-temp-file "mevedel-recovery-dispatch-" t))
           (workspace (mevedel-workspace--create :root root))
           (key (mevedel-memory-store--claim-directory workspace))
           (mevedel-memory-decision--inhibit-recovery nil)
           (mevedel-memory-decision--recovery-pending (make-hash-table :test #'equal))
           (mevedel-memory-decision--recovery-dispatching (make-hash-table :test #'equal))
           (mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
           (mevedel-transport--background-running nil)
           (mevedel-transport--background-resume-at 0)
           (exists (symbol-function 'mevedel-session-control-fs-path-exists-p))
           (replacement (list :replacement t))
           (callbacks 0) entered interrupted warnings timer)
      (unwind-protect
          (cl-letf (((symbol-function 'display-warning) (lambda (_ text &rest _) (push text warnings)))
                    ((symbol-function 'mevedel-session-control-fs-path-exists-p)
                     (lambda (path)
                       (when (and (equal path key) (not entered))
                         (setq entered t)
                         (should-not inhibit-quit)
                         (should-not (gethash key mevedel-memory-decision--recovery-pending))
                         (should (mevedel-memory-decision-recovering-p workspace))
                         (mevedel-memory-decision-schedule-recovery
                          workspace (lambda () (ert-fail "Dispatch callback was replaced")))
                         (should-not (gethash key mevedel-memory-decision--recovery-pending))
                         (pcase failure
                           ('error (error "Injected dispatch IO failure"))
                           ('quit (signal 'quit nil))
                           ('replacement (puthash key replacement mevedel-memory-decision--recovery-dispatching))))
                       (funcall exists path)))
                    ((symbol-function 'mevedel-journal-cleanup-active-p)
                     (lambda (_)
                       (when (eq failure 'cleanup-cancel) (mevedel-memory-decision-stop-recovery))
                       nil)))
            (mevedel-memory-decision-schedule-recovery workspace (lambda () (cl-incf callbacks)))
            (should (mevedel-memory-decision-recovering-p workspace))
            (setq timer (gethash key mevedel-memory-decision--recovery-pending))
            (cancel-timer timer)
            (condition-case nil
                (apply (timer--function timer) (timer--args timer))
              (quit (setq interrupted t)))
            (should entered)
            (should-not (gethash key mevedel-memory-decision--recovery-pending))
            ;; Replaced dispatch no longer owns the original callback.
            (should (= (if (memq failure '(error quit replacement cleanup-cancel)) 0 1) callbacks))
            (if (eq failure 'error)
                (should (seq-some (lambda (text) (string-match-p "Injected dispatch IO failure" text)) warnings))
              (should-not warnings))
            (should (eq (eq failure 'quit) interrupted))
            (if (eq failure 'replacement)
                (should (eq replacement (gethash key mevedel-memory-decision--recovery-dispatching)))
              (should-not (mevedel-memory-decision-recovering-p workspace))))
        (when timer (cancel-timer timer))
        (mevedel-transport-cancel-idle mevedel-memory-decision--recovery-pending 'memory-recovery)
        (delete-directory root t)))))

(mevedel-deftest mevedel-memory-decision-schedule-recovery/priority ()
  (let* ((root (file-name-as-directory (make-temp-file "recovery-drain-priority-" t)))
         (workspace (mevedel-workspace--create :root root))
         (key (mevedel-memory-store--claim-directory workspace))
         (origin (generate-new-buffer " *recovery-origin*"))
         (mevedel-memory-dirs nil)
         (mevedel-memory-consolidation-mode 'manual)
         (mevedel-memory-pass--running (make-hash-table :test #'equal))
         (mevedel-memory-pass--drains (make-hash-table :test #'equal))
         (mevedel-memory-decision--operations (make-hash-table :test #'equal))
         (mevedel-memory-decision--recovery-pending (make-hash-table :test #'equal))
         (mevedel-memory-decision--recovery-dispatching (make-hash-table :test #'equal))
         (mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (mevedel-memory-decision--inhibit-recovery nil)
         (mevedel-transport--background-running nil)
         (mevedel-transport--background-resume-at 0)
         drain outcomes recovery-job recovery-ready prepare-ready prepare-payload
         (recovered 0) (recoveries 0) (preparations 0))
    (unwind-protect
        (progn
          (mevedel-workspace-identity-ensure root)
          (make-directory key t)
          (cl-letf (((symbol-function 'mevedel-journal-worker-start)
                     (lambda (_workspace operation callback &optional _force payload owner)
                       (pcase operation
                         ('memory-recover
                          (cl-incf recoveries)
                          (setq recovery-ready callback recovery-job owner)
                          (should (eq owner (gethash key mevedel-memory-decision--recovery-workers)))
                          (should (mevedel-journal-claim-owned-p (plist-get owner :claim))))
                         ('memory-prepare
                          (cl-incf preparations)
                          (setq prepare-ready callback prepare-payload payload)
                          (should (mevedel-journal-claim-owned-p (plist-get payload :claim))))
                         (_ (ert-fail (format "Unexpected worker %S" operation))))
                       nil))
                    ((symbol-function 'mevedel-model-resolve-workload)
                     (lambda (&rest _) (ert-fail "Empty coordination case reached a provider"))))
            (cl-labels
                ((deliver (timer)
                   (should (timerp timer))
                   (cancel-timer timer)
                   (let ((mevedel-transport--background-resume-at 0))
                     (apply (timer--function timer) (timer--args timer))))
                 (start-drain ()
                   (with-current-buffer origin
                     (setq drain (mevedel-memory-pass-drain workspace (lambda (result) (push result outcomes)))))
                   (cancel-timer (plist-get drain :timer)))
                 (schedule ()
                   (with-current-buffer origin
                     (mevedel-memory-decision-schedule-recovery
                      workspace (lambda () (should (eq origin (current-buffer))) (cl-incf recovered))))
                   (let ((timer (gethash key mevedel-memory-decision--recovery-pending)))
                     (deliver timer)
                     timer))
                 (finish-recovery ()
                   (should (mevedel-journal-claim-owned-p (plist-get recovery-job :claim)))
                   (funcall recovery-ready (list :ok t :synchronous t
                                                 :operation-id (plist-get (plist-get recovery-job :claim) :owner)))
                   (should (eq 'cancelled (plist-get (mevedel-journal-claim-outcome
                                                     (plist-get recovery-job :claim)) :status)))
                   (deliver (plist-get recovery-job :timer)))
                 (finish-prepare ()
                   (funcall prepare-ready
                            (list :ok t :prepared (mevedel-memory-pass--prepare workspace prepare-payload)))))
              ,test
              (should (= 1 recovered))
              (should-not (mevedel-memory-pass-running workspace))
              (should-not (mevedel-memory-pass-drain-status workspace))
              (should-not (mevedel-memory-decision-recovering-p workspace)))))
      (mevedel-memory-pass-cancel workspace)
      (mevedel-memory-decision-stop-recovery)
      (kill-buffer origin)
      (delete-directory root t)))
  (test)

  :doc "registered drain keeps priority over new recovery, including waiting gaps, and callback survives"
  (progn
    (start-drain)
    (plist-put drain :status 'waiting)
    (let ((timer (schedule)))
      (mevedel-memory-pass--drain-step drain)
      ;; On the old source this assertion exposes the exact native busy error.
      (should-not outcomes)
      (should (eq timer (gethash key mevedel-memory-decision--recovery-pending)))
      (should (time-less-p (time-add nil .5) (timer--time timer)))
      (should (= 0 recoveries))
      (should-not (mevedel-memory-decision-admitted-p key))
      (should (= 1 preparations))
      (finish-prepare)
      (should (eq 'empty (plist-get (car outcomes) :outcome)))
      (deliver timer))
    (should (= 1 recoveries))
    (finish-recovery))

  :doc "already admitted recovery completes while a newly registered drain waits without error"
  (progn
    (schedule)
    (should (= 1 recoveries))
    (should (mevedel-memory-decision-admitted-p key))
    (start-drain)
    (mevedel-memory-pass--drain-step drain)
    (should-not outcomes)
    (should (eq 'waiting (plist-get drain :status)))
    (should (= 0 preparations))
    (finish-recovery)
    (deliver (plist-get drain :timer))
    (should (= 1 preparations))
    (finish-prepare)
    (should (eq 'empty (plist-get (car outcomes) :outcome))))

  :doc "already admitted pass postpones new recovery rather than losing its original callback"
  (progn
    (start-drain)
    (mevedel-memory-pass--drain-step drain)
    (let ((timer (schedule)))
      (should (= 0 recoveries))
      (should (= 0 recovered))
      (finish-prepare)
      (deliver timer))
    (should (= 1 recoveries))
    (finish-recovery))

  :doc "pre-admission recovery path IO cannot make a registered drain wait for its pending contender"
  (let ((exists (symbol-function 'mevedel-session-control-fs-path-exists-p)) injected timer)
    (start-drain)
    (cl-letf (((symbol-function 'mevedel-session-control-fs-path-exists-p)
               (lambda (path)
                 (prog1 (funcall exists path)
                   (when (and (equal path key) (not injected))
                     (setq injected t)
                     (should-not (mevedel-memory-decision-admitted-p key))
                     (mevedel-memory-pass--drain-step drain))))))
      (setq timer (schedule)))
    (should injected)
    (should (= 1 preparations))
    (should (= 0 recoveries))
    (should-not outcomes)
    (finish-prepare)
    (deliver timer)
    (finish-recovery))

  :doc "already reserved recovery claim IO makes a new drain wait until its original callback completes"
  (let ((acquire (symbol-function 'mevedel-journal-claim-acquire)) injected)
    (cl-letf (((symbol-function 'mevedel-journal-claim-acquire)
               (lambda (directory &rest args)
                 (when (and (equal directory key) (not injected))
                   (setq injected t)
                   (should (mevedel-memory-decision-admitted-p key))
                   (start-drain)
                   (mevedel-memory-pass--drain-step drain))
                 (apply acquire directory args))))
      (schedule))
    (should injected)
    (should (eq 'waiting (plist-get drain :status)))
    (should (= 0 preparations))
    (should-not outcomes)
    (finish-recovery)
    (deliver (plist-get drain :timer))
    (finish-prepare))

  :doc "drain registration during the final cleanup observation still wins pending recovery admission"
  (let ((active (symbol-function 'mevedel-journal-cleanup-active-p)) injected timer)
    (cl-letf (((symbol-function 'mevedel-journal-cleanup-active-p)
               (lambda (value)
                 (prog1 (funcall active value)
                   (unless injected (setq injected t) (start-drain))))))
      (setq timer (schedule)))
    (should injected)
    (should (= 0 recoveries))
    (should (eq timer (gethash key mevedel-memory-decision--recovery-pending)))
    (mevedel-memory-pass--drain-step drain)
    (finish-prepare)
    (deliver timer)
    (finish-recovery))

  :doc "an already active native cleanup retains claims while recovery queues its original callback"
  (let* ((mevedel-journal-cleanup--journal-only t)
         (mevedel-journal-cleanup--active (make-hash-table :test #'equal))
         (iterator (mevedel-journal-cleanup--steps workspace t))
         (active (list :cleanup iterator)) claim timer)
    (unwind-protect
        (progn
          (puthash root active mevedel-journal-cleanup--active)
          (dotimes (_ 8)
            (unless claim
              (let ((step (iter-next iterator))) (when (functionp step) (funcall step)))
              (setq claim (mevedel-journal-claim-current key))))
          (should claim)
          (should (mevedel-journal-claim-owned-p claim))
          (setq timer (schedule))
          (should (= 0 recoveries))
          (should (eq timer (gethash key mevedel-memory-decision--recovery-pending)))
          (should (time-less-p (time-add nil .5) (timer--time timer)))
          (should (mevedel-journal-claim-owned-p claim))
          (iter-close iterator)
          (remhash root mevedel-journal-cleanup--active)
          (should (eq 'completed (plist-get (mevedel-journal-claim-outcome claim) :status)))
          (deliver timer)
          (finish-recovery))
      (iter-close iterator)
      (remhash root mevedel-journal-cleanup--active))))

(mevedel-deftest mevedel-memory-decision-schedule-recovery/unsupported
		 (:doc "unsupported workers retain native ownership, both ordering directions and original cancellation")
		 (dolist (scenario '(drain-first recovery-first cancel))
		   (ert-info ((format "scenario=%S" scenario))
			     (let* ((root (file-name-as-directory (make-temp-file "recovery-unsupported-" t)))
				    (workspace (mevedel-workspace--create :root root))
				    (key (mevedel-memory-store--claim-directory workspace))
				    (origin (generate-new-buffer " *unsupported-recovery-origin*"))
				    (mevedel-memory-dirs nil)
				    (mevedel-memory-consolidation-mode 'manual)
				    (mevedel-memory-decision--inhibit-recovery nil)
				    (mevedel-transport--background-running nil)
				    (mevedel-transport--background-resume-at 0)
				    (recover (symbol-function 'mevedel-memory-decision-recover))
				    (store (symbol-function 'mevedel-memory-store-recover))
				    job drain outcomes events (callbacks 0))
			       (unwind-protect
				   (progn
				     (mevedel-workspace-identity-ensure root)
				     (make-directory key t)
				     (cl-labels
				      ((deliver (timer)
					 (should (timerp timer))
					 (cancel-timer timer)
					 (let ((mevedel-transport--background-resume-at 0))
					   (apply (timer--function timer) (timer--args timer))))
				       (start-drain ()
					 (with-current-buffer origin
					   (setq drain (mevedel-memory-pass-drain workspace (lambda (reply) (push reply outcomes)))))
					 (cancel-timer (plist-get drain :timer))))
				      (cl-letf (((symbol-function 'mevedel-journal-worker-supported-p) (lambda (_) nil))
						((symbol-function 'mevedel-journal-worker-start)
						 (lambda (&rest _) (ert-fail "Unsupported recovery started a child")))
						((symbol-function 'mevedel-model-resolve-workload)
						 (lambda (&rest _) (ert-fail "Empty recovery/drain reached a provider")))
						((symbol-function 'mevedel-memory-decision-recover)
						 (lambda (&rest args)
						   (if (not (gethash key mevedel-memory-decision--recovery-workers))
						       (apply recover args)
						     (setq job (gethash key mevedel-memory-decision--recovery-workers))
						     (should (mevedel-journal-claim-owned-p (plist-get job :claim)))
						     (should (timerp (plist-get job :timer)))
						     (push 'decisions events)
						     (prog1 (apply recover args)
						       (pcase scenario
							 ('recovery-first
							  (start-drain)
							  (mevedel-memory-pass--drain-step drain)
							  (should (eq 'waiting (plist-get drain :status)))
							  (should-not outcomes))
							 ('cancel (mevedel-memory-decision-stop-recovery)))))))
						((symbol-function 'mevedel-memory-store-recover)
						 (lambda (&rest args)
						   ;; Pass preparation also recovers its own store.
						   (when (gethash key mevedel-memory-decision--recovery-workers)
						     (should (mevedel-journal-claim-owned-p (plist-get job :claim)))
						     (push 'store events))
						   (apply store args))))
					       (when (eq scenario 'drain-first) (start-drain))
					       (with-current-buffer origin
						 (mevedel-memory-decision-schedule-recovery
						  workspace (lambda () (should (eq origin (current-buffer))) (cl-incf callbacks))))
					       (let ((timer (gethash key mevedel-memory-decision--recovery-pending)))
						 (deliver timer)
						 (when (eq scenario 'drain-first)
						   (should-not events)
						   (should (eq timer (gethash key mevedel-memory-decision--recovery-pending)))
						   (mevedel-memory-pass--drain-step drain)
						   (should (eq 'empty (plist-get (car outcomes) :outcome)))
						   (deliver timer)))
					       (should (eq 'cancelled (plist-get (mevedel-journal-claim-outcome (plist-get job :claim)) :status)))
					       (should (= 0 callbacks))
					       (if (eq scenario 'cancel)
						   (should (equal '(decisions) events))
						 (should (equal '(store decisions) events))
						 (deliver (plist-get job :timer))
						 (should (= 1 callbacks)))
					       (when (eq scenario 'recovery-first)
						 (deliver (plist-get drain :timer))
						 (should (eq 'empty (plist-get (car outcomes) :outcome))))))
				     (mevedel-memory-pass-cancel workspace)
				     (mevedel-memory-decision-stop-recovery)
				     (kill-buffer origin)
				     (delete-directory root t)))))))

(mevedel-deftest mevedel-memory-decision-schedule-recovery/invalidation
  (:doc "cancellation, replacement and root/key changes across IO never admit the old opportunity")
  (dolist (phase '(path key cleanup claim))
    (dolist (action (if (eq phase 'claim) '(cancel successor root key)
                     '(cancel successor successor-error root key)))
      (ert-info ((format "phase=%S action=%S" phase action))
        (let* ((root (file-name-as-directory (make-temp-file "recovery-invalid-" t)))
               (workspace (mevedel-workspace--create :root root))
               (key (mevedel-memory-store--claim-directory workspace))
               (mevedel-memory-decision--inhibit-recovery nil)
               (mevedel-memory-decision--recovery-pending (make-hash-table :test #'equal))
               (mevedel-memory-decision--recovery-dispatching (make-hash-table :test #'equal))
               (mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
               (mevedel-transport--background-running nil)
               (mevedel-transport--background-resume-at 0)
               (exists (symbol-function 'mevedel-session-control-fs-path-exists-p))
               (directory (symbol-function 'mevedel-memory-store--claim-directory))
               (acquire (symbol-function 'mevedel-journal-claim-acquire))
               timer successor injected armed ready job claimed changed-key diagnostics
               (callbacks 0) (successor-callbacks 0) (workers 0))
          (unwind-protect
              (progn
                (mevedel-workspace-identity-ensure root)
                (make-directory key t)
                (cl-labels
                    ((inject ()
                       (when (and armed (not injected))
                         (setq injected t)
                         (pcase action
                           ((or 'cancel 'successor 'successor-error)
                            (mevedel-memory-decision-stop-recovery)
                            (when (memq action '(successor successor-error))
                              (mevedel-memory-decision-schedule-recovery
                               workspace (lambda () (cl-incf successor-callbacks)))
                              (setq successor (gethash key mevedel-memory-decision--recovery-pending)))
                            (when (eq action 'successor-error) (error "Injected old recovery IO failure")))
                           ('root (setf (mevedel-workspace-root workspace) (file-name-concat root "changed/")))
                           ('key (setq changed-key t)))))
                     (deliver (value)
                       (cancel-timer value)
                       (let ((mevedel-transport--background-resume-at 0))
                         (apply (timer--function value) (timer--args value)))))
                  (cl-letf (((symbol-function 'mevedel-session-control-fs-path-exists-p)
                             (lambda (path)
                               (prog1 (funcall exists path)
                                 (when (and (eq phase 'path) (equal path key)) (inject)))))
                            ((symbol-function 'mevedel-memory-store--claim-directory)
                             (lambda (value)
                               (let ((path (funcall directory value)))
                                 (when (eq phase 'key) (inject))
                                 (if changed-key (concat key "-changed") path))))
                            ((symbol-function 'mevedel-journal-cleanup-active-p)
                             (lambda (_)
                               (when (eq phase 'cleanup) (inject))
                               nil))
                            ((symbol-function 'mevedel-journal-claim-acquire)
                             (lambda (&rest args)
                               (let ((result (apply acquire args)))
                                 (when (and result (eq phase 'claim) (not injected))
                                   (setq claimed result)
                                   (inject))
                                 result)))
                            ((symbol-function 'mevedel-journal-worker-start)
                             (lambda (_workspace kind callback &optional _force _payload owner)
                               (should (eq kind 'memory-recover))
                               (cl-incf workers)
                               (setq ready callback job owner)
                               nil)))
                    (mevedel-memory-decision-schedule-recovery workspace (lambda () (cl-incf callbacks)))
                    (setq timer (gethash key mevedel-memory-decision--recovery-pending) armed t)
                    (mevedel-test--with-captured-diagnostics diagnostics (deliver timer))
                    (should injected)
                    (if (eq action 'successor-error)
                        (should (string-match-p "Injected old recovery IO failure" diagnostics))
                      (should (string-empty-p diagnostics)))
                    (should (= 0 workers))
                    (should (= 0 callbacks))
                    (when claimed
                      (should (eq 'cancelled (plist-get (mevedel-journal-claim-outcome claimed) :status))))
                    (when successor
                      (should (eq successor (gethash key mevedel-memory-decision--recovery-pending)))
                      ;; Invoking the superseded timer cannot erase the new one.
                      (deliver timer)
                      (should (eq successor (gethash key mevedel-memory-decision--recovery-pending)))
                      (deliver successor)
                      (should (= 1 workers))
                      (funcall ready (list :ok t :synchronous t
                                           :operation-id (plist-get (plist-get job :claim) :owner)))
                      (deliver (plist-get job :timer))
                      (should (= 1 successor-callbacks)))
                    (should (= 0 callbacks))
                    (should-not (gethash key mevedel-memory-decision--recovery-workers))
                    (should-not (gethash key mevedel-memory-decision--recovery-dispatching))
                    (should-not (mevedel-memory-decision-recovering-p workspace)))))
            (setf (mevedel-workspace-root workspace) root)
            (mevedel-memory-decision-stop-recovery)
            (delete-directory root t)))))))

(mevedel-deftest mevedel-memory-decision--start-recovery/cancel-launch
  (:doc "cancellation in request IO fences first and retires the real child handed off afterwards")
  (let* ((root (file-name-as-directory (make-temp-file "recovery-cancel-launch-" t)))
         (workspace (mevedel-workspace--create :root root))
         (key (mevedel-memory-store--claim-directory workspace))
         (mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (write (symbol-function 'mevedel-journal-worker--write))
         (spawn (symbol-function 'make-process))
         entered launched fenced-at-launch job callback)
    (unwind-protect
        (cl-letf (((symbol-function 'mevedel-journal-worker--write)
                   (lambda (&rest args)
                     (prog1 (apply write args)
                       (unless entered
                         (setq entered t)
                         (mevedel-memory-decision-stop-recovery)))))
                  ((symbol-function 'make-process)
                   (lambda (&rest args)
                     (let* ((owner (mevedel-journal-claim-current key))
                            (outcome (mevedel-journal-claim-outcome owner)))
                       (setq fenced-at-launch (eq 'cancelled (plist-get outcome :status))))
                     (setq launched (apply spawn args)))))
          (setq job (mevedel-memory-decision--start-recovery workspace (lambda () (setq callback t)) (current-buffer) #'always key))
          (should entered)
          (should fenced-at-launch)
          (should (processp launched))
          (should-not (process-live-p launched))
          (should (plist-get job :released))
          (should-not callback)
          (should-not (gethash key mevedel-memory-decision--recovery-workers)))
      (mevedel-memory-decision-stop-recovery)
      (when (and launched (process-live-p launched)) (delete-process launched))
      (delete-directory root t))))

(mevedel-deftest mevedel-memory-decision--start-recovery/original-key
  (:doc "a caller's original canonical key is checked independently of its current predicate")
  (let* ((root (file-name-as-directory (make-temp-file "recovery-original-key-" t)))
         (workspace (mevedel-workspace--create :root root))
         (key (mevedel-memory-store--claim-directory workspace))
         (other (concat key "-replaced")))
    (unwind-protect
        (cl-letf (((symbol-function 'mevedel-memory-store--claim-directory) (lambda (_) other)))
          (should-not (mevedel-memory-decision--start-recovery workspace #'ignore (current-buffer) #'always key))
          (should-not (file-exists-p other)))
      (delete-directory root t))))

