                           "mevedel-engine-test-support"))

(defmacro mevedel-failed-retry-test--drain ()
  "Drain the provider and the deferred root terminal transaction."
  '(progn
     (mevedel-retry-test--drain-native)
     (let ((deadline (+ (float-time) 10)))
       (while (and (< (float-time) deadline)
                   (buffer-local-value 'mevedel--current-request data-buf))
         (accept-process-output nil 0.01)
         (when-let* ((entry (pop scheduled)))
           (cancel-timer (car entry))
           (apply (nth 1 entry) (nth 2 entry))))
       (should (< (float-time) deadline)))))

(defmacro mevedel-failed-retry-test--with-root (responses &rest body)
  "Run BODY with HTTP RESPONSES and production root settlement."
  (declare (indent 1) (debug t))
  `(mevedel-retry-test--with-http ,responses
     (let* ((directory (make-temp-file "mevedel-failed-retry-" t))
            (session (test-mevedel-session-persistence--leased-session
                      directory :turn-count 0 :current-segment 1))
            (mevedel-gptel-retry-max-retries 0))
       (unwind-protect
           (progn
             (setf (mevedel-session-root-buffer session) data-buf
                   (mevedel-request-session request) session
                   (mevedel-request-turn request) 1
                   (mevedel-request-file-snapshots request) (make-hash-table :test #'equal)
                   (mevedel-request-started-at request) (current-time))
             (with-current-buffer data-buf
               (org-mode)
               (gptel-mode 1)
               (setq-local mevedel--session session)
               (setq-local mevedel--current-request request)
               (setq-local gptel-backend backend)
               (setq-local gptel-model 'test-model)
               (mevedel--insert-user-turn "Original prompt"))
             (plist-put (gptel-fsm-info fsm) :position
                        (with-current-buffer data-buf (copy-marker (point-max))))
             (plist-put (gptel-fsm-info fsm) :mevedel-request request)
             (plist-put (gptel-fsm-info fsm) :mevedel-request-id (mevedel-request-id request))
             (setf (alist-get 'ERRS (gptel-fsm-handlers fsm))
                   (list (lambda (machine) (mevedel--fail-turn machine 'error)))
                   (alist-get 'DONE (gptel-fsm-handlers fsm))
                   (list #'mevedel--complete-turn))
             ,@body)
         (when (buffer-live-p data-buf)
           (with-current-buffer data-buf
             (mevedel-request-end)
             (set-buffer-modified-p nil)))
         (mevedel-session-persistence-lock-release directory session)
         (mevedel-workspace-clear-registry)
         (delete-directory directory t)))))

(ert-deftest mevedel-gptel-retry-failed-turn/replays-payload-and-keeps-disclosure ()
  (mevedel-failed-retry-test--with-root
      (list mevedel-retry-test--failure mevedel-retry-test--success)
    (gptel--fsm-transition fsm)
    (mevedel-failed-retry-test--drain)
    (should-not (buffer-local-value 'mevedel--current-request data-buf))
    (let ((id (mevedel-gptel-retry-available-p data-buf)))
      (should (equal (mevedel-request-id request) id))
      (should-not (mevedel-gptel-retry-available-p data-buf "stale"))
      (should-error (mevedel-gptel-retry-failed-turn data-buf "stale") :type 'user-error)
      (should (stringp (mevedel-gptel-retry-failed-turn data-buf id)))
      (setq fsm (mevedel-request-fsm (buffer-local-value 'mevedel--current-request data-buf)))
      (should-not (mevedel-gptel-retry-available-p data-buf id))
      (should-error (mevedel-gptel-retry-failed-turn data-buf id) :type 'user-error)
      (mevedel-failed-retry-test--drain)
      (should (= 2 (length requests)))
      (should (equal (car requests) (cadr requests)))
      (should (= 1 waits))
      (should (= 1 (mevedel-session-turn-count session)))
      (let* ((prompts (cdr (assoc 1 (mevedel-session-prompt-index session))))
             (points (mevedel-session-artifacts-fork-point-spans data-buf)))
        (ert-info ((format "Transcript: %S Index: %S" (with-current-buffer data-buf (buffer-string))
                           (mevedel-session-prompt-index session)))
          (should (= 1 (length prompts))))
        (should (= 1 (plist-get (car prompts) :cum-turn)))
        (should (= 1 (length points)))
        (should (= 1 (plist-get (car points) :cum-turn))))
      (should-not (buffer-local-value 'mevedel--current-request data-buf))
      (with-current-buffer data-buf
        (should (string-search "Recovered answer" (buffer-string)))
        (should-not (string-search "Abandoned output" (buffer-string)))
        (should (string-search "Model at capacity" (buffer-string)))
        (should (string-search "server_error" (buffer-string)))
        (mevedel--insert-local-user-turn "Next ordinary prompt")
        (let ((next (mevedel-request-begin session)))
          (setq fsm (gptel-make-fsm
                     :info (list :buffer data-buf :backend backend :model 'test-model :stream t
                                 :position (copy-marker (point-max))
                                 :data '(:model "test-model" :input [] :stream t)
                                 :mevedel-request next :mevedel-request-id (mevedel-request-id next)
                                 :callback #'gptel-curl--stream-insert-response)
                     :handlers `((WAIT ,(lambda (machine) (mevedel-gptel-retry-dispatch machine)))
                                 (DONE mevedel--complete-turn)
                                 (ERRS ,(lambda (machine) (mevedel--fail-turn machine 'error))))))
          (setf (mevedel-request-fsm next) fsm)
          (gptel--fsm-transition fsm)
          (mevedel-failed-retry-test--drain)))
      (should (= 2 (mevedel-session-turn-count session)))
      (should (equal '(1 2) (mapcar (lambda (prompt) (plist-get prompt :cum-turn))
                                   (cdr (assoc 1 (mevedel-session-prompt-index session))))))
      (should (equal '(1 2) (mapcar (lambda (point) (plist-get point :cum-turn))
                                   (mevedel-session-artifacts-fork-point-spans data-buf)))))))

(ert-deftest mevedel-gptel-retry-failed-turn/completed-tools-run-once ()
  (let ((tool-runs 0)
        (response (concat "event: response.output_item.done\n"
                          "data: {\"item\":{\"type\":\"function_call\",\"call_id\":\"side-effect\",\"name\":\"Once\",\"arguments\":\"{}\"}}\n\n"
                          "event: response.completed\n"
                          "data: {\"response\":{\"status\":\"completed\"}}\n\n")))
    (mevedel-failed-retry-test--with-root
        (list response mevedel-retry-test--failure mevedel-retry-test--success)
      (let ((path (file-name-concat directory "effect.txt")))
      (write-region "before" nil path nil 'silent)
      (plist-put (gptel-fsm-info fsm) :tools
                 (list (gptel-make-tool :name "Once" :description "Count effects"
                                        :function (lambda ()
                                                    (cl-incf tool-runs)
                                                    (puthash path "before" (mevedel-request-file-snapshots
                                                                           mevedel--current-request))
                                                    (write-region "after" nil path nil 'silent)
                                                    "Done"))))
      (gptel--fsm-transition fsm)
      (mevedel-failed-retry-test--drain)
      (should (= 1 tool-runs))
      (mevedel-gptel-retry-failed-turn data-buf (mevedel-gptel-retry-available-p data-buf))
      (setq fsm (mevedel-request-fsm (buffer-local-value 'mevedel--current-request data-buf)))
      (mevedel-failed-retry-test--drain)
      (should (= 1 tool-runs))
      (should (= 3 (length requests)))
      (should (equal (car requests) (cadr requests)))
      (should (string-search "function_call_output" (car requests)))
      (should (assoc 1 (mevedel-session-file-snapshots session)))
      (with-current-buffer data-buf
        (let ((target (copy-tree (cdar (mevedel-session-rewind--prompt-candidates session)))))
          (cl-letf (((symbol-function 'display-buffer) #'ignore)
                    ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                    ((symbol-function 'mevedel--run-session-start-hooks) #'ignore))
            (should (mevedel-session-rewind-rewind data-buf target 'before))))
        (should (= 0 (mevedel-session-turn-count session))))
      (should (equal "before" (mevedel-session-artifacts--file-text path)))
      (when-let* ((impact (get-buffer "*mevedel-rewind-impact*"))) (kill-buffer impact))))))

(ert-deftest mevedel-gptel-retry-failed-turn/preserves-unbounded-provider-error ()
  (let* ((message (concat "Model at capacity " (make-string 1500 ?x) " original-message-tail"))
         (failure (string-replace
                   "\"message\":\"Model at capacity\""
                   (format "\"message\":\"%s\",\"detail\":{\"marker\":\"original-payload-tail\"}" message)
                   mevedel-retry-test--failure)))
    (mevedel-failed-retry-test--with-root (list failure mevedel-retry-test--success)
      (gptel--fsm-transition fsm)
      (mevedel-failed-retry-test--drain)
      (mevedel-gptel-retry-failed-turn data-buf (mevedel-gptel-retry-available-p data-buf))
      (setq fsm (mevedel-request-fsm (buffer-local-value 'mevedel--current-request data-buf)))
      (mevedel-failed-retry-test--drain)
      (with-current-buffer data-buf
        (should (string-search message (buffer-string)))
        (should (string-search "original-payload-tail" (buffer-string)))
        (should-not (string-search "Abandoned output" (buffer-string)))))))

(ert-deftest mevedel-gptel-retry-failed-turn/edits-retire-replay ()
  (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
    (gptel--fsm-transition fsm)
    (mevedel-failed-retry-test--drain)
    (let ((id (mevedel-gptel-retry-available-p data-buf)))
      (should id)
      (with-current-buffer data-buf
        (goto-char (point-max))
        (insert "Changed prompt"))
      (should-not (mevedel-gptel-retry-available-p data-buf id))
      (should-error (mevedel-gptel-retry-failed-turn data-buf id) :type 'user-error))))

(ert-deftest mevedel-gptel-retry-failed-turn/header-uses-exact-identity ()
  (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
    (gptel--fsm-transition fsm)
    (mevedel-failed-retry-test--drain)
    (let* ((id (mevedel-gptel-retry-available-p data-buf))
           (rendering (list :vtype 'request-failure :header "Provider failed"
                            :failure-buffer data-buf :failure-id id))
           (header (mevedel-view--rendering-header-line rendering))
           (position (string-search "[Retry]" header)))
      (should position)
      (should (functionp (get-text-property position 'mevedel-view-zone-activate header)))
      (plist-put rendering :failure-id "stale")
      (should-not (string-search "[Retry]" (mevedel-view--rendering-header-line rendering))))))

(ert-deftest mevedel-gptel-retry-failed-turn/refuses-changed-turn-or-queued-input ()
  (dolist (change '(committed queued rewritten))
    (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
      (gptel--fsm-transition fsm)
      (mevedel-failed-retry-test--drain)
      (let ((id (mevedel-gptel-retry-available-p data-buf)))
        (should id)
        (pcase change
          ('committed (cl-incf (mevedel-session-turn-count session)))
          ('queued (setf (mevedel-session-pending-follow-ups session) '((:input "New prompt"))))
          ('rewritten (with-current-buffer data-buf
                        (let ((inhibit-modification-hooks t))
                          (goto-char (point-max)) (insert "Rewritten history")))))
        (should-not (mevedel-gptel-retry-available-p data-buf id))
        (should-error (mevedel-gptel-retry-failed-turn data-buf id) :type 'user-error)))))

(ert-deftest mevedel-gptel-retry-failed-turn/refuses-pending-input-without-consuming-it ()
  (dolist (category '(steering follow-up))
    (dolist (state '(pending failed-turn))
      (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
        (let ((entry (list :input "Queued input" :state state)))
          (mevedel-session-set-pending-inputs session category (list entry))
          (gptel--fsm-transition fsm)
          (mevedel-failed-retry-test--drain)
          (should-not (mevedel-gptel-retry-available-p data-buf))
          (should (string-search
                   "Resolve queued input first"
                   (error-message-string
                    (should-error (mevedel-gptel-retry-failed-turn data-buf (mevedel-request-id request))
                                  :type 'user-error))))
          (should (eq entry (car (mevedel-session-pending-inputs session category))))
          (should-not (plist-get entry :request-id))
          (mevedel-session-set-pending-inputs session category nil)
          (should (mevedel-gptel-retry-available-p data-buf)))))))

(ert-deftest mevedel-gptel-retry-failed-turn/refuses-input-queued-during-admission ()
  (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
    (gptel--fsm-transition fsm)
    (mevedel-failed-retry-test--drain)
    (let ((id (mevedel-gptel-retry-available-p data-buf))
          (ready (symbol-function 'mevedel-request-assert-target-ready))
          (entry (list :input "Arrived during readiness" :state 'pending)))
      (cl-letf (((symbol-function 'mevedel-request-assert-target-ready)
                 (lambda (owner)
                   (funcall ready owner)
                   (mevedel-session-set-pending-inputs owner 'steering (list entry)))))
        (should-error (mevedel-gptel-retry-failed-turn data-buf id) :type 'user-error))
      (should-not (buffer-local-value 'mevedel--current-request data-buf))
      (should (eq entry (car (mevedel-session-pending-steering session))))
      (should-not (plist-get entry :request-id)))))

(ert-deftest mevedel-gptel-retry-failed-turn/refreshes-settled-failure-header ()
  (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
    (let ((view (generate-new-buffer " *retry-header*")) refreshed)
      (unwind-protect
          (progn
            (with-current-buffer data-buf (setq-local mevedel--view-buffer view))
            (cl-letf (((symbol-function 'mevedel-view-render-refresh-latest-turn)
                       (lambda (buffer)
                         (when-let* ((id (mevedel-gptel-retry-available-p buffer)))
                           (push (mevedel-view--rendering-header-line
                                  (list :vtype 'request-failure :header "Failed"
                                        :failure-buffer buffer :failure-id id)) refreshed)))))
              (gptel--fsm-transition fsm)
              (mevedel-failed-retry-test--drain))
            (should (seq-some (lambda (header) (string-search "[Retry]" header)) refreshed)))
        (with-current-buffer data-buf (setq-local mevedel--view-buffer nil))
        (kill-buffer view)))))

(ert-deftest mevedel-gptel-retry-failed-turn/queue-changes-refresh-header-only-when-idle ()
  (dolist (category '(steering follow-up))
    (mevedel-failed-retry-test--with-root (list mevedel-retry-test--failure)
      (let ((view (generate-new-buffer " *retry-queue-header*")) headers)
        (unwind-protect
            (progn
              (with-current-buffer data-buf (setq-local mevedel--view-buffer view))
              (cl-letf (((symbol-function 'mevedel-view-render-refresh-latest-turn)
                         (lambda (buffer)
                           (push (mevedel-view--rendering-header-line
                                  (list :vtype 'request-failure :header "Failed"
                                        :failure-buffer buffer :failure-id (mevedel-request-id request)))
                                 headers))))
                (gptel--fsm-transition fsm)
                (mevedel-failed-retry-test--drain)
                (should (string-search "[Retry]" (car headers)))
                (mevedel-pending-inputs--set-queues session category (list (list :input "Queued")))
                (should-not (string-search "[Retry]" (car headers)))
                (setq headers nil)
                (mevedel-pending-inputs--set-queues session category (list (list :input "Changed queued input")))
                (should-not headers)
                (mevedel-pending-inputs--set-queues session category nil)
                (should (string-search "[Retry]" (car headers)))
                (setq headers nil)
                (with-current-buffer data-buf (setq mevedel--current-request request))
                (mevedel-pending-inputs--set-queues session category (list (list :input "While streaming")))
                (should-not headers)
                (with-current-buffer data-buf (setq mevedel--current-request nil))
                (cl-incf (mevedel-session-turn-count session))
                (mevedel-pending-inputs--set-queues session category nil)
                (should-not headers)))
          (with-current-buffer data-buf (setq-local mevedel--view-buffer nil))
          (kill-buffer view))))))

(ert-deftest mevedel-gptel-retry-failed-turn/admission-publishes-same-turn ()
  (mevedel-failed-retry-test--with-root
      (list mevedel-retry-test--failure mevedel-retry-test--success)
    (gptel--fsm-transition fsm)
    (mevedel-failed-retry-test--drain)
    (let ((start (symbol-function 'mevedel-session-persistence-start-checkpoints)) published-turn)
      (let ((id (mevedel-gptel-retry-available-p data-buf)) failed-admission)
        (cl-letf (((symbol-function 'mevedel-session-persistence-start-checkpoints)
                   (lambda ()
                     (setq failed-admission mevedel--current-request)
                     (error "Injected checkpoint startup failure"))))
          (should-error (mevedel-gptel-retry-failed-turn data-buf id)))
        (should (mevedel-request-cancelled-p failed-admission))
        (should-not (buffer-local-value 'mevedel--current-request data-buf))
        (should (equal id (mevedel-gptel-retry-available-p data-buf))))
      (cl-letf (((symbol-function 'mevedel-session-persistence-start-checkpoints)
                 (lambda ()
                   (setq published-turn (mevedel-request-turn mevedel--current-request))
                   (funcall start))))
        (mevedel-gptel-retry-failed-turn data-buf (mevedel-gptel-retry-available-p data-buf)))
      (should (= 1 published-turn)))
    (setq fsm (mevedel-request-fsm (buffer-local-value 'mevedel--current-request data-buf)))
    (mevedel-failed-retry-test--drain)))

(ert-deftest mevedel-gptel-retry-failed-turn/commit-fence-refuses-moved-count ()
  (with-temp-buffer
    (let* ((session (mevedel-session--create :turn-count 2))
           (request (mevedel-request--create :turn 1))
           (fsm (gptel-make-fsm :info (list :buffer (current-buffer) :mevedel-retry-of "failed"))))
      (setq-local mevedel--session session mevedel--current-request request)
      (should-error (mevedel--turn-commit fsm))
      (should (= 2 (mevedel-session-turn-count session))))))

(mevedel-deftest mevedel-gptel-retry-failed-turn/claude-resends-original-input (:quiet t)
  (mevedel-engine-test--with-claude-session
    (let* ((image (file-name-concat root "retry.png"))
           (bytes "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aS1sAAAAASUVORK5CYII=")
           (prompt (format "Inspect the original image @file:{%s}" image))
           (submit (symbol-function 'mevedel-acp-prompt))
           (launches 0) identities submissions)
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (insert (base64-decode-string bytes))
        (let ((coding-system-for-write 'no-conversion))
          (write-region (point-min) (point-max) image nil 'silent)))
      (setq-local gptel-system-prompt "Retry fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'mevedel-acp-prompt)
                 (lambda (&rest args)
                   (push (copy-tree (cadr args) t) submissions)
                   (apply submit args)))
                ((symbol-function 'mevedel-claude-code-launch)
                 (mevedel-engine-test--claude-launch
                  (lambda (_system _mcp _model _effort &optional id _hook)
                    (push id identities)
                    (cl-incf launches)
                    (list :meta `((responseText . ,(if (= launches 1) "Failed partial output" "Retried answer"))
                                  (promptResponse . ((stopReason . ,(if (= launches 1) "max_tokens" "end_turn"))))))))))
        (mevedel--insert-local-user-turn prompt)
        (mevedel--send-request (concat "Internal skill instructions\n" prompt))
        (mevedel-test--await 5 "Initial Claude failure did not settle"
          (not (mevedel-turn-busy-p buffer)))
        (should (= 1 (mevedel-session-turn-count session)))
        (let ((id (mevedel-gptel-retry-available-p buffer)))
          (should id)
          (delete-file image)
          (mevedel-gptel-retry-failed-turn buffer id)
          (should-not (mevedel-gptel-retry-available-p buffer id)))
        (mevedel-test--await 5 "Retried Claude turn did not settle"
          (not (mevedel-turn-busy-p buffer)))
        (should (equal '("fixture-session" nil) identities))
        (should (= 2 (mevedel-session-turn-count session)))
        (should (= 2 (length (cdr (assoc 1 (mevedel-session-prompt-index session))))))
        (should (string-search "Failed partial output" (buffer-string)))
        (should (string-search "Retried answer" (buffer-string)))
        (should-not (string-search "Internal skill instructions" (buffer-string)))
        (should (string-search ":outcome error" (buffer-string)))
        (should (= 2 (length submissions)))
        (dolist (input submissions)
          (let ((images (seq-filter (lambda (part) (equal "image" (alist-get 'type part))) input)))
            (should (= 1 (length images)))
            (should (equal bytes (alist-get 'data (car images)))))
          (should (seq-some (lambda (part)
                              (string-search "Inspect the original image" (or (alist-get 'text part) "")))
                            input)))))))

