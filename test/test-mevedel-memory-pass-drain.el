;;; test-mevedel-memory-pass-drain.el -- Bounded backlog reviews -*- lexical-binding: t -*-

;;; Commentary:

;; Exercise the real pass, provider parser, publication and note decisions.
;; Only provider transport is dry-run; all evidence and ownership use real files.

;;; Code:

(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "helpers"))
(require 'mevedel-journal-claim)
(require 'mevedel-journal-cleanup)
(require 'mevedel-journal-worker)
(require 'mevedel-memory-pass)
(require 'mevedel-memory-decision)
(require 'mevedel-memory-list)
(require 'mevedel-memory-notes)
(require 'mevedel-memory-store)
(require 'mevedel-models)
(require 'mevedel-resource)
(require 'mevedel-session-control-fs)
(require 'mevedel-skills-ui)
(require 'mevedel-telemetry)
(require 'mevedel-transport)
(require 'mevedel-workspace-identity)
(require 'memory-history-fixtures
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "memory-history-fixtures"))
(require 'gptel-openai)

(mevedel-deftest mevedel-memory-pass-drain
    (:vars* ((root (file-name-as-directory (make-temp-file "memory-drain-" t)))
             (workspace (mevedel-workspace--create :root root))
             (identity (mevedel-workspace-identity-ensure root))
             (shared (file-name-concat root ".mevedel" "shared"))
             (mevedel-memory-dirs nil)
             (mevedel-memory-consolidation-mode 'propose)
             (mevedel-memory-pass--inhibit-scheduling nil)
             (mevedel-journal-worker--child-p t)
             (gptel--known-backends nil)
             (model (make-symbol "drain-model"))
             (backend (gptel-make-openai "drain-test" :key "test-only" :models (list model)))
             (real-request (symbol-function 'gptel-request))
             (real-cleanup-active (symbol-function 'mevedel-journal-cleanup-active-p))
             (now (floor (float-time)))
             (calls 0) (busy nil) (busy-checks 0) pending latest drain results batches retry-origin)
     :quiet t
     :before-each ((put model :context-window 128) (put model :capabilities '(tool-use))
                   (make-directory shared t))
     :after-each ((mevedel-memory-pass-stop-all)
                  (when (buffer-live-p retry-origin) (kill-buffer retry-origin))
                  (delete-directory root t)))
  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest args) (ert-fail args)))
            ((symbol-function 'y-or-n-p) (lambda (&rest args) (ert-fail args)))
            ((symbol-function 'read-from-minibuffer) (lambda (&rest args) (ert-fail args)))
            ((symbol-function 'mevedel-model-resolve-workload)
             (lambda (&rest _) (list :backend backend :model model)))
            ((symbol-function 'mevedel-session-control-fs-target-time) (lambda (_) now))
            ((symbol-function 'mevedel-session-control-fs-observation-time) (lambda (_) now))
            ((symbol-function 'mevedel-journal-cleanup-active-p)
             (lambda (ws)
               (when busy (cl-incf busy-checks))
               (or busy (funcall real-cleanup-active ws))))
            ((symbol-function 'gptel-request)
             (lambda (prompt &rest args)
               (let ((fsm (apply real-request prompt (plist-put (copy-sequence args) :dry-run t))))
                 (unless (plist-get args :dry-run)
                   (cl-incf calls)
                   (should-not pending)
                   (setq latest (mevedel-memory-pass-running workspace))
                   (setq pending (cons fsm (plist-get args :callback))))
                 fsm))))
    (cl-labels
        ((notes (count &optional size)
           (dotimes (n count)
             (let ((path (file-name-concat shared (format "note-%03d.md" n))))
               (write-region (make-string (or size 50) ?x) nil path nil 'silent)
               (set-file-times path (seconds-to-time (- now (* 15 86400)))))))
         (digest (n)
           (mevedel-journal-store-publish-digest
            root (list :capture-id (format "%064x" n) :session "closed" :session-name "Closed"
                       :workspace identity :trigger 'session-end :segment 1
                       :source-revision (make-string 64 ?c) :turns '(1)
                       :turn-ids (list (format "%064x" n))
                       :created (format-time-string "%FT%TZ" (- now 3600) t) :model "test:model")
            "## Done\n- Observed: Passed.\n## Learned\n- none\n## Surprised\n- none\n## Unfinished\n- none"))
         (wait-for (predicate)
           (with-timeout (15 (ert-fail "Backlog review did not advance"))
             (while (not (funcall predicate)) (accept-process-output nil .01))))
         (start ()
           (setq drain (mevedel-memory-pass-drain workspace (lambda (result) (push result results)))))
         (deliver (timer)
           (should (timerp timer))
           (cancel-timer timer)
           (apply (timer--function timer) (timer--args timer)))
         (defer ()
           ;; An open session uses the note while it is applied, then closes.
           (setq retry-origin (generate-new-buffer " *drain-retry-origin*"))
           (with-current-buffer retry-origin
             (setq-local mevedel-memory-consolidation-mode 'auto)
             (let* ((accepted (car (mevedel-test-memory-history-create workspace 1 1 100 t)))
                    (proposal (car (plist-get accepted :proposals)))
                    (state (list :workspace workspace :origin-buffer retry-origin))
                    (reader (generate-new-buffer " *drain-reader*")))
               (unwind-protect
                   (progn
                     (with-current-buffer reader
                       (setq-local mevedel--session (mevedel-session--create :workspace workspace))
                       (mevedel-resource-prepare
                        'read (mevedel-memory-notes-address (plist-get proposal :file))
                        (list :session mevedel--session)))
                     (should (= 1 (plist-get (mevedel-memory-pass--apply state accepted) :held-count))))
                 (kill-buffer reader))
               (list :state state :proposal proposal
                     :path (plist-get (cdr (car (plist-get proposal :before))) :path)))))
         (summary ()
           (wait-for (lambda () pending))
           (let ((request (car pending)) (callback (cdr pending)))
             (setq pending nil)
             (funcall callback (concat "## Scope\n- Shared note.\n## Constraints & Preferences\n- (none)\n"
                                     "## Work & Evidence\n- Compact findings.\n## Key Decisions\n- (none)\n"
                                     "## Open Questions & Risks\n- Open handoff.\n## Critical Context\n- (none)\n"
                                     "## Relevant Files\n- (none)\n## Skills Invoked\n- (none)\n## Next Steps\n- (none)") (gptel-fsm-info request))
             (gptel--fsm-transition request 'DONE)))
         (finish (&optional invalid)
           (wait-for (lambda () pending))
           (let* ((state (or (mevedel-memory-pass-running workspace) latest))
                  (scope (plist-get (plist-get state :prepared) :scope))
                  (documents (mevedel-memory-notes-documents scope))
                  (reply (concat "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n## Remove\n- none\n## Instructions\n- none\n"
                                 "## No action\n- No durable changes."))
                  (request (car pending)) (callback (cdr pending)))
             (push (length documents) batches)
             (should (<= (length documents) 16))
             (should (<= (apply #'+ (mapcar (lambda (doc) (string-bytes (plist-get doc :body))) documents))
                         (* 96 1024)))
             (setq pending nil)
             (funcall callback (if invalid "Invalid review" reply) (gptel-fsm-info request))
             (gptel--fsm-transition request 'DONE)
             (wait-for (lambda () (and (plist-get state :settled) (plist-get state :result))))))
         (offer ()
           (mevedel-memory-pass-schedule workspace)
           (wait-for (lambda () (= 0 (hash-table-count mevedel-memory-pass--pending)))))
         (reviews ()
           (seq-filter (lambda (entry) (eq (plist-get entry :kind) 'consolidation))
                       (mevedel-journal-store-entries root)))
         (accepted ()
           (mevedel-memory-store-accepted workspace (plist-get (plist-get latest :claim) :owner))))
      ,test))
  (test)
  :doc "explicit drain publishes successive bounded batches then stops without an empty model request"
  (progn
    (notes 35)
    (start)
    (dotimes (_ 3) (finish))
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (equal '(3 16 16) batches))
    (should (= 3 calls))
    (should (= 3 (length (reviews))))
    (should (eq 'empty (plist-get (car results) :outcome)))
    (should (= 3 (plist-get (car results) :batch)))
    (should-not (mevedel-memory-pass-running workspace)))
  :doc "a chunked note owns its batch and leaves digest evidence for the next batch"
  (progn
    (notes 1 (* 40 1024))
    (dotimes (n 5) (digest (1+ n)))
    (start)
    (wait-for (lambda () pending))
    (should-not (plist-get (plist-get latest :prepared) :entries))
    (should-not (plist-get (plist-get latest :selection) :entries))
    (should (= 5 (plist-get (plist-get latest :selection) :remaining)))
    (summary)
    (summary)
    (finish)
    (should (= 5 (plist-get (car results) :remaining)))
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 4 calls))
    (should (= 2 (length (reviews))))
    (should (= 0 (plist-get (mevedel-memory-pass-select (mevedel-journal-store-entries root)) :eligible)))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "byte-bounded batches and a real preparation/publication child retain the same drain contract"
  (let ((mevedel-journal-worker--child-p nil))
    (notes 17 7000)
    (start)
    (finish)
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 2 calls))
    (should (= 17 (apply #'+ batches)))
    (should (= 2 (length (reviews))))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "drain completion does not expand its frozen cohort to later arrivals"
  (progn
    (notes 1)
    (start)
    (finish)
    (should (= 0 (plist-get (car results) :notes-remaining)))
    (notes 2)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 1 calls))
    (should (= 2 (length (directory-files shared nil "\\.md\\'"))))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "active cleanup refuses admission before inference or acquiring a pass claim"
  (let ((mevedel-journal-cleanup--pending (make-hash-table :test #'equal))
        (mevedel-journal-cleanup--active (make-hash-table :test #'equal))
        (acquisitions 0)
        (acquire (symbol-function 'mevedel-journal-claim-acquire)))
    (notes 1)
    (let ((cleanup (cons nil t)))
      (puthash root cleanup mevedel-journal-cleanup--pending)
      (puthash root cleanup mevedel-journal-cleanup--active))
    (cl-letf (((symbol-function 'mevedel-journal-claim-acquire)
               (lambda (&rest args)
                 (cl-incf acquisitions)
                 (apply acquire args))))
      (should-not (mevedel-memory-pass-start workspace #'ignore :automatic t))
      (should-error (mevedel-memory-pass-start workspace #'ignore) :type 'user-error)
      (should (= 0 acquisitions))
      (should (= 0 calls))
      (should-not (mevedel-memory-pass-running workspace))))
  :doc "drain waits for active cleanup but queued idle cleanup cannot starve admission"
  (let* ((mevedel-journal-cleanup--pending (make-hash-table :test #'equal))
         (mevedel-journal-cleanup--active (make-hash-table :test #'equal))
         (cleanup (cons nil t))
         (idle (run-with-idle-timer 3600 nil #'ignore)))
    (unwind-protect
        (progn
          (notes 1)
          (puthash root cleanup mevedel-journal-cleanup--pending)
          (puthash root cleanup mevedel-journal-cleanup--active)
          (start)
          (wait-for (lambda () (memq (plist-get drain :status) '(waiting running))))
          (should (eq 'waiting (plist-get drain :status)))
          (should (= 0 calls))
          (should-not (mevedel-memory-pass-running workspace))
          ;; The current cleanup finishes, leaving only a queued idle successor.
          (remhash root mevedel-journal-cleanup--active)
          (setcar cleanup idle)
          (let ((timer (plist-get drain :timer)))
            (cancel-timer timer)
            (apply (timer--function timer) (timer--args timer)))
          (finish)
          (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
          (should (= 1 calls))
          (should (eq 'empty (plist-get (car results) :outcome))))
      (cancel-timer idle)))
  :doc "running cleanup waits without inference, and cancellation fences the queued retry"
  (progn
    (notes 20)
    (setq busy t)
    (start)
    (wait-for (lambda () (eq (plist-get drain :status) 'waiting)))
    (should (= 0 calls))
    (let* ((timer (plist-get drain :timer)) (fn (timer--function timer)) (args (timer--args timer)))
      (should (mevedel-memory-pass-drain-status workspace))
      (should (mevedel-memory-pass-cancel workspace))
      (setq busy nil)
      (apply fn args)
      (should (= 0 calls))
      (should-not (mevedel-memory-pass-drain-status workspace))
      (should (eq 'aborted (plist-get (car results) :outcome)))))
  :doc "waiting resumes when cleanup ends without changing the batch limits"
  (progn
    (notes 1)
    (setq busy t)
    (start)
    (wait-for (lambda () (eq (plist-get drain :status) 'waiting)))
    (let ((timer (plist-get drain :timer)))
      (cancel-timer timer)
      (setq busy nil)
      (apply (timer--function timer) (timer--args timer)))
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 1 calls))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "a registered drain keeps its waiting gap ahead of an older deferred application timer"
  (let* ((held (defer))
         (retry (gethash workspace mevedel-memory-pass--deferred)))
    (notes 1)
    (setq busy t)
    (with-current-buffer retry-origin (start))
    (deliver (plist-get drain :timer))
    (should (eq 'waiting (plist-get drain :status)))
    (setq busy nil)
    (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer)))
    (let ((premature (mevedel-memory-pass-running workspace)))
      (deliver (plist-get drain :timer))
      ;; On the original source the retry registers --running in the gap;
      ;; this real drain delivery reports "Memory consolidation is already running".
      (should-not (plist-get (car results) :error))
      (should-not premature))
    (should (eq retry (gethash workspace mevedel-memory-pass--deferred)))
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 1 calls))
    (should (= 1 (plist-get (car results) :batch)))
    (should (eq 'empty (plist-get (car results) :outcome)))
    (should-not (file-exists-p (plist-get held :path)))
    (should (eq 'applied (plist-get (mevedel-memory-decision-status
                                   workspace (plist-get (plist-get held :proposal) :id)) :status)))
    (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer)))
    (wait-for (lambda () (not (mevedel-memory-pass-running workspace))))
    (should-not (gethash workspace mevedel-memory-pass--deferred)))
  :doc "an already admitted native retry finishes before a new explicit drain can start"
  (let* ((held (defer))
         (retry (gethash workspace mevedel-memory-pass--deferred))
         (mevedel-journal-worker--child-p nil))
    (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer)))
    (should (mevedel-memory-pass-running workspace))
    (should-error (mevedel-memory-pass-drain workspace #'ignore) :type 'user-error)
    (should-not (mevedel-memory-pass-drain-status workspace))
    (wait-for (lambda () (not (mevedel-memory-pass-running workspace))))
    (should-not (file-exists-p (plist-get held :path)))
    (should (eq 'applied (plist-get (mevedel-memory-decision-status
                                   workspace (plist-get (plist-get held :proposal) :id)) :status)))
    (notes 1)
    (start)
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 1 calls))
    (should (= 1 (plist-get (car results) :batch)))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "a drain registered during the retry's fresh identity read wins admission"
  (let* ((held (defer))
         (retry (gethash workspace mevedel-memory-pass--deferred))
         (read (symbol-function 'mevedel-workspace-identity-read))
         injected)
    (notes 1)
    (cl-letf (((symbol-function 'mevedel-workspace-identity-read)
               (lambda (path)
                 (prog1 (funcall read path)
                   (unless injected
                     (setq injected t)
                     (with-current-buffer retry-origin (start)))))))
      (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer))))
    (should injected)
    (should (eq retry (gethash workspace mevedel-memory-pass--deferred)))
    (should-not (mevedel-memory-pass-running workspace))
    (should (file-exists-p (plist-get held :path)))
    (finish)
    (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
    (should (= 1 calls))
    (should-not (file-exists-p (plist-get held :path))))
  :doc "cancelled retry cannot retire or admit its successor after identity IO returns or fails"
  (dolist (fail '(nil t))
    (let* ((held (defer))
           (retry (gethash workspace mevedel-memory-pass--deferred))
           (read (symbol-function 'mevedel-workspace-identity-read))
           (reads 0) successor injected diagnostics)
      (cl-letf (((symbol-function 'mevedel-workspace-identity-read)
                 (lambda (path)
                   (cl-incf reads)
                   (prog1 (funcall read path)
                     (unless injected
                       (setq injected t)
                       (should (mevedel-memory-pass-cancel workspace))
                       (mevedel-memory-pass--defer-notes (plist-get held :state))
                       (setq successor (gethash workspace mevedel-memory-pass--deferred))
                       (when fail (error "Injected retry identity IO failure")))))))
        (mevedel-test--with-captured-diagnostics diagnostics
          (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer))))
        (should injected)
        (should-not (eq retry successor))
        (should (eq successor (gethash workspace mevedel-memory-pass--deferred)))
        (should-not (mevedel-memory-pass-running workspace))
        (should (file-exists-p (plist-get held :path)))
        (should-not (mevedel-memory-decision-status workspace (plist-get (plist-get held :proposal) :id)))
        (if fail
            (should (string-match-p "Injected retry identity IO failure" diagnostics))
          (should (string-empty-p diagnostics)))
        (let ((before reads))
          (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer)))
          (should (= before reads))))
      (apply (timer--function (plist-get successor :timer)) (timer--args (plist-get successor :timer)))
      (wait-for (lambda () (not (mevedel-memory-pass-running workspace))))
      (should-not (file-exists-p (plist-get held :path)))
      (should-not (gethash workspace mevedel-memory-pass--deferred))
      (kill-buffer retry-origin)))
  :doc "retry does not overwrite a pass admitted during its transport observation"
  (let* ((held (defer))
         (retry (gethash workspace mevedel-memory-pass--deferred))
         (transport (symbol-function 'mevedel-transport-busy-p))
         admitted outcome injected)
    (notes 1)
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'mevedel-transport-busy-p)
                     (lambda (&rest args)
                       (prog1 (apply transport args)
                         (unless injected
                           (setq injected t)
                           (with-current-buffer retry-origin
                             (setq admitted (mevedel-memory-pass-start
                                             workspace (lambda (result) (setq outcome result))))))))))
            (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer))))
          (should injected)
          (should (eq admitted (mevedel-memory-pass-running workspace)))
          (should (eq retry (gethash workspace mevedel-memory-pass--deferred)))
          (finish)
          (should (eq 'success (plist-get outcome :outcome)))
          (should-not (plist-get outcome :error))
          (should (= 1 calls))
          (should (= 2 (length (reviews))))
          (should-not (file-exists-p (plist-get held :path)))
          (apply (timer--function (plist-get retry :timer)) (timer--args (plist-get retry :timer)))
          (wait-for (lambda () (not (mevedel-memory-pass-running workspace))))
          (should-not (gethash workspace mevedel-memory-pass--deferred)))
      (when (and admitted (not (plist-get admitted :settled)))
        (mevedel-memory-pass--finish admitted '(:outcome aborted)))))
  :doc "queued drain waits for a pass admitted during its transport observation"
  (let ((transport (symbol-function 'mevedel-transport-busy-p)) admitted outcome injected)
    (notes 1)
    (start)
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'mevedel-transport-busy-p)
                     (lambda (&rest args)
                       (prog1 (apply transport args)
                         (unless injected
                           (setq injected t)
                           ;; Impose another internal drain continuation's
                           ;; admission while this busy observation yields.
                           (setq admitted (mevedel-memory-pass-start
                                           workspace (lambda (result) (setq outcome result)) :drain drain)))))))
            (deliver (plist-get drain :timer)))
          (should injected)
          (should (eq admitted (mevedel-memory-pass-running workspace)))
          (should (eq 'waiting (plist-get drain :status)))
          (should-not results)
          (finish)
          (should (eq 'success (plist-get outcome :outcome)))
          (should-not (plist-get outcome :error))
          (deliver (plist-get drain :timer))
          (wait-for (lambda () (not (mevedel-memory-pass-drain-status workspace))))
          (should (= 1 calls))
          (should (= 1 (length (reviews))))
          (should (eq 'empty (plist-get (car results) :outcome))))
      (when (and admitted (not (plist-get admitted :settled)))
        (mevedel-memory-pass--finish admitted '(:outcome aborted)))))
  :doc "a genuine foreign claim remains visible as busy rather than becoming a local wait"
  (let ((claim (mevedel-journal-claim-acquire (mevedel-memory-store--claim-directory workspace) 180)))
    (unwind-protect
        (progn
          (start)
          (deliver (plist-get drain :timer))
          (should (eq 'error (plist-get drain :status)))
          (should (equal "Memory consolidation is busy" (plist-get (car results) :error)))
          (should (= 0 calls))
          (should (mevedel-journal-claim-owned-p claim)))
      (mevedel-journal-claim-settle claim 'cancelled "")))
  :doc "an admitted async decision operation completes while a new drain waits"
  (let (ready operation)
    (cl-letf (((symbol-function 'mevedel-journal-worker-supported-p) (lambda (_) t))
              ((symbol-function 'mevedel-journal-worker-start)
               (lambda (_workspace kind callback &optional _force payload owner)
                 (should (eq 'memory-recover kind))
                 (should (mevedel-journal-claim-owned-p (plist-get payload :claim)))
                 (should (eq owner (gethash (plist-get (plist-get payload :claim) :directory)
                                           mevedel-memory-decision--operations)))
                 (setq ready callback)
                 nil)))
      (setq operation (mevedel-memory-decision--start-operation workspace (lambda (&rest _) nil) #'ignore))
      (start)
      (deliver (plist-get drain :timer))
      (should (eq 'waiting (plist-get drain :status)))
      (should-not results)
      (funcall ready (list :ok t :synchronous t :operation-id (plist-get (plist-get operation :claim) :owner))))
    (should-not (mevedel-memory-decision-admitted-p (mevedel-memory-store--claim-directory workspace)))
    (deliver (plist-get drain :timer))
    (should (eq 'empty (plist-get (car results) :outcome))))
  :doc "cancelled drain cannot remove or report over its successor after busy IO returns or fails"
  (dolist (fail '(nil t))
    (let ((transport (symbol-function 'mevedel-transport-busy-p)) old successor injected)
      (start)
      (setq old drain)
      (cl-letf (((symbol-function 'mevedel-transport-busy-p)
                 (lambda (&rest args)
                   (prog1 (apply transport args)
                     (unless injected
                       (setq injected t)
                       (mevedel-memory-pass-cancel workspace)
                       (start)
                       (setq successor drain)
                       (when fail (error "Injected old drain observation failure")))))))
        (deliver (plist-get old :timer)))
      (should injected)
      (should (eq successor (mevedel-memory-pass-drain-status workspace)))
      (should (= 1 (length results)))
      (should (eq 'aborted (plist-get (car results) :outcome)))
      (deliver (plist-get successor :timer))
      (should (eq 'empty (plist-get (car results) :outcome)))
      (setq results nil)))
  :doc "drain does not adopt a changed workspace root after fresh key IO"
