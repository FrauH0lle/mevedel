;;; test-mevedel-claude-code-transfer.el --- Engine continuation -*- lexical-binding: t -*-

;;; Commentary:
;; Switch ordinary root sessions across engines and inspect actual request input.

;;; Code:

(require 'mevedel-engine-test-support
         (file-name-concat (file-name-directory (or load-file-name buffer-file-name))
                           "mevedel-engine-test-support"))
(require 'mevedel-claude-code-session)

(defconst mevedel-claude-code-transfer-test--peer
  (file-name-concat (file-name-directory (or load-file-name buffer-file-name))
                    "fixtures" "acp-agent.py"))

(mevedel-deftest mevedel--send-request/transfer-to-claude (:quiet t)
  (mevedel-engine-test--with-session
    (let ((gptel--known-backends nil)
          (mevedel-claude-code-directory (file-name-concat root "claude"))
          ids)
      (mevedel-claude-code-register)
      (mevedel--insert-user-turn "Earlier API task")
      (insert (propertize "\nAPI EVIDENCE RETAINED\n" 'gptel 'response))
      (setf (mevedel-session-turn-count session) 1
            (mevedel-session-prompt-index session) '((1 (:cum-turn 1))))
      (mevedel-request-end)
      (setq request (mevedel-request-begin session))
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (setq-local gptel-system-prompt "Transfer fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                 (lambda (_system mcp _model _effort &optional id _hook)
                   (push id ids)
                   (list :command (executable-find "python3")
                         :args (list mevedel-claude-code-transfer-test--peer)
                         :cwd root :mcp mcp :session-id id))))
        (mevedel--insert-user-turn "Continue using Claude")
        (mevedel--send-request "Continue using Claude")
        (with-timeout (5 (ert-fail "Excerpt continuation did not settle"))
          (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01)))
        (should (eq 'success (plist-get (mevedel-engine-info request) :mevedel-acp-outcome)))
        (should (string-search "answer:Excerpt continuation" (buffer-string)))
        (should (string-search "provenance: assistant ---\nAPI EVIDENCE RETAINED" (buffer-string)))
        (should (equal '(nil) ids))
        (goto-char (point-max))
        (mevedel--insert-user-turn "Second native turn")
        (mevedel--send-request "Second native turn")
        (with-timeout (5 (ert-fail "Native followup did not settle"))
          (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01)))
        (should (stringp (car ids)))
        (should (string-search "answer:Second native turn" (buffer-string)))))))

(mevedel-deftest mevedel--send-request/transfer-from-claude (:quiet t)
  (mevedel-engine-test--with-session
    (let* ((gptel--known-backends nil)
           (mevedel-claude-code-directory (file-name-concat root "claude"))
           (api (gptel-make-anthropic "Transfer API" :key "fixture" :models '(claude-sonnet-4-5)))
           (real-request (symbol-function 'gptel-request))
           (instructions (file-name-concat root "AGENTS.md"))
           (source (file-name-concat root "source.txt"))
           sent)
      (write-region "TRANSFER TOOL RESULT" nil source nil 'silent)
      (mevedel-claude-code-register)
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (setq-local gptel-system-prompt "Transfer fixture"
                  gptel-tools (list (mevedel-tool-gptel-tool (mevedel-tool-ensure "Read")))
                  gptel-prompt-transform-functions nil)
      (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                 (lambda (_system mcp _model _effort &optional id _hook)
                   (list :command (executable-find "python3")
                         :args (list mevedel-claude-code-transfer-test--peer)
                         :cwd root :mcp mcp :session-id id
                         :tool-id-field :claudecode/toolUseId
                         :meta `((toolBatches . [[((name . "Read") (id . "transfer-read")
                                                  (args . ((file_path . ,source))))]])
                                 (compactionEvents .
                                  [((sessionUpdate . "agent_message_chunk")
                                    (content . ((type . "text") (text . "ARCHIVE ONLY\n"))))
                                   ((sessionUpdate . "compaction_update") (compactionId . "switch")
                                    (status . "completed")
                                    (summary . [((type . "text") (text . "EFFECTIVE SUMMARY"))]))
                                   ((sessionUpdate . "agent_thought_chunk")
                                    (content . ((type . "text") (text . "UNSIGNED THOUGHT"))))]))))))
        (mevedel--insert-user-turn "Native task")
        (mevedel--send-request "Native task")
        (with-timeout (5 (ert-fail "Native source turn did not settle"))
          (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01))))
      (ert-info ((format "Native outcome: %S / %S"
                         (plist-get (mevedel-engine-info request) :mevedel-acp-outcome)
                         (plist-get (mevedel-engine-info request) :error)))
        (should (eq 'ready (plist-get (cdr (assoc "root" (mevedel-session-external-conversations session))) :state))))
      (should (= 2 (mevedel-session-current-segment session)))
      (write-region "REFRESHED PATH GUIDANCE" nil instructions nil 'silent)
      (setf (mevedel-session-workspace-instruction-hashes session)
            (list (cons (list "/root" instructions) (make-string 64 ?a))
                  (cons (list "/root/child" instructions) (make-string 64 ?b))))
      (mevedel-model-set-session-provider
       session (list :backend api :model 'claude-sonnet-4-5) buffer)
      ;; Selecting a provider alone does not discard its native conversation.
      (should (assoc "root" (mevedel-session-external-conversations session)))
      (cl-letf (((symbol-function 'gptel-request)
                 (lambda (prompt &rest options)
                   (should (assoc (list "/root" instructions)
                                  (mevedel-session-workspace-instruction-hashes session)))
                   (should-not (cdr (assoc (list "/root" instructions)
                                           (mevedel-session-workspace-instruction-hashes session))))
                   (setq sent (apply real-request prompt (append options '(:dry-run t))))
                   (mevedel-context-delivery-stage sent)
                   (mevedel-reminders--handle-inject sent)
                   sent)))
        (goto-char (point-max))
        (mevedel--insert-user-turn "Continue through the API")
        (mevedel--send-request))
      (let ((data (prin1-to-string (plist-get (gptel-fsm-info sent) :data))))
        (should (string-search "EFFECTIVE SUMMARY" data))
        (ert-info ((buffer-string))
          (should (string-search "workload complete" data)))
        (should (string-search "TRANSFER TOOL RESULT" data))
        (should (string-search "\"tool_use\"" data))
        (should (string-search "Continue through the API" data))
        (should (string-search "REFRESHED PATH GUIDANCE" data))
        (should-not (string-search "ARCHIVE ONLY" data))
        (should-not (string-search ":signature" data))
        (should-not (string-search ":type \"thinking\"" data)))
      (should-not (assoc "root" (mevedel-session-external-conversations session)))
      (should (equal (secure-hash 'sha256 "REFRESHED PATH GUIDANCE")
                     (cdr (assoc (list "/root" instructions)
                                 (mevedel-session-workspace-instruction-hashes session)))))
      (should (equal (make-string 64 ?b)
                     (cdr (assoc (list "/root/child" instructions)
                                 (mevedel-session-workspace-instruction-hashes session)))))
      ;; Returning after API dispatch starts a replacement native history,
      ;; including when that intervening API attempt did not produce an answer.
      (mevedel-request-end)
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (let (ids)
        (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                   (lambda (_system mcp _model _effort &optional id _hook)
                     (push id ids)
                     (list :command (executable-find "python3")
                           :args (list mevedel-claude-code-transfer-test--peer)
                           :cwd root :mcp mcp :session-id id
                           :meta '((fixtureSessionId . "replacement-session"))))))
          (setq-local gptel-tools nil)
          (goto-char (point-max))
          (mevedel--insert-user-turn "Return to Claude")
          (mevedel--send-request "Return to Claude")
          (with-timeout (5 (ert-fail "Replacement native turn did not settle"))
            (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01)))
          (should (equal '(nil) ids))
          (let ((path (mevedel-session-save-path session)))
            (test-mevedel-session-persistence--release-and-kill buffer session)
            (setq buffer (mevedel-session-persistence-restore path nil nil workspace))
            (set-buffer buffer)
            (setq session mevedel--session))
          (setq-local gptel-tools nil)
          (goto-char (point-max))
          (mevedel--insert-user-turn "After reopening")
          (mevedel--send-request "After reopening")
          (with-timeout (5 (ert-fail "Replacement native history did not resume"))
            (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01)))
          (should (equal '("replacement-session" nil) ids)))))))

(provide 'test-mevedel-claude-code-transfer)
;;; test-mevedel-claude-code-transfer.el ends here
