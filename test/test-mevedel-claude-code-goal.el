;;; test-mevedel-claude-code-goal.el --- Native Goal boundaries -*- lexical-binding: t -*-

;;; Commentary:
;; Exercise Goal observations and accounting through admitted subscription turns.

;;; Code:

(require 'mevedel-engine-test-support
         (file-name-concat (file-name-directory (or load-file-name buffer-file-name))
                           "mevedel-engine-test-support"))
(require 'mevedel-claude-code-session)

(defconst mevedel-claude-code-goal-test--peer
  (file-name-concat (file-name-directory (or load-file-name buffer-file-name))
                    "fixtures" "acp-agent.py"))

(mevedel-deftest mevedel--send-request/claude-goal-budget (:quiet t)
  (mevedel-engine-test--with-session
    (let* ((gptel--known-backends nil)
           (mevedel-claude-code-directory (file-name-concat root "claude"))
           (mevedel-goal-token-budget 100)
           (file (file-name-concat root "evidence.txt"))
           (goal (mevedel-goal-create "Read the two samples and finish" session))
           (before
            [(((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_start")
                         (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                                     (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                               (cache_read_input_tokens . 500) (output_tokens . 1))))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                     (cache_read_input_tokens . 500) (output_tokens . 1)))))))
             (((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_start")
                         (message . ((id . "sample-two") (model . "claude-sonnet-fixture")
                                     (usage . ((input_tokens . 20) (cache_creation_input_tokens . 10)
                                               (cache_read_input_tokens . 500) (output_tokens . 2)))))))))])
           (after
            [(((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 20))))))
              ((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 20))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                     (cache_read_input_tokens . 500) (output_tokens . 1))))))
              ((type . "assistant") (parent_tool_use_id . "foreign-child")
               (message . ((id . "not-this-owner") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 99999) (cache_creation_input_tokens . 99999)
                                     (cache_read_input_tokens . 99999) (output_tokens . 99999))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "synthetic") (model . "<synthetic>")
                           (usage . ((input_tokens . 99999) (cache_creation_input_tokens . 99999)
                                     (cache_read_input_tokens . 99999) (output_tokens . 99999)))))))
             (((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 25)))))))])
           crossings readings)
      (write-region "Evidence" nil file nil 'silent)
      (mevedel-claude-code-register)
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (setq-local gptel-system-prompt "Goal fixture"
                  gptel-tools (list (mevedel-tool-gptel-tool (mevedel-tool-ensure "Read"))))
      (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                 (lambda (_system mcp _model _effort &optional id hook)
                   (list :command (executable-find "python3")
                         :args (list mevedel-claude-code-goal-test--peer)
                         :cwd root :mcp mcp :session-id id
                         :tool-id-field :claudecode/toolUseId
                         :observe #'mevedel-claude-code--observe
                         :check-context #'mevedel-claude-code-context-check
                         :normalize-outcome #'mevedel-claude-code--outcome
                         :control (lambda (owner event)
                                    (push (copy-sequence (plist-get (mevedel-engine-info owner) :tokens-full)) readings)
                                    (let ((result (mevedel-claude-code--control owner event)))
                                      (push (plist-get (plist-get result :hookSpecificOutput) :additionalContext) crossings)
                                      result))
                         :meta `((hookCommand . ,hook)
                                 (sdkBeforeBatches . ,(vconcat (mapcar #'vconcat before)))
                                 (sdkAfterBatches . ,(vconcat (mapcar #'vconcat after)))
                                 (toolBatches . [[((name . "Read") (id . "read-one") (args . ((file_path . ,file))))]
                                                [((name . "Read") (id . "read-two") (args . ((file_path . ,file))))]])
                                 (promptResponse . ((stopReason . "end_turn")
                                                    (usage . ((inputTokens . 30) (outputTokens . 45)
                                                              (cachedWriteTokens . 50) (cachedReadTokens . 1000))))))))))
        (mevedel--insert-user-turn "Carry out the Goal")
        (mevedel--send-request "Carry out the Goal")
        (with-timeout (5 (ert-fail "Budgeted native turn did not settle"))
          (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01))))
      (ert-info ((format "%S %s" (plist-get (mevedel-engine-info request) :error) mevedel-test--captured))
        (should (eq 'success (plist-get (mevedel-engine-info request) :mevedel-acp-outcome))))
      (should (string-search "50%" (or (cadr crossings) "")))
      (should (string-search "80%" (or (car crossings) "")))
      (should (string-search "100%" (or (car crossings) "")))
      (should-not (string-search "50%" (or (car crossings) "")))
      (should (equal '((:input 80 :output 45 :cached 1000 :cache 50)
                       (:input 50 :output 20 :cached 500 :cache 40)) readings))
      (should (= 125 (mevedel-goal-tokens-used goal)))
      (should (= 1 (mevedel-goal-turns-run goal)))
      (should (eq 'budget-limited (mevedel-goal-status goal))))))

(mevedel-deftest mevedel-goal-start/claude-continuation (:quiet t)
  (mevedel-engine-test--with-session
    (mevedel-request-end)
    (let* ((view (generate-new-buffer " *claude-goal-composer*"))
           (gptel--known-backends nil)
           (mevedel-claude-code-directory (file-name-concat root "claude"))
           (file (file-name-concat root "evidence.txt"))
           (launches 0) prompts decisions goal
           (mevedel-post-tool-use-functions
            (list (lambda (_event)
                    (when (memq launches '(2 3))
                      (when (= launches 2)
                        (with-current-buffer view
                          (goto-char (mevedel-view--input-start))
                          (insert "Check the queued priority first")
                          (mevedel-view-send-follow-up)))
                      (with-current-buffer buffer (mevedel-goal-pause)))
                    nil))))
      (unwind-protect
          (progn
            (write-region "Evidence" nil file nil 'silent)
            (mevedel-claude-code-register)
            (mevedel-model-set-session-provider
             session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
            (setq-local gptel-system-prompt "Goal continuation fixture"
                        gptel-tools (list (mevedel-tool-gptel-tool (mevedel-tool-ensure "Read"))))
            (mevedel-chat-install-request-hooks)
            (mevedel-view--setup view buffer)
            (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                       (lambda (_system mcp _model _effort &optional id hook)
                         (cl-incf launches)
                         (list :command (executable-find "python3")
                               :args (list mevedel-claude-code-goal-test--peer)
                               :cwd root :mcp mcp :session-id id
                               :tool-id-field :claudecode/toolUseId
                               :observe (lambda (owner notification)
                                          (let ((message (alist-get 'message (alist-get 'params notification))))
                                            (when (equal "user" (alist-get 'type message))
                                              (cl-pushnew (map-nested-elt message '(message content)) prompts :test #'equal)))
                                          (mevedel-claude-code--observe owner notification))
                               :check-context #'mevedel-claude-code-context-check
                               :normalize-outcome #'mevedel-claude-code--outcome
                               :control (lambda (owner event)
                                          (let ((decision (mevedel-claude-code--control owner event)))
                                            (push decision decisions)
                                            decision))
                               :meta `((hookCommand . ,hook)
                                       (toolBatches . [[((name . "Read")
                                                        (id . ,(format "read-%d" launches))
                                                        (args . ((file_path . ,file))))]])
                                       (promptResponse . ((stopReason . "end_turn")
                                                          (usage . ((inputTokens . 10) (outputTokens . 5)
                                                                    (cachedWriteTokens . 0))))))))))
              (setq goal (mevedel-goal-start "Continue until the user pauses"))
              (with-timeout (8 (ert-fail "Automatic native continuation did not pause"))
                (while (or (< (mevedel-goal-turns-run goal) 2) (mevedel-turn-busy-p buffer))
                  (accept-process-output nil 0.01)))
              (should (= 2 launches))
              (should (eq 'paused (mevedel-goal-status goal)))
              (should (equal "Check the queued priority first"
                             (plist-get (car (mevedel-session-pending-follow-ups session)) :input)))
              (should (eq :json-false (plist-get (car decisions) :continue)))
              (should (string-search "goal-paused" (plist-get (car decisions) :stopReason)))
              (mevedel-goal-resume)
              (with-timeout (8 (ert-fail "Resumed native Goal did not deliver queued input"))
                (while (or (< (mevedel-goal-turns-run goal) 3) (mevedel-turn-busy-p buffer))
                  (accept-process-output nil 0.01)))
              (should (= 3 launches))
              (should (eq 'paused (mevedel-goal-status goal)))
              (should-not (mevedel-session-pending-follow-ups session))
              (should (cl-some (lambda (block)
                                 (equal "Check the queued priority first" (alist-get 'text block)))
                               (car prompts)))
              (should (= 45 (mevedel-goal-tokens-used goal)))
              (should (= 3 (mevedel-session-turn-count session)))))
        (when (buffer-live-p view) (kill-buffer view))))))

(mevedel-deftest mevedel-agent-control-spawn/claude-goal-usage (:quiet t)
  (mevedel-engine-test--with-session
    (let* ((gptel--known-backends nil)
           (mevedel-claude-code-directory (file-name-concat root "claude"))
           (mevedel-goal-token-budget 100)
           (goal (mevedel-goal-create "Investigate with a retained child" session))
           (file (file-name-concat root "evidence.txt"))
           (launches 0) record invocation warnings readings)
      (write-region "Evidence" nil file nil 'silent)
      (mevedel-tool-ensure "Read")
      (mevedel-claude-code-register)
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (setq-local gptel-system-prompt "Goal parent fixture" gptel-tools nil)
      (unwind-protect
          (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                     (lambda (_system mcp _model _effort &optional id hook)
                       (cl-incf launches)
                       (list :command (executable-find "python3")
                             :args (list mevedel-claude-code-goal-test--peer)
                             :cwd root :mcp mcp :session-id id
                             :tool-id-field :claudecode/toolUseId
                             :observe #'mevedel-claude-code--observe
                             :check-context #'mevedel-claude-code-context-check
                             :normalize-outcome #'mevedel-claude-code--outcome
                             :control (lambda (owner event)
                                        (push (mevedel-goal-tokens-used goal) readings)
                                        (let ((result (mevedel-claude-code--control owner event)))
                                          (push (plist-get (plist-get result :hookSpecificOutput) :additionalContext) warnings)
                                          result))
                             :meta (when (> launches 1)
                                     `((hookCommand . ,hook)
                                       (sdkBeforeBatches . [[((type . "assistant")
                                                             (parent_tool_use_id . nil)
                                                             (message . ((id . "child-sample")
                                                                         (usage . ((input_tokens . 40)
                                                                                   (cache_creation_input_tokens . 10)
                                                                                   (cache_read_input_tokens . 500)
                                                                                   (output_tokens . 20))))))]])
                                       (toolBatches . [[((name . "Read") (id . ,(format "child-read-%d" launches))
                                                        (args . ((file_path . ,file))))]])
                                       ;; The missing input counter must retain streamed input.
                                       (promptResponse . ((stopReason . "end_turn")
                                                          (usage . ((outputTokens . 25)))))))))))
            (mevedel--insert-user-turn "wait")
            (mevedel--send-request "wait")
            (with-timeout (5 (ert-fail "Root subscription request did not start"))
              (while (not (string-search "waiting" (buffer-string)))
                (accept-process-output nil 0.01)))
            (dotimes (phase 2)
              (if (zerop phase)
                  (mevedel-agent-control-spawn
                   session "reader" "Read the evidence."
                   (lambda (value) (setq record (plist-get value :record)))
                   :agent (mevedel-agent--create :name "reader" :description "Read evidence"
                                                :tools '(Read) :system-prompt "Read evidence")
                   :on-invocation (lambda (value) (setq invocation value)))
                (mevedel-agent-control-followup session "/root/reader" "Read again.")
                (setq invocation (mevedel-agent-record-invocation record)))
              (ert-info ((format "Child admission: %s" mevedel-test--captured))
                (should (mevedel-agent-invocation-p invocation)))
              (with-timeout (8 (ert-fail "Goal child did not settle"))
                (while (not (mevedel-agent-invocation-runtime-settled-p invocation))
                  (accept-process-output nil 0.01)))
              (should (eq 'completed (mevedel-agent-record-settled-outcome record)))
              (should (= (* 75 (1+ phase)) (mevedel-goal-tokens-used goal)))
              (should (= 0 (mevedel-goal-turns-run goal))))
            (should (equal '(145 70) readings))
            (should (string-search "50%" (or (cadr warnings) "")))
            (should (string-search "whole token budget" (or (car warnings) "")))
            (should (mevedel-turn-busy-p buffer))
            (mevedel-abort buffer)
            (with-timeout (5 (ert-fail "Goal parent did not abort"))
              (while (mevedel-turn-busy-p buffer) (accept-process-output nil 0.01))))
        (when (mevedel-turn-busy-p buffer) (mevedel-abort buffer))
        (when (and record (buffer-live-p (mevedel-agent-record-conversation-buffer record)))
          (kill-buffer (mevedel-agent-record-conversation-buffer record)))))))

(mevedel-deftest mevedel-goal-start/claude-verification (:quiet t)
  (mevedel-engine-test--with-session
    (mevedel-request-end)
    (let* ((gptel--known-backends nil)
           (mevedel-claude-code-directory (file-name-concat root "claude"))
           (mevedel-model-workloads '((goal-review :provider "Claude Code:opus")))
           (roots 0) (verifiers 0) decisions verifier-prompts goal)
      (mevedel-tools-register)
      (mevedel-claude-code-register)
      (mevedel-model-set-session-provider
       session (mevedel-model-resolve-provider "Claude Code:sonnet") buffer)
      (setq-local gptel-system-prompt "Completion fixture"
                  gptel-tools (list (mevedel-tool-gptel-tool (mevedel-tool-ensure "UpdateGoal"))))
      (mevedel-chat-install-request-hooks)
      (unwind-protect
          (cl-letf (((symbol-function 'mevedel-claude-code-launch)
                 (lambda (_system mcp model _effort &optional id hook)
                   (let ((child (bound-and-true-p mevedel--agent-invocation)))
                     (if child (cl-incf verifiers) (cl-incf roots))
                     (when (> roots 2) (ert-fail "Completion started an unexpected third root turn"))
                     (should (equal (if child "opus" "sonnet") model))
                     (list :command (executable-find "python3")
                           :args (list mevedel-claude-code-goal-test--peer)
                           :cwd root :mcp mcp :session-id id
                           :tool-id-field :claudecode/toolUseId
                           :observe (lambda (owner notification)
                                      (let ((message (alist-get 'message (alist-get 'params notification))))
                                        (when (and child (equal "user" (alist-get 'type message)))
                                          (cl-pushnew (map-nested-elt message '(message content))
                                                      verifier-prompts :test #'equal)))
                                      (mevedel-claude-code--observe owner notification))
                           :check-context #'mevedel-claude-code-context-check
                           :normalize-outcome #'mevedel-claude-code--outcome
                           :control (lambda (owner event)
                                      (let ((decision (mevedel-claude-code--control owner event)))
                                        (push decision decisions)
                                        decision))
                           :meta (append
                                  `((hookCommand . ,hook)
                                    (promptResponse . ((stopReason . "end_turn")
                                                       (usage . ((inputTokens . 10) (outputTokens . 5)
                                                                 (cachedWriteTokens . 0))))))
                                  (if child
                                      `((responseText . ,(if (= verifiers 1)
                                                            "The acceptance check is missing.\nVERDICT: FAIL"
                                                          "The acceptance check passed.\nVERDICT: PASS")))
                                    `((toolBatches . [[((name . "UpdateGoal")
                                                       (id . ,(format "complete-%d" roots))
                                                       (args . ((status . "complete")
                                                                (summary . "Untrusted implementer assertion"))))]])))))))))
        (setq goal (mevedel-goal-start "Implement the independently checked fixture"))
        (with-timeout (12 (ert-fail (format "Native completion did not settle: roots=%d verifiers=%d status=%s reason=%s transcript=%s diagnostics=%s"
                                          roots verifiers (mevedel-goal-status goal)
                                          (mevedel-goal-reason goal)
                                          (buffer-substring-no-properties (max (point-min) (- (point-max) 1800)) (point-max))
                                          mevedel-test--captured)))
          (while (or (not (eq 'complete (mevedel-goal-status goal)))
                     (mevedel-turn-busy-p buffer))
            (accept-process-output nil 0.01)))
        (should (= 2 roots))
        (should (= 2 verifiers))
        (should (= 2 (mevedel-goal-turns-run goal)))
        (should (= 60 (mevedel-goal-tokens-used goal)))
        (should (string-search "goal-verification-failed" (plist-get (cadr decisions) :stopReason)))
        (should (string-search "completion verification returned FAIL" (buffer-string)))
        (should (string-search "Implement the independently checked fixture" (prin1-to-string verifier-prompts)))
        (should-not (string-search "Untrusted implementer assertion" (prin1-to-string verifier-prompts))))
        (dolist (entry (mevedel-session-agent-registry session))
          (when-let* ((child-buffer (mevedel-agent-record-conversation-buffer (cdr entry)))
                      ((buffer-live-p child-buffer)))
            (kill-buffer child-buffer)))))))

(provide 'test-mevedel-claude-code-goal)
