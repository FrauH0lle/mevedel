;;; test-mevedel-memory-phase-timing.el -- Consolidation phase timings -*- lexical-binding: t -*-

;;; Commentary:

;; Deterministic clocks exercise lifecycle timing without provider calls.

;;; Code:

(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "helpers"))
(require 'mevedel-memory-pass)
(require 'mevedel-memory-decision)
(require 'mevedel-memory-review)
(require 'mevedel-memory-store)
(require 'mevedel-journal-cleanup)
(require 'mevedel-journal-claim)
(require 'mevedel-journal-worker)
(require 'mevedel-telemetry)
(require 'mevedel-system)
(require 'mevedel-transport)

(mevedel-deftest mevedel-memory-pass--timing-add
    (:vars ((state (list :phase-durations nil))))
  (progn
    (mevedel-memory-pass--timing-add state :preparation-duration-ms nil)
    (should-not (plist-get state :phase-durations))
    (mevedel-memory-pass--timing-add state :preparation-duration-ms 0)
    (should (equal (plist-get state :phase-durations) '(:preparation-duration-ms 0)))
    (mevedel-memory-pass--timing-add state :preparation-duration-ms 25)
    (mevedel-memory-pass--timing-add state :preparation-duration-ms 75)
    (should (equal (plist-get state :phase-durations) '(:preparation-duration-ms 100)))))

(mevedel-deftest mevedel-memory-pass--timing-start
    (:vars ((state (list :workspace nil)) (now 10)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now)))
    (mevedel-memory-pass--timing-start state :preparation-duration-ms)
    (setq now 15)
    (mevedel-memory-pass--timing-start state :preparation-duration-ms)
    (should (equal (plist-get state :phase-starts) '((:preparation-duration-ms . 10))))))

(mevedel-deftest mevedel-memory-pass--timing-end
    (:vars ((state (list :phase-starts nil)) (now 10)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now)))
    (mevedel-memory-pass--timing-end state :preparation-duration-ms)
    (should-not (plist-get state :phase-durations))
    (mevedel-memory-pass--timing-start state :preparation-duration-ms)
    (setq now 10.125)
    (mevedel-memory-pass--timing-end state :preparation-duration-ms)
    (should (equal (plist-get state :phase-durations) '(:preparation-duration-ms 125)))
    (setq now 20)
    (mevedel-memory-pass--timing-end state :preparation-duration-ms)
    (should (equal (plist-get state :phase-durations) '(:preparation-duration-ms 125)))
    (mevedel-memory-pass--timing-start state :preparation-duration-ms)
    (setq now 19)
    (mevedel-memory-pass--timing-end state :preparation-duration-ms)
    (should (equal (plist-get state :phase-durations) '(:preparation-duration-ms 125)))
    (should-not (plist-get state :phase-starts))))

(mevedel-deftest mevedel-memory-pass-start/phase-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (mevedel-memory-dirs (list (file-name-concat root "memory")))
             (mevedel-memory-consolidation-mode 'auto)
             (mevedel-memory-pass--inhibit-scheduling t)
             (mevedel-journal-worker--child-p t)
             (now 10.0) events callback state result
             (recover-decisions (symbol-function 'mevedel-memory-decision-recover))
             (recover-store (symbol-function 'mevedel-memory-store-recover))
             (accept (symbol-function 'mevedel-memory-store-accept))
             (apply-pending (symbol-function 'mevedel-memory-pass--apply-pending))
             (publish (symbol-function 'mevedel-memory-store-publish)))
     :before-each ((make-directory (car mevedel-memory-dirs) t))
     :after-each ((mevedel-memory-pass-stop-all) (delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'mevedel-telemetry-record-workspace)
             (lambda (_workspace event &rest props) (push (cons event props) events)))
            ((symbol-function 'mevedel-memory-decision-recover)
             (lambda (&rest args) (cl-incf now .1) (apply recover-decisions args)))
            ((symbol-function 'mevedel-memory-store-recover)
             (lambda (&rest args) (cl-incf now .2) (apply recover-store args)))
            ((symbol-function 'mevedel-memory-store-accept)
             (lambda (&rest args) (cl-incf now .6) (apply accept args)))
            ((symbol-function 'mevedel-memory-store-publish)
             (lambda (&rest args) (cl-incf now .7) (apply publish args)))
            ((symbol-function 'mevedel-memory-pass--apply-pending)
             (lambda (&rest args) (cl-incf now .8) (apply apply-pending args)))
            ((symbol-function 'mevedel-memory-review-request)
             (lambda (_scope _entries cb &rest _)
               (cl-incf now .4)
               (setq callback cb)
               (list :cancel #'ignore))))
    (setq state (mevedel-memory-pass-start workspace (lambda (reply) (setq result reply))
                                           :memory-only t :queued-at 8.0))
    (should callback)
    (should (equal (mapcar #'car events) '(memory-consolidation-fired)))
    (cl-incf now .5)
    (funcall callback
             (list :outcome 'success :reply
                   (concat "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n"
                           "## Remove\n- none\n## Instructions\n- none\n## No action\n- none")))
    (should (eq (plist-get result :outcome) 'success))
    (should (= (plist-get result :queue-duration-ms) 2000))
    (let ((props (cdar events)))
      (should (eq (caar events) 'memory-consolidation-completed))
      (dolist (entry '((:queue-duration-ms . 2000) (:preparation-duration-ms . 300)
                       (:preparation-recovery-duration-ms . 300) (:review-request-duration-ms . 900)
                       (:publication-duration-ms . 1300) (:application-duration-ms . 800)
                       (:duration-ms . 3300)))
        (should (= (plist-get props (car entry)) (cdr entry))))
      (should-not (plist-member props :retirement-duration-ms)))
    (should (= (length events) 2))
    (let ((timings (copy-tree (plist-get state :phase-durations))))
      (setq now 99)
      (funcall callback '(:outcome aborted))
      (should (= (length events) 2))
      (should (equal timings (plist-get state :phase-durations))))))

(mevedel-deftest mevedel-memory-pass--finish/async-phase-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (mevedel-memory-dirs (list (file-name-concat root "memory")))
             (mevedel-memory-consolidation-mode 'auto)
             (mevedel-memory-pass--inhibit-scheduling t)
             (now 10.0) state result events review-callback storage-callback storage-reply)
     :before-each ((make-directory (car mevedel-memory-dirs) t))
     :after-each ((mevedel-memory-pass-stop-all) (delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'mevedel-telemetry-record-workspace)
             (lambda (_workspace event &rest props) (push (cons event props) events)))
            ((symbol-function 'mevedel-journal-worker-supported-p) (lambda (_) t))
            ((symbol-function 'mevedel-journal-cleanup-schedule) #'ignore)
            ((symbol-function 'mevedel-journal-worker-start)
             (lambda (_workspace operation cb &optional _context payload _owner)
               (setq storage-callback cb
                     storage-reply
                     (pcase operation
                       ('memory-prepare (list :prepared (mevedel-memory-pass--prepare workspace payload)))
                       ('memory-publish (mevedel-memory-pass--publish workspace payload))
                       ('memory-recover (list :ok t :operation-id (plist-get payload :operation-id)))))))
            ((symbol-function 'mevedel-memory-review-request)
             (lambda (_scope _entries cb &rest _) (setq review-callback cb) (list :cancel #'ignore))))
    (setq state (mevedel-memory-pass-start workspace (lambda (reply) (setq result reply)) :memory-only t))
    (setq now 12.0)
    (funcall storage-callback storage-reply)
    (setq now 13.0)
    (funcall review-callback
             (list :outcome 'success :reply
                   (concat "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n"
                           "## Remove\n- none\n## Instructions\n- none\n## No action\n- none")))
    (should-not result)
    (setq now 14.0)
    (funcall storage-callback storage-reply)
    (should-not result)
    (let ((job (plist-get state :application)))
      (cancel-timer (plist-get job :timer))
      (setq now 15.0)
      (mevedel-memory-pass--application-step state job)
      (setq now 16.0)
      (funcall storage-callback storage-reply)
      (cancel-timer (plist-get job :timer))
      (setq now 17.0)
      (mevedel-memory-pass--application-step state job))
    (should (eq (plist-get result :outcome) 'success))
    (should (= (length events) 2))
    (dolist (entry '((:preparation-duration-ms . 2000) (:review-request-duration-ms . 1000)
                     (:publication-duration-ms . 1000) (:application-duration-ms . 3000)
                     (:application-recovery-round-trip-ms . 1000) (:duration-ms . 7000)))
      (should (= (plist-get (cdar events) (car entry)) (cdr entry))))))

(mevedel-deftest mevedel-memory-pass-cancel/phase-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (mevedel-memory-dirs (list (file-name-concat root "memory")))
             (mevedel-memory-consolidation-mode 'propose)
             (mevedel-memory-pass--inhibit-scheduling t)
             (mevedel-journal-worker--child-p t)
             (now 10.0) review-start events callback result
             (settle (symbol-function 'mevedel-journal-claim-settle)))
     :before-each ((make-directory (car mevedel-memory-dirs) t))
     :after-each ((mevedel-memory-pass-stop-all) (delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'mevedel-telemetry-record-workspace)
             (lambda (_workspace event &rest props) (push (cons event props) events)))
            ((symbol-function 'mevedel-journal-claim-settle)
             (lambda (&rest args) (cl-incf now .25) (apply settle args)))
            ((symbol-function 'mevedel-memory-review-request)
             (lambda (_scope _entries cb &rest _)
               (setq callback cb review-start now)
               (list :cancel #'ignore))))
    (mevedel-memory-pass-start workspace (lambda (reply) (setq result reply)) :memory-only t)
    (setq now (+ review-start 1.0))
    (mevedel-memory-pass-cancel workspace)
    (should (eq (plist-get result :outcome) 'aborted))
    (should-not (plist-get result :queue-duration-ms))
    (should (eq (caar events) 'memory-consolidation-killed))
    (should (= (plist-get (cdar events) :review-request-duration-ms) 1000))
    ;; Claim settlement and prepared-evidence release each settle a claim.
    (should (= (plist-get (cdar events) :retirement-duration-ms) 500))
    (should (= (plist-get (cdar events) :duration-ms) (round (* 1000 (- now 10.0)))))
    (should-not (plist-member (cdar events) :publication-duration-ms))
    (setq now 90)
    (funcall callback '(:outcome success))
    (should (= (length events) 2))))

(mevedel-deftest mevedel-memory-decision--start-operation/phase-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (mevedel-journal-worker--child-p t)
             (now 10.0) result
             (recover-decisions (symbol-function 'mevedel-memory-decision-recover))
             (recover-store (symbol-function 'mevedel-memory-store-recover)))
     :before-each ((mevedel-workspace-identity-ensure root))
     :after-each ((delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'mevedel-memory-decision-recover)
             (lambda (&rest args) (cl-incf now .1) (apply recover-decisions args)))
            ((symbol-function 'mevedel-memory-store-recover)
             (lambda (&rest args) (cl-incf now .2) (apply recover-store args))))
    (mevedel-memory-decision--start-operation
     workspace (lambda (_claim _currentp _reply) (cl-incf now 5) 'applied)
     (lambda (reply) (setq result reply)))
    (should (plist-get result :ok))
    (should (eq (plist-get result :value) 'applied))
    (should (= (plist-get result :recovery-round-trip-ms) 300))))

(mevedel-deftest mevedel-memory-pass-schedule/queue-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (mevedel-memory-consolidation-mode 'propose)
             (mevedel-memory-pass--inhibit-scheduling nil)
             (now 10.0) callback queued-at)
     :before-each ((mevedel-workspace-identity-ensure root)
                   (make-directory (file-name-concat root ".mevedel" "shared") t))
     :after-each ((delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'mevedel-transport-schedule-idle)
             (lambda (&rest args) (setq callback (car (last args)))))
            ((symbol-function 'mevedel-memory-pass-start)
             (lambda (_workspace _callback &rest args)
               (setq queued-at (plist-get args :queued-at)) t)))
    (mevedel-memory-pass-schedule workspace)
    (setq now 15.0)
    (funcall callback)
    (should (= queued-at 10.0))))

(mevedel-deftest mevedel-memory-pass--drain-step/queue-timing
    (:vars* ((root (file-name-as-directory (file-truename (make-temp-file "mevedel-timing-" t))))
             (workspace (mevedel-workspace--create :root root))
             (now 10.0) state queued-at)
     :before-each ((mevedel-workspace-identity-ensure root))
     :after-each ((mevedel-memory-pass-cancel workspace) (delete-directory root t)))
  (cl-letf (((symbol-function 'mevedel-telemetry--monotonic-now) (lambda () now))
            ((symbol-function 'input-pending-p) (lambda (&rest _) nil))
            ((symbol-function 'mevedel-transport-busy-p) (lambda (_) nil))
            ((symbol-function 'mevedel-memory-pass-start)
             (lambda (_workspace callback &rest args)
               (push (plist-get args :queued-at) queued-at)
               (cl-incf now 1)
               (funcall callback '(:outcome success :remaining 1 :notes-remaining 0)))))
    (setq state (mevedel-memory-pass-drain workspace #'ignore))
    (cancel-timer (plist-get state :timer))
    (setq now 12.0)
    (mevedel-memory-pass--drain-step state)
    (cancel-timer (plist-get state :timer))
    (should (= (plist-get state :queued-at) 13.0))
    (setq now 15.0)
    (mevedel-memory-pass--drain-step state)
    (should (equal queued-at '(13.0 10.0)))))

(mevedel-deftest mevedel-telemetry--envelope/phase-timing
    (:vars ((props '(:preparation-duration-ms 1 :review-request-duration-ms 2
                    :publication-duration-ms 3 :application-duration-ms 4
                    :retirement-duration-ms 5 :preparation-recovery-duration-ms 6
                    :application-recovery-round-trip-ms 7 :queue-duration-ms 8))))
  (let ((entry (mevedel-telemetry--envelope nil 'memory-consolidation-completed
                                          (append props (list :context props)))))
    (should-not (plist-get entry :dropped-keys))
    (dolist (key (cl-loop for (key _value) on props by #'cddr collect key))
      (should (= (plist-get entry key) (plist-get props key)))
      (should (= (plist-get (plist-get entry :context) key) (plist-get props key))))))

(provide 'test-mevedel-memory-phase-timing)
