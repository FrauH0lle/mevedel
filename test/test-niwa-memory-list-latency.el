;;; test-niwa-memory-list-latency.el --- Cockpit latency regressions -*- lexical-binding: t -*-

;;; Commentary:
;; Exercise native cockpit entry points against isolated accepted history.

;;; Code:

(require 'niwa-memory-decision)
(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "helpers"))
(require 'memory-history-fixtures
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "memory-history-fixtures"))
(require 'niwa-memory-list)
(require 'niwa-memory-library)
(require 'niwa-memory-store)
(require 'niwa-memory-write)
(require 'niwa-journal-worker)
(require 'niwa-session-control-fs)
(require 'niwa-view)
(require 'niwa-view-composer)
(require 'niwa-memory-list-test-support
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "niwa-memory-list-test-support"))

(defvar niwa-test-memory-list--fault nil "Frozen fault for the display child.")
(defvar niwa-test-memory-list--checks 0 "Metadata checks observed by the last child.")

(defun niwa-test-memory-list-child-scan (workspace &optional previous)
  "Scan WORKSPACE through the launcher, returning reply and IO count.
PREVIOUS is a display snapshot.  Fault instrumentation runs in the real child."
  (let* ((spawn (symbol-function 'make-process))
         (stats (make-temp-file (file-name-concat (niwa-workspace-root workspace) "scan-stats-")))
         (fault niwa-test-memory-list--fault)
         child result)
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest args)
                       (let* ((command (plist-get args :command))
                              (setup
                               `(progn
                                  (require 'niwa-session-control-fs)
                                  (defvar niwa-test-scan-count 0)
                                  (defvar niwa-test-scan-checks 0)
                                  ,(when (eq (car fault) 'unrunnable)
                                     '(setq niwa-session-control-fs--program-script
                                            (replace-regexp-in-string "    stat-tree)" "    disabled-stat-tree)"
                                                                      niwa-session-control-fs--program-script t t)))
                                  (advice-add
                                   'niwa-session-control-fs--run-program :around
                                   (lambda (run operations &rest rest)
                                     (cl-incf niwa-test-scan-count)
                                     (when (eq 'stat-tree (plist-get (car operations) :op))
                                       (cl-incf niwa-test-scan-checks)
                                       ,(pcase (car fault)
                                          ('failed '(error "Injected metadata failure"))
                                          ('write `(when (= niwa-test-scan-checks 2)
                                                     (make-directory (file-name-directory ,(nth 1 fault)) t)
                                                     (write-region ,(nth 2 fault) nil ,(nth 1 fault) nil 'silent)))))
                                     (apply run operations rest))))))
                         (apply spawn
                                (plist-put args :command
                                           (append (butlast command 2) (list "--eval" (prin1-to-string setup))
                                                   (last command 2)
                                                   (list "--eval" (prin1-to-string
                                                                   `(with-temp-file ,stats
                                                                      (prin1 (list niwa-test-scan-count niwa-test-scan-checks)
                                                                             (current-buffer))))))))))))
            (setq child (niwa-journal-worker-start
                         workspace 'memory-display
                         (list :client (niwa-workspace-identity-client)
                               :roots (niwa-system--memory-roots workspace) :previous previous)
                         (lambda (reply) (setq result reply)))))
          (let ((until (+ (float-time) 15)))
            (while (and (not result) (< (float-time) until)) (accept-process-output nil .01)))
          (should result)
          (should-not (plist-get result :error))
          (let ((counts (with-temp-buffer (insert-file-contents stats) (read (current-buffer)))))
            (setq niwa-test-memory-list--checks (cadr counts))
            (cons result (car counts))))
      (when (and child (process-live-p child)) (delete-process child))
      (delete-file stats))))

(niwa-deftest niwa-memory-list-latency
    (:vars* ((root (make-temp-file "niwa-cockpit-latency-" t))
             (workspace (niwa-workspace--create :root root :type 'project))
             (memory (file-name-concat root "memory"))
             (niwa-memory-dirs (list memory))
             (batches (if (getenv "NIWA_COCKPIT_BENCHMARK") 4 1))
             (items (if (getenv "NIWA_COCKPIT_BENCHMARK") 8 2))
             (context (niwa-cockpit-workspace-context workspace))
             (niwa-memory-decision--inhibit-recovery nil)
             (niwa-journal-cleanup--inhibit-scheduling t))
     :after-each ((when (get-buffer "*niwa memory*") (kill-buffer "*niwa memory*"))
                  (niwa-memory-decision-stop-recovery)
                  (delete-directory root t)))
  (progn
    (make-directory memory)
    (write-region "A current topic.\n" nil (file-name-concat memory "topic.md") nil 'silent)
    (niwa-workspace-identity-ensure root)
    (niwa-test-memory-history-create workspace batches items
                                        (if (getenv "NIWA_COCKPIT_BENCHMARK") 8192 512))
    ,test)
  (test)
  :doc "measure native open and all three tabs against authentic applied-note history"
  (let ((read (symbol-function 'niwa-memory-store-accepted)) samples sources (calls 0))
    (cl-letf (((symbol-function 'niwa-memory-store-accepted)
               (lambda (&rest args) (cl-incf calls) (apply read args))))
      (save-window-excursion
        (dotimes (_ (if (getenv "NIWA_COCKPIT_BENCHMARK") 3 1))
          ;; Measure the complete scan-backed open, not a counts-chosen Memories view.
          (setf (niwa-workspace-memory-observation workspace) nil)
          (let* ((start (float-time)) (last start) (gap 0) (ticks 0)
                 (collections gcs-done) (gc-seconds gc-elapsed)
                 (timer (run-at-time .01 .01
                                     (lambda ()
                                       (let ((now (float-time)))
                                         (setq gap (max gap (- now last)) last now)
                                         (cl-incf ticks))))))
            (unwind-protect
                (progn
                  (niwa-memory-list-open context)
                  (push (list 'open (- (float-time) start)) samples)
                  (with-current-buffer "*niwa memory*"
                    ;; Without prior counts, opening must scan to choose a view.
                    (let* ((job (or niwa-memory-list--job (ert-fail "Opening did not start a history scan")))
                           (library (cadr (member "-l" (process-command (plist-get job :worker))))))
                      (should (equal (locate-library "niwa-journal-worker") library))
                      (when-let* ((snapshot (getenv "NIWA_COCKPIT_SNAPSHOT")))
                        (dolist (source (list library (symbol-file 'niwa-memory-list-open)
                                              (symbol-file 'gptel-request)))
                          (should (file-in-directory-p source snapshot))))
                      (push (list :editor (symbol-file 'niwa-memory-list-open) :child library
                                  :gptel (symbol-file 'gptel-request)) sources))
                    (with-timeout (45 (ert-fail "Recovery did not admit the display scan"))
                      (while niwa-memory-list--recovery (accept-process-output nil .01)))
                    (push (list 'recovery-ready (- (float-time) start)) samples))
                  (niwa-test-memory-list-await (get-buffer "*niwa memory*"))
                  (push (list 'ready (- (float-time) start)) samples)
                  (push (list 'max-timer-gap gap) samples)
                  (push (list 'max-timer-lateness (max 0 (- gap .01))) samples)
                  (push (list 'editor-gc-count (- gcs-done collections)) samples)
                  (push (list 'editor-gc-seconds (- gc-elapsed gc-seconds)) samples)
                  (should (> ticks 0)))
              (cancel-timer timer)))
          (with-current-buffer "*niwa memory*"
            (dolist (view '(candidates memories history))
              (let ((start (float-time)))
                (niwa-memory-list-switch view)
                (push (list view (- (float-time) start)) samples)))
            ;; Recovery completion may have discarded history while Memories showed.
            (niwa-test-memory-list-await)
            (should (= (* batches items) (length (niwa-cockpit-surface-items))))))))
    (should (= (if (getenv "NIWA_COCKPIT_BENCHMARK") 3 1) (length sources)))
    (when (getenv "NIWA_COCKPIT_BENCHMARK")
      (princ (format "\nCOCKPIT-MEASURE %S accepted-calls=%d\nCOCKPIT-SOURCES %S\n"
                     (nreverse samples) calls sources))
      (princ (format "COCKPIT-CONFIG %S\n"
                     (list :emacs (emacs-version) :scope 'isolated-interpreted-batch
                           :timer-period .01 :gc-cons-threshold gc-cons-threshold
                           :gc-cons-percentage gc-cons-percentage :passes batches :notes (* batches items)
                           :bytes-per-note 8192))))))

(niwa-deftest niwa-memory-list-scan-batches
    (:vars* ((root (make-temp-file "niwa-scan-batches-" t))
             (workspace (niwa-workspace--create :root root :type 'project))
             (niwa-memory-dirs nil)
             (niwa-journal-cleanup--inhibit-scheduling t))
     :after-each ((delete-directory root t)))
  (progn (niwa-workspace-identity-ensure root) ,test)
  (test)
  :doc "control programs grow by pass and bounded batches, not by decision row"
  (let ((run (symbol-function 'niwa-session-control-fs--run-program)) samples)
    (dolist (items '(2 8))
      (niwa-test-memory-history-create workspace 3 items 64)
      (let ((calls 0))
        (cl-letf (((symbol-function 'niwa-session-control-fs--run-program)
                   (lambda (&rest args) (cl-incf calls) (apply run args))))
          (let ((rows (niwa-memory-list--collect (niwa-cockpit-workspace-context workspace))))
            (should (= (if (= items 2) 6 30) (length rows)))
            (should (cl-every (lambda (row) (eq 'applied (plist-get row :status))) rows))))
        (push calls samples)))
    ;; The second scan adds three passes with eight rows each.  Row-at-a-time
    ;; IO exceeds this budget even before accounting for the original passes.
    (should (< (- (car samples) (cadr samples)) 45)))
  :doc "invalid local bundles remain unavailable in the actual child reader"
  (let* ((bundles (niwa-test-memory-history-create workspace 2 1 64))
         (pass (plist-get (plist-get (car bundles) :prepared) :id)))
    (write-region "invalid" nil (file-name-concat (niwa-memory-store--directory workspace pass) "accepted.el") nil 'silent)
    (let* ((result (car (niwa-test-memory-list-child-scan workspace))) (rows (plist-get result :rows)))
      (should-not (plist-get result :native))
      (should-not (plist-get result :error))
      (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows)))
      (should (equal (list pass) (mapcar (lambda (row) (plist-get row :pass))
                                        (seq-filter (lambda (row) (eq 'unavailable (plist-get row :status))) rows))))))
  :doc "retirement after proof authentication cannot leave an applied row"
  (progn
    (niwa-test-memory-history-create workspace 1 2 64)
    (let ((run (symbol-function 'niwa-session-control-fs-run-program)) raced)
    (cl-letf (((symbol-function 'niwa-session-control-fs-run-program)
               (lambda (operations &rest args)
                 (when (eq (plist-get (car operations) :op) 'absent)
                   (setq raced t)
                   (make-directory (file-name-directory (plist-get (car operations) :path)) t)
                   (write-region "retired" nil (plist-get (car operations) :path) nil 'silent))
                 (apply run operations args))))
      (let ((rows (niwa-memory-list--collect (niwa-cockpit-workspace-context workspace))))
        (should raced)
        (should (= 1 (length rows)))
        (should (cl-every (lambda (row) (eq 'unavailable (plist-get row :status))) rows))))))
  :doc "a corrupt decision does not contaminate a healthy pass in the same batch"
  (progn
    (niwa-test-memory-history-create workspace 2 1 64)
    (write-region "invalid" nil (car (niwa-session-control-fs-list-directory
                                    (niwa-memory-decision--directory workspace) niwa-memory-decision--file-regexp)) nil 'silent)
  (let ((rows (niwa-memory-list--collect (niwa-cockpit-workspace-context workspace))))
    (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows)))
    (should (seq-some (lambda (row) (eq 'unavailable (plist-get row :status))) rows))))
  :doc "a slot disappearing after listing does not abort independent passes"
  (progn
    (niwa-test-memory-history-create workspace 2 1 64)
    (let ((batch (symbol-function 'niwa-memory-decision--record-batch)) removed)
    (cl-letf (((symbol-function 'niwa-memory-decision--record-batch)
               (lambda (ws paths)
                 (unless removed (delete-file (car paths)) (setq removed t))
                 (funcall batch ws paths))))
      (let ((rows (niwa-memory-list--collect (niwa-cockpit-workspace-context workspace))))
        (should removed)
        (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows))))))))

(niwa-deftest niwa-memory-list-reuse
    (:vars* ((root (niwa-test-memory-history-root 'memory-list-reuse))
             (workspace (niwa-workspace--create :root root :type 'project))
             (niwa-memory-dirs nil)
             (niwa-journal-cleanup--inhibit-scheduling t)
             (niwa-test-memory-list--checks 0))
     :after-each ((delete-directory root t)))
  (progn
    (niwa-workspace-identity-ensure root)
    (niwa-test-memory-history-build
     'memory-list-reuse root (lambda () (niwa-test-memory-history-create workspace 2 2 64)))
    (cl-labels ((scan (&optional previous)
                  (niwa-test-memory-list-child-scan workspace previous))
                (topic ()
                  (let* ((memory (file-name-concat root "memory"))
                         (niwa-memory-dirs (list memory)))
                    (make-directory memory)
                    (let* ((scope (niwa-memory-scope-capture workspace))
                           (claim (niwa-journal-claim-acquire (niwa-memory-store--claim-directory workspace) 180)))
                      (unwind-protect
                          (let* ((prepared (niwa-memory-store-prepare workspace claim scope nil ""))
                                 (accepted (niwa-memory-store-accept-proposals
                                            workspace prepared
                                            (list :proposals (list (list :action 'promote :root (caar (plist-get scope :roots))
                                                                        :file "guide.md" :type "project" :title "Guide"
                                                                        :hook "Context" :reason "New evidence" :body "Guide.\n")))
                                            nil "test:model" nil))
                                 (pass (plist-get prepared :id)) (id (plist-get (car (plist-get accepted :proposals)) :id)))
                            (niwa-memory-store-publish workspace pass)
                            (should (eq 'applied (plist-get (niwa-memory-decision-apply workspace pass id) :status)))
                            (cons pass id))
                        (niwa-journal-claim-settle claim 'cancelled ""))))))
      ,test))
  (test)
  :doc "unchanged child requests return identical rows with far fewer control programs"
  (dolist (niwa-memory-dirs (list nil (list (file-name-concat root "z-memory") (file-name-concat root "a-memory"))))
    (dolist (directory niwa-memory-dirs) (make-directory directory))
    (let* ((first (scan)) (second (scan (car first))))
      (should (= 4 (length (plist-get (car second) :rows))))
      (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))
      (should (< (cdr second) (/ (cdr first) 3)))))
  :doc "pending proposals are checked again when target contents change outside history"
  (progn
    (niwa-test-memory-history-create workspace 1 1 64 t)
    (let* ((first (scan))
           (pending (seq-find (lambda (row) (eq 'pending (plist-get row :status))) (plist-get (car first) :rows))))
      (should (eq 'fresh (plist-get pending :check)))
      (write-region "changed" nil (file-name-concat root ".niwa/shared/note-0-0.md") nil 'silent)
      (let* ((second (scan (car first)))
             (row (seq-find (lambda (row) (equal (plist-get row :id) (plist-get pending :id)))
                            (plist-get (car second) :rows))))
        (should (plist-get (car second) :fingerprint))
        (should (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
        (should (eq 'stale (plist-get row :check)))
        (should (= 4 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) (plist-get (car second) :rows)))))))
  :doc "history changing during reuse falls back to a full scan on the same open"
  (let* ((first (scan))
         (pass (plist-get (car (plist-get (car first) :rows)) :pass))
         (marker (file-name-concat root ".niwa/state/journal/retired-passes" pass))
         second)
    (let ((niwa-test-memory-list--fault (list 'write marker "retired")))
      (setq second (scan (car first))))
    (should (file-exists-p marker))
    (should (= 2 (length (plist-get (car second) :rows))))
    (should-not (member pass (mapcar (lambda (row) (plist-get row :pass)) (plist-get (car second) :rows))))
    (let ((third (scan (car second))))
      (should (equal (plist-get (car second) :rows) (plist-get (car third) :rows)))))
  :doc "a new decision invalidates reuse and mixed passes have no duplicate rows"
  (let* ((accepted (car (niwa-test-memory-history-create workspace 1 2 64 t)))
         (pass (plist-get (plist-get accepted :prepared) :id))
         (id (plist-get (car (plist-get accepted :proposals)) :id))
         (first (scan)))
    (should (plist-get (car first) :fingerprint))
    (niwa-memory-decision-reject workspace pass id)
    (let* ((second (scan (car first))) (third (scan (car second)))
           (rows (plist-get (car third) :rows)))
      (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (= 6 (length rows)))
      (should (= 1 (seq-count (lambda (row) (eq 'rejected (plist-get row :status))) rows)))
      (should (= 1 (seq-count (lambda (row) (eq 'pending (plist-get row :status))) rows)))))
  :doc "retirement, expiry and changed decision slots force full scans"
  (dolist (kind '(retirement expiry slot))
    (let* ((first (scan)) (pass (plist-get (car (plist-get (car first) :rows)) :pass))
           (warm (scan (car first))) path)
      (should (plist-get (car first) :fingerprint))
      (pcase kind
        ('retirement (setq path (file-name-concat root ".niwa/state/journal/retired-passes" pass)))
        ('expiry (setq path (file-name-concat (niwa-memory-store--directory workspace pass) "accepted.el")))
        ('slot (setq path (car (niwa-session-control-fs-list-directory
                               (niwa-memory-decision--directory workspace) niwa-memory-decision--file-regexp)))))
      (let ((before (when (file-exists-p path) (niwa-session-control-fs-read-file path))))
        (make-directory (file-name-directory path) t)
        (unwind-protect
            (progn
              (if (eq kind 'expiry) (delete-file path) (write-region "changed" nil path nil 'silent))
              (let ((second (scan (car first))))
                (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
                (should (> (cdr second) (* 3 (cdr warm))))
                (should (equal (plist-get (car second) :rows) (plist-get (car (scan)) :rows)))))
          (if before (write-region before nil path nil 'silent) (delete-file path))))))
  :doc "a reversal invalidates the covered baseline and replaces the applied row"
  (let* ((item (topic)) (first (scan)) (baseline (scan (car first))))
    (should (plist-get (car first) :fingerprint))
    (should (plist-get (car baseline) :fingerprint))
    (should (eq 'reversed (plist-get (niwa-memory-decision-reverse workspace (car item) (cdr item)) :status)))
    (let* ((second (scan (car baseline)))
           (row (seq-find (lambda (row) (equal (cdr item) (plist-get row :id))) (plist-get (car second) :rows))))
      (should-not (equal (plist-get (car baseline) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (eq 'reversed (plist-get row :status)))))
  :doc "exact external undo is visible even when history metadata stays unchanged"
  (let* ((item (topic)) (first (scan)))
    (delete-file (file-name-concat root "memory/guide.md"))
    (let* ((second (scan (car first)))
           (row (seq-find (lambda (r) (equal (cdr item) (plist-get r :id))) (plist-get (car second) :rows))))
      (should (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (eq 'applied (plist-get row :status)))
      (should (string-match-p "Choose Reverse" (plist-get row :reversal-hold)))))
  :doc "configured roots, workspace identity and client identity invalidate unchanged metadata"
  (let* ((first (scan)) (previous (car first)))
    (should (plist-get previous :fingerprint))
    (dolist (position '(0 1 2 3 4))
      (let ((changed (niwa-memory-library-copy previous)))
        (setf (nth position (plist-get changed :key)) 'other-context)
        (let ((second (scan changed)))
          (should (>= (cdr second) (cdr first)))
          (should (equal (plist-get previous :rows) (plist-get (car second) :rows))))))
    (let ((niwa-memory-dirs (list (file-name-concat root "another-memory"))))
      (make-directory (car niwa-memory-dirs))
      (let ((second (scan previous)))
        (should-not (equal (plist-get previous :key) (plist-get (car second) :key)))
        (should (>= (cdr second) (cdr first))))))
  :doc "a configured root replaced by a symlink to another directory forces a full scan"
  (let* ((memory (file-name-concat root "memory"))
         (replacement (file-name-concat root "replacement-memory")))
    (topic)
    (let* ((niwa-memory-dirs (list memory))
           (baseline (scan (car (scan)))))
      (should (plist-get (car baseline) :fingerprint))
      (rename-file memory (file-name-concat root "original-memory"))
      (make-directory replacement)
      (make-symbolic-link replacement memory)
      (let ((second (scan (car baseline))))
        (should (memq 'unavailable (mapcar (lambda (row) (plist-get row :status)) (plist-get (car second) :rows))))
        (should (equal (plist-get (car second) :rows) (plist-get (car (scan)) :rows))))))
  :doc "same-size rewrites with restored mtime still invalidate the history observation"
  (let* ((first (scan)) (warm (scan (car first)))
         (pass (plist-get (car (plist-get (car first) :rows)) :pass))
         (path (file-name-concat (niwa-memory-store--directory workspace pass) "accepted.el"))
         (stamp (file-attribute-modification-time (file-attributes path)))
         (text (niwa-session-control-fs-read-file path)))
    (sleep-for .02)
    (write-region text nil path nil 'silent)
    (set-file-times path stamp)
    (let ((second (scan (car first))))
      (should (> (cdr second) (* 3 (cdr warm))))
      (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))))
  :doc "failed, unrunnable and unsafe metadata checks fall back to full authentication"
  (let ((first (scan)))
    (should (plist-get (car first) :fingerprint))
    (dolist (kind '(failed unrunnable symlink))
      (let (second)
        (pcase kind
          ('failed
           (let ((niwa-test-memory-list--fault '(failed)))
             (setq second (scan (car first))))
           (should (> niwa-test-memory-list--checks 0)))
          ('unrunnable
           (let ((niwa-test-memory-list--fault '(unrunnable)))
             (setq second (scan (car first)))))
          ('symlink
           (make-symbolic-link "missing" (file-name-concat root ".niwa/state/journal/unsafe"))
           (setq second (scan (car first)))))
        (should-not (plist-get (car second) :fingerprint))
        (should (> (cdr second) 10))
        (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))))))

(niwa-deftest niwa-memory-list--received
    (:vars* ((root (make-temp-file "niwa-cockpit-race-" t))
             (workspace (niwa-workspace--create :root root :type 'project))
             (context (niwa-cockpit-workspace-context workspace))
             (buffer (generate-new-buffer " *memory-race*"))
             (niwa-memory-dirs nil)
             (observation (list :at (float-time) :pending 1))
             (rows (list (list :id "pending" :pass "pass" :status 'pending
                               :proposal (list :action 'update :type "project" :title "Pending"))
                         (list :id "done" :pass "pass" :status 'applied
                               :proposal (list :action 'update :type "project" :title "Done"))))
             job)
     :after-each ((when (buffer-live-p buffer) (kill-buffer buffer)) (delete-directory root t)))
  (progn
    (niwa-workspace-identity-ensure root)
    ;; Some lifecycle cases need no reply fixture.
    (ignore observation rows)
    (with-current-buffer buffer
      (niwa-memory-list-mode)
      (setq niwa-cockpit--context context
            job (list :context context :root root :identity (niwa-workspace-identity-read root)
                      :client (niwa-workspace-identity-client) :roots nil)
            niwa-memory-list--job job))
    ,test)
  (test)
  :doc "completion renders the newest tab without changing focus, text, or selected row"
  (save-window-excursion
    (with-temp-buffer
      (insert "> draft\nsecond line")
      (switch-to-buffer (current-buffer))
      (let ((origin (current-buffer)) (window (selected-window)))
        (with-current-buffer buffer
          (niwa-memory-list-history)
          (niwa-memory-list--received buffer job (list :rows rows :observation observation))
          (should (eq niwa-memory-list--view 'history))
          (should (equal "done" (tabulated-list-get-id)))
          (should (string-search "Done" (buffer-string)))
          (should-not (string-search "Pending" (buffer-string)))
          (niwa-memory-list-candidates)
          (should (equal "pending" (tabulated-list-get-id)))
          (niwa-memory-list-history)
          (should (equal "done" (tabulated-list-get-id))))
        (should (eq window (selected-window)))
        (should (eq origin (window-buffer window)))
        (should (equal "> draft\nsecond line" (buffer-string))))))
  :doc "older and duplicate deliveries cannot overwrite a newer observation"
  (with-current-buffer buffer
    (setq niwa-memory-list--view 'history)
    (let ((old job))
      (setq job (copy-sequence job) niwa-memory-list--job job)
      (niwa-memory-list--received buffer old '(:error "Old failure"))
      (should-not niwa-memory-list--error)
      (should (eq job niwa-memory-list--job))
      (niwa-memory-list--received buffer job (list :rows rows :observation observation))
      (niwa-memory-list--received buffer job '(:error "Duplicate failure"))
      (should-not niwa-memory-list--error)
      (should (equal "done" (tabulated-list-get-id)))))
  :doc "a replaced context or killed buffer cannot receive old rows"
  (with-current-buffer buffer
    (setq niwa-cockpit--context (copy-sequence context))
    (niwa-memory-list--received buffer job (list :rows rows :observation observation))
    (should-not niwa-memory-list--snapshot)
    (should-not niwa-memory-list--job)
    (should (string-search "context changed" niwa-memory-list--error))
    (kill-buffer buffer)
    (niwa-memory-list--received buffer job (list :rows rows :observation observation)))
  :doc "a replaced workspace identity is reported rather than presented as a valid scan"
  (with-current-buffer buffer
    (write-region (concat (make-string 64 ?a) "\n") nil (niwa-workspace-identity--path root) nil 'silent)
    (niwa-memory-list--received buffer job (list :rows rows :observation observation))
    (should-not niwa-memory-list--snapshot)
    (should (string-search "context changed" niwa-memory-list--error)))
  :doc "owner death clears loading and old rows without reviving the dead session"
  (let ((view (generate-new-buffer " *memory-dead-view*"))
        (data (generate-new-buffer " *memory-dead-data*"))
        (session (niwa-session--create :workspace workspace)))
    (unwind-protect
        (with-current-buffer buffer
          (with-current-buffer data (setq-local niwa--session session))
          (setq context (list :workspace workspace :session session :view-buffer view :data-buffer data)
                niwa-cockpit--context context)
          (plist-put job :context context)
          (plist-put job :session session)
          (kill-buffer view)
          (niwa-memory-list--received buffer job (list :rows rows :observation observation))
          (should-not niwa-memory-list--job)
          (should-not niwa-cockpit--items)
          (should (string-search "context changed" niwa-memory-list--error))
          (should-not (string-search "Loading history" (niwa-memory-list--header nil context))))
      (when (buffer-live-p view) (kill-buffer view))
      (kill-buffer data)))
  :doc "the recovery watcher immediately cancels an in-flight scan after owner death"
  (let ((view (generate-new-buffer " *memory-watch-view*"))
        (data (generate-new-buffer " *memory-watch-data*"))
        (session (niwa-session--create :workspace workspace)))
    (unwind-protect
        (with-current-buffer buffer
          (with-current-buffer data (setq-local niwa--session session))
          (setq context (list :workspace workspace :session session :view-buffer view :data-buffer data)
                niwa-cockpit--context context)
          (niwa-memory-list--start context)
          (let ((child (plist-get niwa-memory-list--job :worker))
                (watcher (list :context context :root root :expires (+ 180 (float-time))
                               :timer (run-at-time 180 nil #'ignore))))
            (setq niwa-memory-list--recovery watcher)
            (should (process-live-p child))
            (kill-buffer view)
            (niwa-memory-list--observe-recovery buffer watcher)
            (should-not (process-live-p child))
            (should-not niwa-memory-list--job)
            (should-not niwa-memory-list--recovery)
            (should (string-search "owner is unavailable" (niwa-memory-list--header nil context)))))
      (when (buffer-live-p view) (kill-buffer view))
      (kill-buffer data)))
  :doc "malformed and proof-bearing responses fail visibly rather than claim pending status"
  (with-current-buffer buffer
    (dolist (reply (list nil (list :rows (list '(:id "bad" :status bogus)) :observation observation)
                        (list :rows (list '(:id "bad" :status pending :accepted proof)) :observation observation)))
      (setq niwa-memory-list--job job niwa-memory-list--error nil)
      (plist-put job :retired nil)
      (niwa-memory-list--received buffer job reply)
      (should (string-search "Invalid memory display observation" niwa-memory-list--error))
      (should (string-search "Scan failed" (niwa-memory-list--header nil context)))
      (should-not niwa-cockpit--items)))
  :doc "returned rows and input strings cannot mutate the display snapshot or workspace counters"
  (with-current-buffer buffer
    (setq niwa-memory-list--view 'candidates)
    (niwa-memory-list--received buffer job (list :rows rows :observation observation))
    (aset (plist-get (plist-get (car rows) :proposal) :title) 0 ?X)
    (let ((returned (niwa-memory-list--visible context)))
      (aset (plist-get (plist-get (car returned) :proposal) :title) 0 ?Y))
    (should (equal "Pending" (plist-get (plist-get (car (niwa-memory-list--visible context)) :proposal) :title)))
    (setf (plist-get observation :pending) 99)
    (should (= 1 (plist-get (niwa-workspace-memory-observation workspace) :pending)))))

(niwa-deftest niwa-memory-list--start
    (:vars* ((root (make-temp-file "niwa-cockpit-lifecycle-" t))
             (workspace (niwa-workspace--create :root root :type 'project))
             (context (niwa-cockpit-workspace-context workspace))
             (buffer (generate-new-buffer " *memory-lifecycle*"))
             (niwa-memory-dirs nil))
     :after-each ((when (buffer-live-p buffer) (kill-buffer buffer))
                  (when (get-buffer "*niwa memory*") (kill-buffer "*niwa memory*"))
                  (delete-directory root t)))
  (progn
    (niwa-workspace-identity-ensure root)
    (with-current-buffer buffer
      (niwa-memory-list-mode)
      (setq niwa-cockpit--context context))
    ,test)
  (test)
  :doc "explicit refresh stops the old child and late completion cannot replace its successor"
  (with-current-buffer buffer
    (niwa-memory-list--start context)
    (let* ((old niwa-memory-list--job) (child (plist-get old :worker))
           (directory (file-name-directory (nth 1 (read (car (last (process-command child))))))))
      (should (process-live-p child))
      (niwa-memory-list-refresh)
      (should-not (process-live-p child))
      (should-not (file-directory-p directory))
      (should-not (eq old niwa-memory-list--job))
      (niwa-memory-list--received buffer old '(:error "Late failure"))
      (niwa-test-memory-list-await)
      (should-not niwa-memory-list--error)
      (should-not (niwa-cockpit-surface-items))))
  :doc "buffer death and mode change stop owned display children without recreating the buffer"
  (dolist (kill '(nil t))
    (with-current-buffer buffer
      (niwa-memory-list-mode)
      (setq niwa-cockpit--context context)
      (niwa-memory-list--start context)
      (let* ((old niwa-memory-list--job)
             (child (plist-get old :worker))
             (directory (file-name-directory (nth 1 (read (car (last (process-command child))))))))
        (if kill (kill-buffer buffer) (fundamental-mode))
        (should-not (process-live-p child))
        (should-not (file-directory-p directory))
        (niwa-memory-list--received buffer old '(:error "Late failure")))))
  :doc "the original deadline stops its child and leaves a visible retryable error"
  (with-current-buffer buffer
    (niwa-memory-list--start context)
    (let* ((job niwa-memory-list--job) (child (plist-get job :worker)))
      (funcall (timer--function (plist-get job :timer)))
      (should-not niwa-memory-list--job)
      (should-not (process-live-p child))
      (should (string-search "timed out" niwa-memory-list--error))
      (should (string-search "g retries" (niwa-memory-list--header nil context)))))
  :doc "reopening observes a coalesced recovery owner started outside this cockpit"
  (let* ((niwa-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (niwa-memory-store--claim-directory workspace))
         (owner (list 'existing-owner)))
    (puthash key owner niwa-memory-decision--recovery-workers)
    (save-window-excursion
      (niwa-memory-list-open context)
      (let ((previous (buffer-local-value 'niwa-memory-list--recovery (get-buffer "*niwa memory*"))))
        (with-current-buffer (niwa-memory-list-open context)
          (should-not (eq previous niwa-memory-list--recovery))
          (should-not (memq (plist-get previous :timer) timer-list))
          (let ((watcher niwa-memory-list--recovery))
            (niwa-memory-list--observe-recovery (current-buffer) watcher)
            (should (eq watcher niwa-memory-list--recovery))
            (should (eq owner (gethash key niwa-memory-decision--recovery-workers)))
            (remhash key niwa-memory-decision--recovery-workers)
            (niwa-memory-list--observe-recovery (current-buffer) watcher)
            (niwa-test-memory-list-await)
            (should-not niwa-memory-list--recovery)
            (should niwa-memory-list--snapshot))))))
  :doc "opening scans during recovery, rescans only after a changing recovery, and tabs reuse each snapshot"
  (let* ((starts 0) (start (symbol-function 'niwa-memory-list--start))
         (niwa-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (niwa-memory-store--claim-directory workspace))
         (owner (list 'existing-owner)))
    (puthash key owner niwa-memory-decision--recovery-workers)
    (cl-letf (((symbol-function 'niwa-memory-list--start)
               (lambda (context) (cl-incf starts) (funcall start context))))
      (unwind-protect
          (save-window-excursion
            (with-current-buffer (niwa-memory-list-open context)
              (let ((child (plist-get niwa-memory-list--job :worker)))
                (should (processp child))
                (with-timeout (45 (ert-fail "Independent display scan did not finish"))
                  (while niwa-memory-list--job (accept-process-output nil .01)))
                (should-not (process-live-p child)))
              (should niwa-memory-list--snapshot)
              (should niwa-memory-list--recovery)
              (should (eq owner (gethash key niwa-memory-decision--recovery-workers)))
              (should (= 1 starts))
              (dolist (view '(history candidates memories history)) (niwa-memory-list-switch view))
              (should (= 1 starts))
              ;; A recovery that changed nothing leaves the committed snapshot current.
              (let ((watcher niwa-memory-list--recovery))
                (remhash key niwa-memory-decision--recovery-workers)
                (niwa-memory-list--observe-recovery (current-buffer) watcher)
                (should-not niwa-memory-list--recovery)
                (should niwa-memory-list--snapshot)
                (should (= 1 starts)))
              ;; Reopening watches again; a changing recovery stales the snapshot.
              (puthash key owner niwa-memory-decision--recovery-workers)
              (niwa-memory-list-open context)
              ;; Counts without alerts reopen Memories; History scans on demand.
              (should (eq 'memories niwa-memory-list--view))
              (should-not niwa-memory-list--job)
              (niwa-memory-list-history)
              (with-timeout (45 (ert-fail "Reopened display scan did not finish"))
                (while niwa-memory-list--job (accept-process-output nil .01)))
              (setq starts 1)
              (niwa-memory-decision--recovery-changed workspace)
              (remhash key niwa-memory-decision--recovery-workers)
              (niwa-memory-list--observe-recovery (current-buffer) niwa-memory-list--recovery)
              (niwa-test-memory-list-await)
              (should (= 2 starts))
              (niwa-memory-list-refresh)
              (niwa-test-memory-list-await)
              (should (= 3 starts))))
        (when (eq owner (gethash key niwa-memory-decision--recovery-workers))
          (remhash key niwa-memory-decision--recovery-workers))
        (when (get-buffer "*niwa memory*") (kill-buffer "*niwa memory*")))))
  :doc "Memories inventories once while recovery is pending and keeps that independent observation"
  (let* ((niwa-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (niwa-memory-store--claim-directory workspace))
         (read (symbol-function 'niwa-memory-library-refresh)) (reads 0))
    (puthash key '(existing-owner) niwa-memory-decision--recovery-workers)
    (cl-letf (((symbol-function 'niwa-memory-library-refresh)
               (lambda (&rest args) (cl-incf reads) (apply read args))))
      (save-window-excursion
        (with-current-buffer (niwa-memory-list-open context)
          (niwa-memory-list-memories)
          (niwa-test-memory-list-await-memories)
          (should (= 1 reads))
          (let ((watcher niwa-memory-list--recovery))
            (niwa-memory-decision--recovery-changed workspace)
            (remhash key niwa-memory-decision--recovery-workers)
            (niwa-memory-list--observe-recovery (current-buffer) watcher))
          (niwa-test-memory-list-await)
          (should (= 1 reads))))))
  :doc "pending quit after actual process creation cannot orphan its child before handoff"
  (with-current-buffer buffer
    (let ((create (symbol-function 'make-process)) child directory cancelled)
      (unwind-protect
          (progn
            (let ((inhibit-quit nil))
              (cl-letf (((symbol-function 'make-process)
                         (lambda (&rest args)
                           (setq child (apply create args)
                                 directory (file-name-directory (nth 1 (read (car (last (plist-get args :command))))))
                                 quit-flag t)
                           (unless inhibit-quit (setq quit-flag nil) (signal 'quit nil))
                           child)))
                (condition-case nil (niwa-memory-list--start context) (quit (setq cancelled t)))))
            (should child)
            (should cancelled)
            (should-not (process-live-p child))
            (should-not (file-directory-p directory))
            (should-not niwa-memory-list--job))
        (setq quit-flag nil)
        (when (and child (process-live-p child)) (delete-process child)))))
  :doc "pending quit after real deadline creation cannot leak the unregistered timer"
  (with-current-buffer buffer
    (let ((schedule (symbol-function 'run-at-time)) timer child cancelled)
      (unwind-protect
          (progn
            (let ((inhibit-quit nil))
              (cl-letf (((symbol-function 'run-at-time)
                         (lambda (&rest args)
                           (setq timer (apply schedule args)
                                 child (plist-get niwa-memory-list--job :worker) quit-flag t)
                           (unless inhibit-quit (setq quit-flag nil) (signal 'quit nil))
                           timer)))
                (condition-case nil (niwa-memory-list--start context) (quit (setq cancelled t)))))
            (should timer)
            (should cancelled)
            (should-not (process-live-p child))
            (should-not (memq timer timer-list))
            (should-not niwa-memory-list--job))
        (setq quit-flag nil)
        (when (timerp timer) (cancel-timer timer))
        (when (and child (process-live-p child)) (delete-process child)))))
  :doc "cleanup error or quit retains the retired child handle and makes callbacks inert until retry"
  (with-current-buffer buffer
    (let ((launch (symbol-function 'make-process)))
      ;; This case tests child-stop handling, not collector output.  Keep a real
      ;; child alive so natural completion cannot skip the injected stop.
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (apply launch
                          (plist-put args :command
                                     (list (expand-file-name invocation-name invocation-directory)
                                           "-Q" "--batch" "--eval" "(sleep-for 60)"))))))
        (dolist (failure '(error quit))
          (niwa-memory-list--start context)
          (let* ((job niwa-memory-list--job) (child (plist-get job :worker))
                 (timer (plist-get job :timer))
                 (directory (process-get child 'niwa-journal-worker-directory))
                 (stop (symbol-function 'delete-process)) (inject t) (stops 0) caught)
            (should (process-live-p child))
            (cl-letf (((symbol-function 'delete-process)
                       (lambda (process)
                         (when (eq process child) (cl-incf stops))
                         (if (and inject (eq process child))
                             (signal failure '("Injected stop failure"))
                           (funcall stop process)))))
              (condition-case err (niwa-memory-list--cancel) ((error quit) (setq caught (car err))))
              (should (= 1 stops))
              (should (eq caught failure))
              (should (eq job niwa-memory-list--job))
              (should (plist-get job :retired))
              (should (process-live-p child))
              (should-not (memq timer timer-list))
              (should (string-search "cleanup failed" (niwa-memory-list--header nil context)))
              (niwa-memory-list--received buffer job '(:error "Late failure"))
              (should (eq job niwa-memory-list--job))
              ;; Negative control: the same child stops once injection is off.
              (setq inject nil)
              (niwa-memory-list--cancel)
              (should (= 2 stops))
              (should-not (process-live-p child))
              (should-not (file-directory-p directory))
              (should-not niwa-memory-list--job)))))))
  :doc "request writing remains interruptible and releases its registered directory on quit"
  (with-current-buffer buffer
    (let (directory)
      (cl-letf (((symbol-function 'niwa-journal-worker--write)
                 (lambda (file _value)
                   (setq directory (file-name-directory file))
                   (should-not inhibit-quit)
                   (signal 'quit nil))))
        (condition-case nil (niwa-memory-list--start context) (quit nil)))
      (should directory)
      (should-not (file-directory-p directory))
      (should-not niwa-memory-list--job)))
  :doc "unrelated background work cannot hold this workspace's display watcher"
  (let ((niwa-transport--background-running t))
    (save-window-excursion
      (with-current-buffer (niwa-memory-list-open context)
        (should-not (niwa-memory-decision-recovering-p workspace))
        (niwa-memory-list--observe-recovery (current-buffer) niwa-memory-list--recovery)
        (should-not niwa-memory-list--recovery)
        (niwa-test-memory-list-await)
        (should niwa-memory-list--snapshot)))))

(niwa-deftest niwa-memory-list-refresh
    (:vars* ((root (niwa-test-memory-history-root 'memory-list-refresh))
             (workspace (niwa-workspace--create :root root :type 'project))
             (memory (file-name-concat root "memory"))
             (niwa-memory-dirs (list memory))
             (niwa-memory-decision--inhibit-recovery nil)
             (niwa-journal-cleanup--inhibit-scheduling t)
             (context (niwa-cockpit-workspace-context workspace)))
     :after-each ((when (get-buffer "*niwa memory*") (kill-buffer "*niwa memory*"))
                  (niwa-memory-decision-stop-recovery)
                  (delete-directory root t)))
  (progn
    (niwa-workspace-identity-ensure root)
    (niwa-test-memory-history-build
     'memory-list-refresh root
     (lambda ()
       (make-directory memory)
       (dolist (file '("first.md" "second.md"))
         (write-region "A current topic.\n" nil (file-name-concat memory file) nil 'silent))
       (niwa-test-memory-history-create workspace 1 2 512)
       (niwa-test-memory-history-create workspace 1 2 512 t)))
    (save-window-excursion
      (with-current-buffer (niwa-memory-list-open context)
        (niwa-test-memory-list-await)
        ,test)))
  (test)
  :doc "g and review completion preserve a surviving non-first selection in every tab and rejection targets it"
  (progn
    (dolist (cause '(explicit completion))
      (dolist (view '(candidates memories history))
        (niwa-memory-list-switch view)
        ;; A refresh on Memories leaves history to load with its own view.
        (niwa-test-memory-list-await)
        (should (>= (length (niwa-cockpit-surface-items)) 2))
        (let ((selected (plist-get (cadr (niwa-cockpit-surface-items)) :id)))
          (niwa-cockpit-goto-id selected)
          (if (eq cause 'explicit)
              (call-interactively (key-binding (kbd "g")))
            (let (messages)
              (niwa-test--with-captured-messages messages
                (niwa-memory-list--finished workspace '(:outcome success :mode propose)))
              (should (string-search "memory review covered 0 digests" messages))))
          (niwa-test-memory-list-await)
          (should (eq view niwa-memory-list--view))
          (should (equal selected (tabulated-list-get-id))))))
    (niwa-memory-list-candidates)
    (let* ((items (niwa-cockpit-surface-items))
           (first (car items)) (selected (cadr items)))
      (niwa-cockpit-goto-id (plist-get selected :id))
      (call-interactively (key-binding (kbd "g")))
      (niwa-test-memory-list-await)
      (call-interactively (key-binding (kbd "r")))
      (niwa-test-memory-list-await)
      (should (eq 'rejected (plist-get (niwa-memory-decision-status workspace (plist-get selected :id)) :status)))
      (should-not (niwa-memory-decision-status workspace (plist-get first :id)))))
  :doc "switching tabs during loading keeps their own non-first selections and acceptance targets the restored row"
  (let (selected history first)
    (dolist (view '(history candidates))
      (niwa-memory-list-switch view)
      (should (>= (length (niwa-cockpit-surface-items)) 2))
      (niwa-cockpit-goto-id (plist-get (cadr (niwa-cockpit-surface-items)) :id))
      (if (eq view 'history) (setq history (tabulated-list-get-id))
        (setq selected (niwa-cockpit-surface-selected) first (car (niwa-cockpit-surface-items)))))
    (call-interactively (key-binding (kbd "g")))
    (should niwa-memory-list--job)
    (niwa-memory-list-history)
    (niwa-memory-list-candidates)
    (niwa-memory-list-history)
    (niwa-test-memory-list-await)
    (should (eq 'history niwa-memory-list--view))
    (should (equal history (tabulated-list-get-id)))
    (niwa-memory-list-candidates)
    (should (equal (plist-get selected :id) (tabulated-list-get-id)))
    (call-interactively (key-binding (kbd "a")))
    (niwa-test-memory-list-await)
    (should (eq 'applied (plist-get (niwa-memory-decision-status workspace (plist-get selected :id)) :status)))
    (should-not (niwa-memory-decision-status workspace (plist-get first :id))))
  :doc "nonselected async refresh preserves each displayed window's row and the active real composer"
  (let* ((data (generate-new-buffer " *memory-selection-data*"))
         (view (generate-new-buffer " *memory-selection-chat*"))
         (session (niwa-session-create "selection" workspace))
         (draft "> active draft\nsecond line") chat left right selected first)
    (unwind-protect
        (progn
          (with-current-buffer data (setq-local niwa--session session))
          (niwa-view--setup view data)
          (with-current-buffer view (niwa-view-test--insert-composer-draft draft 4))
          (delete-other-windows)
          (switch-to-buffer view)
          (setq chat (selected-window) left (split-window-right)
                right (split-window left nil 'below))
          (let ((context (with-current-buffer view (niwa-cockpit-current-context))))
            (with-selected-window left
              (let ((display-buffer-overriding-action '(display-buffer-same-window)))
                (niwa-memory-list-open context))))
          (set-window-buffer right (get-buffer "*niwa memory*"))
          (niwa-test-memory-list-await (get-buffer "*niwa memory*"))
          (dolist (tab '(history memories candidates))
            (let (left-id right-id)
              (with-selected-window left
                (niwa-memory-list-switch tab)
                (when (eq tab 'memories) (niwa-test-memory-list-await-memories))
                (setq left-id (plist-get (car (niwa-cockpit-surface-items)) :id)
                      right-id (plist-get (cadr (niwa-cockpit-surface-items)) :id))
                (should left-id) (should right-id)
                (niwa-cockpit-goto-id left-id))
              (with-selected-window right (niwa-cockpit-goto-id right-id))
              (with-selected-window left
                (call-interactively (key-binding (kbd "g")))
                (niwa-memory-list-switch (if (eq tab 'history) 'candidates 'history))
                (niwa-memory-list-switch tab))
              ;; Memories remains usable while history is loading. A newer
              ;; window selection must beat the one saved before refresh.
              (when (eq tab 'memories)
                (with-selected-window right (niwa-cockpit-goto-id left-id))
                (setq right-id left-id))
              (niwa-test-memory-list-await (get-buffer "*niwa memory*"))
              (should (eq chat (selected-window)))
              (with-current-buffer view
                (should (equal draft (niwa-view-composer-draft-text)))
                (should (= 4 (niwa-view-test--composer-point-offset))))
              (with-selected-window left (should (equal left-id (tabulated-list-get-id))))
              (with-selected-window right (should (equal right-id (tabulated-list-get-id))))))
          (with-selected-window right
            (setq selected (niwa-cockpit-surface-selected)
                  first (car (niwa-cockpit-surface-items)))
            (should-not (equal (plist-get selected :id) (plist-get first :id)))
            (call-interactively (key-binding (kbd "r"))))
          (niwa-test-memory-list-await (get-buffer "*niwa memory*"))
          (should (eq 'rejected (plist-get (niwa-memory-decision-status workspace (plist-get selected :id)) :status)))
          (should-not (niwa-memory-decision-status workspace (plist-get first :id)))
          (should (eq chat (selected-window)))
          (with-current-buffer view
            (should (equal draft (niwa-view-composer-draft-text)))
            (should (= 4 (niwa-view-test--composer-point-offset)))))
      (when (get-buffer "*niwa memory*") (kill-buffer "*niwa memory*"))
      (when (buffer-live-p view) (kill-buffer view))
      (when (buffer-live-p data) (kill-buffer data)))))

