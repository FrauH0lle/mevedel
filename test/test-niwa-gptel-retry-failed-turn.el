(niwa-deftest niwa-gptel-retry-failed-turn/claude-retries-first-prompt-cleanly (:quiet t)
  (niwa-engine-test--with-claude-session
    (let* ((image (file-name-concat root "retry.png"))
           (bytes "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aS1sAAAAASUVORK5CYII=")
           (prompt (format "Inspect the original image @file:{%s}" image))
           (submit (symbol-function 'niwa-acp-prompt))
           (launches 0) identities submissions)
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (insert (base64-decode-string bytes))
        (let ((coding-system-for-write 'no-conversion))
          (write-region (point-min) (point-max) image nil 'silent)))
      (setq-local gptel-system-prompt "Retry fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'niwa-acp-prompt)
                 (lambda (&rest args)
                   (push (copy-tree (cadr args) t) submissions)
                   (apply submit args)))
                ((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (_system _mcp _model _effort &optional id _hook)
                    (push id identities)
                    (cl-incf launches)
                    (list :meta `((responseText . ,(if (= launches 1) "Failed partial output" "Retried answer"))
                                  (promptResponse . ((stopReason . ,(if (= launches 1) "max_tokens" "end_turn"))))))))))
        (niwa--insert-local-user-turn prompt)
        (niwa--send-request (concat "Internal skill instructions\n" prompt))
        (niwa-test--await 5 "Initial Claude failure did not settle"
          (not (niwa-turn-busy-p buffer)))
        (should (= 1 (niwa-session-turn-count session)))
        (let ((id (niwa-gptel-retry-available-p buffer)))
          (should id)
          (delete-file image)
          (niwa-gptel-retry-failed-turn buffer id)
          (should-not (niwa-gptel-retry-available-p buffer id)))
        (niwa-test--await 5 "Retried Claude turn did not settle"
          (not (niwa-turn-busy-p buffer)))
        (should (equal '(nil nil) identities))
        (should (= 1 (niwa-session-turn-count session)))
        (should (= 1 (length (cdr (assoc 1 (niwa-session-prompt-index session))))))
        (should-not (string-search "Failed partial output" (buffer-string)))
        (should (string-search "Retried answer" (buffer-string)))
        (should-not (string-search "Internal skill instructions" (buffer-string)))
        (should (string-search ":outcome error" (buffer-string)))
        (should (= 2 (length submissions)))
        (dolist (input submissions)
          (let ((images (seq-filter (lambda (part) (equal "image" (alist-get 'type part))) input)))
            (should (= 1 (length images)))
            (should (equal bytes (alist-get 'data (car images)))))
          (should (seq-some (lambda (part)
                              (string-search "Inspect the original image" (or (alist-get 'text part) "")))
                            input)))))))

(niwa-deftest niwa-gptel-retry-failed-turn/claude-forks-before-failed-prompt ()
  (niwa-engine-test--with-claude-session
    (let* ((history-root (file-name-concat root "native"))
           (trace (file-name-concat root "native-trace.jsonl"))
           (process-environment (copy-sequence process-environment))
           (turns 0) identities)
      (make-directory history-root t)
      (with-temp-file (file-name-concat history-root "fixture-session.json") (insert "[]"))
      (setenv "NIWA_ACP_TEST_HISTORY" history-root)
      (setenv "NIWA_ACP_TEST_TRACE" trace)
      (setq-local gptel-system-prompt "Retry boundary fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (system _mcp _model _effort &optional id _hook)
                    (unless (equal system "Prepare native history boundary")
                      (push id identities)
                      (cl-incf turns))
                    (list :meta
                          `((responseText . ,(pcase turns
                                               (1 "Prior settled answer")
                                               (2 "Failed partial output")
                                               (_ "Retried answer")))
                            (responseMessageId . ,(format "native-answer-%d" turns))
                            (promptResponse . ((stopReason . ,(if (= turns 2) "max_tokens" "end_turn"))))))))))
        (niwa--insert-local-user-turn "First prompt")
        (niwa--send-request)
        (niwa-test--await 5 "First native turn did not settle" (not (niwa-turn-busy-p buffer)))
        (ert-info ((format "First settled history: %S; launches: %S; transcript: %S"
                           (niwa-session-external-conversations session) turns (buffer-string)))
          (should (plist-get (cdr (assoc "root" (niwa-session-external-conversations session))) :boundaries)))
        (goto-char (point-max))
        (niwa--insert-local-user-turn "Second prompt")
        (niwa--send-request)
        (niwa-test--await 5 "Failed native turn did not settle" (not (niwa-turn-busy-p buffer)))
        (should (= 2 (niwa-session-turn-count session)))
        (let ((id (niwa-gptel-retry-available-p buffer)))
          (should id)
          (niwa-gptel-retry-failed-turn buffer id))
        (niwa-test--await 10 "Forked native Retry did not settle" (not (niwa-turn-busy-p buffer)))
        (should (equal '("fixture-fork" "fixture-session" nil) identities))
        (should (= 2 (niwa-session-turn-count session)))
        (should (= 2 (length (cdr (assoc 1 (niwa-session-prompt-index session))))))
        (should (string-search "Prior settled answer" (buffer-string)))
        (should-not (string-search "Failed partial output" (buffer-string)))
        (should (string-search "Retried answer" (buffer-string)))
        (should (string-search ":outcome error" (buffer-string)))
        (should (file-exists-p (file-name-concat history-root "fixture-session.json")))
        (should (file-exists-p (file-name-concat history-root "fixture-fork.json")))
        (let* ((frames (with-temp-buffer
                         (insert-file-contents trace)
                         (mapcar (lambda (line) (json-parse-string line :object-type 'alist))
                                 (split-string (buffer-string) "\n" t))))
               (fork (seq-find (lambda (frame) (equal "session/fork" (alist-get 'method frame))) frames))
               (params (alist-get 'params fork)))
          (should (equal "fixture-session" (alist-get 'sessionId params)))
          (should (equal "native-answer-1"
                         (alist-get 'messageId (alist-get 'fork (alist-get 'air
                           (alist-get 'jetbrains (alist-get '_meta params))))))))))))

(niwa-deftest niwa-gptel-retry-failed-turn/legacy-native-history-retries-in-place ()
  (dolist (tombstone '(nil t))
   (niwa-engine-test--with-claude-session
    (let ((submit (symbol-function 'niwa-acp-prompt))
          (turns 0) identities submissions)
      (setq-local gptel-system-prompt "Legacy Retry fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'niwa-acp-prompt)
                 (lambda (&rest args)
                   (push (copy-tree (cadr args) t) submissions)
                   (apply submit args)))
                ((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (system _mcp _model _effort &optional id _hook)
                    (should-not (equal system "Prepare native history boundary"))
                    (push id identities)
                    (cl-incf turns)
                    (list :meta
                          `((responseText . ,(pcase turns
                                               (1 "Prior settled answer")
                                               (2 "Failed partial output")
                                               (_ "Retried answer")))
                            (promptResponse . ((stopReason . ,(if (= turns 2) "max_tokens" "end_turn"))))))))))
        (niwa--insert-local-user-turn "Legacy first prompt")
        (niwa--send-request)
        (niwa-test--await 5 "Legacy first turn did not settle" (not (niwa-turn-busy-p buffer)))
        (should-not (plist-get (cdar (niwa-session-external-conversations session)) :boundaries))
        (when tombstone
          (plist-put (cdar (niwa-session-external-conversations session))
                     :boundaries '((:turn 1 :detached t))))
        (goto-char (point-max))
        (niwa--insert-local-user-turn "Legacy second prompt")
        (niwa--send-request)
        (niwa-test--await 5 "Legacy failure did not settle" (not (niwa-turn-busy-p buffer)))
        (niwa-gptel-retry-failed-turn buffer (niwa-gptel-retry-available-p buffer))
        (niwa-test--await 5 "Legacy Retry did not settle" (not (niwa-turn-busy-p buffer)))
        (should (equal '("fixture-session" "fixture-session" nil) identities))
        (should (= 2 (niwa-session-turn-count session)))
        (should (string-search "Retried answer" (buffer-string)))
        (should-not (string-search "Failed partial output" (buffer-string)))
        (should (seq-some (lambda (part)
                            (string-search "reuses the same native session"
                                           (or (alist-get 'text part) "")))
                          (car submissions))))))))

(ert-deftest niwa-gptel-retry-failed-turn/native-publication-failure-keeps-owned-identity ()
  (dolist (committed '(nil t))
    (with-temp-buffer
      (let* ((previous '(("root" :engine claude-code :id "old" :state uncertain)))
             (hashes '((("/root" . "/instructions") . "old-receipt")))
             (mentions (make-hash-table :test #'equal))
             (session (niwa-session--create
                       :turn-count 1 :external-conversations (copy-tree previous)
                       :workspace-instruction-hashes hashes :mentions-shown mentions
                       :publication '(:head "old-head")))
             (request (niwa-request--create :session session :turn 1))
             (failure '(:turn 1))
             (history '(:engine claude-code :id "new" :state ready))
             deleted published)
        (puthash "seen" t mentions)
        (setq-local niwa--session session niwa--current-request request)
        (cl-letf (((symbol-function 'niwa-claude-code-fork-histories)
                   (lambda (_histories complete &optional _session)
                     (funcall complete (list (cons "root" history)) nil
                              (lambda () (setq deleted t)))))
                  ((symbol-function 'niwa-gptel-retry--same-source-p) (lambda (_) t))
                  ((symbol-function 'niwa-session-artifacts-save)
                   (lambda (&rest _)
                     (should-not (cdar (niwa-session-workspace-instruction-hashes session)))
                     (should (zerop (hash-table-count (niwa-session-mentions-shown session))))
                     (should (seq-some (lambda (text) (string-search "Retry from before" text))
                                       (niwa-session-pending-reminders session)))
                     (setq published t)
                     (when committed (setf (niwa-session-publication session) '(:head "new-head")))
                     (error "Injected publication failure")))
                  ((symbol-function 'niwa-request-end) (lambda () (setq niwa--current-request nil)))
                  ((symbol-function 'niwa-diagnostic-message) (lambda (&rest _) nil)))
          (niwa-gptel-retry--external (current-buffer) failure request "failed"))
        (should published)
        (should (eq deleted (not committed)))
        (should-not niwa--current-request)
        (if committed
            (progn
              (should (equal "new" (plist-get (cdar (niwa-session-external-conversations session)) :id)))
              (should-not niwa-gptel-retry--failure)
              (should-not (eq mentions (niwa-session-mentions-shown session))))
          (should (equal previous (niwa-session-external-conversations session)))
          (should (eq mentions (niwa-session-mentions-shown session)))
          (should (eq hashes (niwa-session-workspace-instruction-hashes session)))
          (should-not (niwa-session-pending-reminders session))
          (should (eq failure niwa-gptel-retry--failure)))))))

