(defmacro niwa-failed-retry-test--drain ()
  "Drain the provider and the deferred root terminal transaction."
  '(progn
     (niwa-retry-test--drain-native)
     (let ((deadline (+ (float-time) 10)))
       (while (and (< (float-time) deadline)
                   (buffer-local-value 'niwa--current-request data-buf))
         (accept-process-output nil 0.01)
         (when-let* ((entry (pop scheduled)))
           (cancel-timer (car entry))
           (apply (nth 1 entry) (nth 2 entry))))
       (should (< (float-time) deadline)))))

(defmacro niwa-failed-retry-test--with-root (responses &rest body)
  "Run BODY with HTTP RESPONSES and production root settlement."
  (declare (indent 1) (debug t))
  `(niwa-retry-test--with-http ,responses
     (let* ((directory (make-temp-file "niwa-failed-retry-" t))
            (session (test-niwa-session-persistence--leased-session
                      directory :turn-count 0 :current-segment 1))
            (niwa-gptel-retry-max-retries 0))
       (unwind-protect
           (progn
             (setf (niwa-session-root-buffer session) data-buf
                   (niwa-request-session request) session
                   (niwa-request-turn request) 1
                   (niwa-request-file-snapshots request) (make-hash-table :test #'equal)
                   (niwa-request-started-at request) (current-time))
             (with-current-buffer data-buf
               (org-mode)
               (gptel-mode 1)
               (setq-local niwa--session session)
               (setq-local niwa--current-request request)
               (setq-local gptel-backend backend)
               (setq-local gptel-model 'test-model)
               (niwa--insert-user-turn "Original prompt"))
             (plist-put (gptel-fsm-info fsm) :position
                        (with-current-buffer data-buf (copy-marker (point-max))))
             (plist-put (gptel-fsm-info fsm) :niwa-request request)
             (plist-put (gptel-fsm-info fsm) :niwa-request-id (niwa-request-id request))
             (setf (alist-get 'ERRS (gptel-fsm-handlers fsm))
                   (list (lambda (machine) (niwa--fail-turn machine 'error)))
                   (alist-get 'DONE (gptel-fsm-handlers fsm))
                   (list #'niwa--complete-turn))
             ,@body)
         (when (buffer-live-p data-buf)
           (with-current-buffer data-buf
             (niwa-request-end)
             (set-buffer-modified-p nil)))
         (niwa-session-persistence-lock-release directory session)
         (niwa-workspace-clear-registry)
         (delete-directory directory t)))))

(ert-deftest niwa-gptel-retry-failed-turn/replays-payload-and-keeps-disclosure ()
  (niwa-failed-retry-test--with-root
      (list niwa-retry-test--failure niwa-retry-test--success)
    (gptel--fsm-transition fsm)
    (niwa-failed-retry-test--drain)
    (should-not (buffer-local-value 'niwa--current-request data-buf))
    (let ((id (niwa-gptel-retry-available-p data-buf)))
      (should (equal (niwa-request-id request) id))
      (should-not (niwa-gptel-retry-available-p data-buf "stale"))
      (should-error (niwa-gptel-retry-failed-turn data-buf "stale") :type 'user-error)
      (should (stringp (niwa-gptel-retry-failed-turn data-buf id)))
      (setq fsm (niwa-request-fsm (buffer-local-value 'niwa--current-request data-buf)))
      (should-not (niwa-gptel-retry-available-p data-buf id))
      (should-error (niwa-gptel-retry-failed-turn data-buf id) :type 'user-error)
      (niwa-failed-retry-test--drain)
      (should (= 2 (length requests)))
      (should (equal (car requests) (cadr requests)))
      (should (= 1 waits))
      (should (= 1 (niwa-session-turn-count session)))
      (let* ((prompts (cdr (assoc 1 (niwa-session-prompt-index session))))
             (points (niwa-session-artifacts-fork-point-spans data-buf)))
        (ert-info ((format "Transcript: %S Index: %S" (with-current-buffer data-buf (buffer-string))
                           (niwa-session-prompt-index session)))
          (should (= 1 (length prompts))))
        (should (= 1 (plist-get (car prompts) :cum-turn)))
        (should (= 1 (length points)))
        (should (= 1 (plist-get (car points) :cum-turn))))
      (should-not (buffer-local-value 'niwa--current-request data-buf))
      (with-current-buffer data-buf
        (should (string-search "Recovered answer" (buffer-string)))
        (should-not (string-search "Abandoned output" (buffer-string)))
        (should (string-search "Model at capacity" (buffer-string)))
        (should (string-search "server_error" (buffer-string)))
        (niwa--insert-local-user-turn "Next ordinary prompt")
        (let ((next (niwa-request-begin session)))
          (setq fsm (gptel-make-fsm
                     :info (list :buffer data-buf :backend backend :model 'test-model :stream t
                                 :position (copy-marker (point-max))
                                 :data '(:model "test-model" :input [] :stream t)
                                 :niwa-request next :niwa-request-id (niwa-request-id next)
                                 :callback #'gptel-curl--stream-insert-response)
                     :handlers `((WAIT ,(lambda (machine) (niwa-gptel-retry-dispatch machine)))
                                 (DONE niwa--complete-turn)
                                 (ERRS ,(lambda (machine) (niwa--fail-turn machine 'error))))))
          (setf (niwa-request-fsm next) fsm)
          (gptel--fsm-transition fsm)
          (niwa-failed-retry-test--drain)))
      (should (= 2 (niwa-session-turn-count session)))
      (should (equal '(1 2) (mapcar (lambda (prompt) (plist-get prompt :cum-turn))
                                   (cdr (assoc 1 (niwa-session-prompt-index session))))))
      (should (equal '(1 2) (mapcar (lambda (point) (plist-get point :cum-turn))
                                   (niwa-session-artifacts-fork-point-spans data-buf)))))))

(ert-deftest niwa-gptel-retry-failed-turn/completed-tools-run-once ()
  (let ((tool-runs 0)
        (response (concat "event: response.output_item.done\n"
                          "data: {\"item\":{\"type\":\"function_call\",\"call_id\":\"side-effect\",\"name\":\"Once\",\"arguments\":\"{}\"}}\n\n"
                          "event: response.completed\n"
                          "data: {\"response\":{\"status\":\"completed\"}}\n\n")))
    (niwa-failed-retry-test--with-root
        (list response niwa-retry-test--failure niwa-retry-test--success)
      (let ((path (file-name-concat directory "effect.txt")))
      (write-region "before" nil path nil 'silent)
      (plist-put (gptel-fsm-info fsm) :tools
                 (list (gptel-make-tool :name "Once" :description "Count effects"
                                        :function (lambda ()
                                                    (cl-incf tool-runs)
                                                    (puthash path "before" (niwa-request-file-snapshots
                                                                           niwa--current-request))
                                                    (write-region "after" nil path nil 'silent)
                                                    "Done"))))
      (gptel--fsm-transition fsm)
      (niwa-failed-retry-test--drain)
      (should (= 1 tool-runs))
      (niwa-gptel-retry-failed-turn data-buf (niwa-gptel-retry-available-p data-buf))
      (setq fsm (niwa-request-fsm (buffer-local-value 'niwa--current-request data-buf)))
      (niwa-failed-retry-test--drain)
      (should (= 1 tool-runs))
      (should (= 3 (length requests)))
      (should (equal (car requests) (cadr requests)))
      (should (string-search "function_call_output" (car requests)))
      (should (assoc 1 (niwa-session-file-snapshots session)))
      (with-current-buffer data-buf
        (let ((target (copy-tree (cdar (niwa-session-rewind--prompt-candidates session)))))
          (cl-letf (((symbol-function 'display-buffer) #'ignore)
                    ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                    ((symbol-function 'niwa--run-session-start-hooks) #'ignore))
            (should (niwa-session-rewind-rewind data-buf target 'before))))
        (should (= 0 (niwa-session-turn-count session))))
      (should (equal "before" (niwa-session-artifacts--file-text path)))
      (when-let* ((impact (get-buffer "*niwa-rewind-impact*"))) (kill-buffer impact))))))

(ert-deftest niwa-gptel-retry-failed-turn/preserves-unbounded-provider-error ()
  (let* ((message (concat "Model at capacity " (make-string 1500 ?x) " original-message-tail"))
         (failure (string-replace
                   "\"message\":\"Model at capacity\""
                   (format "\"message\":\"%s\",\"detail\":{\"marker\":\"original-payload-tail\"}" message)
                   niwa-retry-test--failure)))
    (niwa-failed-retry-test--with-root (list failure niwa-retry-test--success)
      (gptel--fsm-transition fsm)
      (niwa-failed-retry-test--drain)
      (niwa-gptel-retry-failed-turn data-buf (niwa-gptel-retry-available-p data-buf))
      (setq fsm (niwa-request-fsm (buffer-local-value 'niwa--current-request data-buf)))
      (niwa-failed-retry-test--drain)
      (with-current-buffer data-buf
        (should (string-search message (buffer-string)))
        (should (string-search "original-payload-tail" (buffer-string)))
        (should-not (string-search "Abandoned output" (buffer-string)))))))

(ert-deftest niwa-gptel-retry-failed-turn/edits-retire-replay ()
  (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
    (gptel--fsm-transition fsm)
    (niwa-failed-retry-test--drain)
    (let ((id (niwa-gptel-retry-available-p data-buf)))
      (should id)
      (with-current-buffer data-buf
        (goto-char (point-max))
        (insert "Changed prompt"))
      (should-not (niwa-gptel-retry-available-p data-buf id))
      (should-error (niwa-gptel-retry-failed-turn data-buf id) :type 'user-error))))

(ert-deftest niwa-gptel-retry-failed-turn/header-uses-exact-identity ()
  (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
    (gptel--fsm-transition fsm)
    (niwa-failed-retry-test--drain)
    (let* ((id (niwa-gptel-retry-available-p data-buf))
           (rendering (list :vtype 'request-failure :header "Provider failed"
                            :failure-buffer data-buf :failure-id id))
           (header (niwa-view--rendering-header-line rendering))
           (position (string-search "[Retry]" header)))
      (should position)
      (should (functionp (get-text-property position 'niwa-view-zone-activate header)))
      (plist-put rendering :failure-id "stale")
      (should-not (string-search "[Retry]" (niwa-view--rendering-header-line rendering))))))

(ert-deftest niwa-gptel-retry-failed-turn/refuses-changed-turn-or-queued-input ()
  (dolist (change '(committed queued rewritten))
    (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
      (gptel--fsm-transition fsm)
      (niwa-failed-retry-test--drain)
      (let ((id (niwa-gptel-retry-available-p data-buf)))
        (should id)
        (pcase change
          ('committed (cl-incf (niwa-session-turn-count session)))
          ('queued (setf (niwa-session-pending-follow-ups session) '((:input "New prompt"))))
          ('rewritten (with-current-buffer data-buf
                        (let ((inhibit-modification-hooks t))
                          (goto-char (point-max)) (insert "Rewritten history")))))
        (should-not (niwa-gptel-retry-available-p data-buf id))
        (should-error (niwa-gptel-retry-failed-turn data-buf id) :type 'user-error)))))

(ert-deftest niwa-gptel-retry-failed-turn/refuses-pending-input-without-consuming-it ()
  (dolist (category '(steering follow-up))
    (dolist (state '(pending failed-turn))
      (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
        (let ((entry (list :input "Queued input" :state state)))
          (niwa-session-set-pending-inputs session category (list entry))
          (gptel--fsm-transition fsm)
          (niwa-failed-retry-test--drain)
          (should-not (niwa-gptel-retry-available-p data-buf))
          (should (string-search
                   "Resolve queued input first"
                   (error-message-string
                    (should-error (niwa-gptel-retry-failed-turn data-buf (niwa-request-id request))
                                  :type 'user-error))))
          (should (eq entry (car (niwa-session-pending-inputs session category))))
          (should-not (plist-get entry :request-id))
          (niwa-session-set-pending-inputs session category nil)
          (should (niwa-gptel-retry-available-p data-buf)))))))

(ert-deftest niwa-gptel-retry-failed-turn/refuses-input-queued-during-admission ()
  (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
    (gptel--fsm-transition fsm)
    (niwa-failed-retry-test--drain)
    (let ((id (niwa-gptel-retry-available-p data-buf))
          (ready (symbol-function 'niwa-request-assert-target-ready))
          (entry (list :input "Arrived during readiness" :state 'pending)))
      (cl-letf (((symbol-function 'niwa-request-assert-target-ready)
                 (lambda (owner)
                   (funcall ready owner)
                   (niwa-session-set-pending-inputs owner 'steering (list entry)))))
        (should-error (niwa-gptel-retry-failed-turn data-buf id) :type 'user-error))
      (should-not (buffer-local-value 'niwa--current-request data-buf))
      (should (eq entry (car (niwa-session-pending-steering session))))
      (should-not (plist-get entry :request-id)))))

(ert-deftest niwa-gptel-retry-failed-turn/refreshes-settled-failure-header ()
  (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
    (let ((view (generate-new-buffer " *retry-header*")) refreshed)
      (unwind-protect
          (progn
            (with-current-buffer data-buf (setq-local niwa--view-buffer view))
            (cl-letf (((symbol-function 'niwa-view-render-refresh-latest-turn)
                       (lambda (buffer)
                         (when-let* ((id (niwa-gptel-retry-available-p buffer)))
                           (push (niwa-view--rendering-header-line
                                  (list :vtype 'request-failure :header "Failed"
                                        :failure-buffer buffer :failure-id id)) refreshed)))))
              (gptel--fsm-transition fsm)
              (niwa-failed-retry-test--drain))
            (should (seq-some (lambda (header) (string-search "[Retry]" header)) refreshed)))
        (with-current-buffer data-buf (setq-local niwa--view-buffer nil))
        (kill-buffer view)))))

(ert-deftest niwa-gptel-retry-failed-turn/queue-changes-refresh-header-only-when-idle ()
  (dolist (category '(steering follow-up))
    (niwa-failed-retry-test--with-root (list niwa-retry-test--failure)
      (let ((view (generate-new-buffer " *retry-queue-header*")) headers)
        (unwind-protect
            (progn
              (with-current-buffer data-buf (setq-local niwa--view-buffer view))
              (cl-letf (((symbol-function 'niwa-view-render-refresh-latest-turn)
                         (lambda (buffer)
                           (push (niwa-view--rendering-header-line
                                  (list :vtype 'request-failure :header "Failed"
                                        :failure-buffer buffer :failure-id (niwa-request-id request)))
                                 headers))))
                (gptel--fsm-transition fsm)
                (niwa-failed-retry-test--drain)
                (should (string-search "[Retry]" (car headers)))
                (niwa-pending-inputs--set-queues session category (list (list :input "Queued")))
                (should-not (string-search "[Retry]" (car headers)))
                (setq headers nil)
                (niwa-pending-inputs--set-queues session category (list (list :input "Changed queued input")))
                (should-not headers)
                (niwa-pending-inputs--set-queues session category nil)
                (should (string-search "[Retry]" (car headers)))
                (setq headers nil)
                (with-current-buffer data-buf (setq niwa--current-request request))
                (niwa-pending-inputs--set-queues session category (list (list :input "While streaming")))
                (should-not headers)
                (with-current-buffer data-buf (setq niwa--current-request nil))
                (cl-incf (niwa-session-turn-count session))
                (niwa-pending-inputs--set-queues session category nil)
                (should-not headers)))
          (with-current-buffer data-buf (setq-local niwa--view-buffer nil))
          (kill-buffer view))))))

(ert-deftest niwa-gptel-retry-failed-turn/admission-publishes-same-turn ()
  (niwa-failed-retry-test--with-root
      (list niwa-retry-test--failure niwa-retry-test--success)
    (gptel--fsm-transition fsm)
    (niwa-failed-retry-test--drain)
    (let ((start (symbol-function 'niwa-session-persistence-start-checkpoints)) published-turn)
      (let ((id (niwa-gptel-retry-available-p data-buf)) failed-admission)
        (cl-letf (((symbol-function 'niwa-session-persistence-start-checkpoints)
                   (lambda ()
                     (setq failed-admission niwa--current-request)
                     (error "Injected checkpoint startup failure"))))
          (should-error (niwa-gptel-retry-failed-turn data-buf id)))
        (should (niwa-request-cancelled-p failed-admission))
        (should-not (buffer-local-value 'niwa--current-request data-buf))
        (should (equal id (niwa-gptel-retry-available-p data-buf))))
      (cl-letf (((symbol-function 'niwa-session-persistence-start-checkpoints)
                 (lambda ()
                   (setq published-turn (niwa-request-turn niwa--current-request))
                   (funcall start))))
        (niwa-gptel-retry-failed-turn data-buf (niwa-gptel-retry-available-p data-buf)))
      (should (= 1 published-turn)))
    (setq fsm (niwa-request-fsm (buffer-local-value 'niwa--current-request data-buf)))
    (niwa-failed-retry-test--drain)))

(ert-deftest niwa-gptel-retry-failed-turn/commit-fence-refuses-moved-count ()
