                (mevedel-memory-list-switch tab)
                (when (eq tab 'memories) (mevedel-test-memory-list-await-memories))
                (setq left-id (plist-get (car (mevedel-cockpit-surface-items)) :id)
                      right-id (plist-get (cadr (mevedel-cockpit-surface-items)) :id))
                (should left-id) (should right-id)
                (mevedel-cockpit-goto-id left-id))
              (with-selected-window right (mevedel-cockpit-goto-id right-id))
              (with-selected-window left
                (call-interactively (key-binding (kbd "g")))
                (mevedel-memory-list-switch (if (eq tab 'history) 'candidates 'history))
                (mevedel-memory-list-switch tab))
              ;; Memories remains usable while history is loading. A newer
              ;; window selection must beat the one saved before refresh.
              (when (eq tab 'memories)
                (with-selected-window right (mevedel-cockpit-goto-id left-id))
                (setq right-id left-id))
              (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
              (should (eq chat (selected-window)))
              (with-current-buffer view
                (should (equal draft (mevedel-view--input-text)))
                (should (= (point) (+ (mevedel-view--input-start) 4))))
              (with-selected-window left (should (equal left-id (tabulated-list-get-id))))
              (with-selected-window right (should (equal right-id (tabulated-list-get-id))))))
          (with-selected-window right
            (setq selected (mevedel-cockpit-surface-selected)
                  first (car (mevedel-cockpit-surface-items)))
            (should-not (equal (plist-get selected :id) (plist-get first :id)))
            (call-interactively (key-binding (kbd "r"))))
          (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
          (should (eq 'rejected (plist-get (mevedel-memory-decision-status workspace (plist-get selected :id)) :status)))
          (should-not (mevedel-memory-decision-status workspace (plist-get first :id)))
          (should (eq chat (selected-window)))
          (with-current-buffer view
            (should (equal draft (mevedel-view--input-text)))
            (should (= (point) (+ (mevedel-view--input-start) 4)))))
      (when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
      (when (buffer-live-p view) (kill-buffer view))
      (when (buffer-live-p data) (kill-buffer data)))))

