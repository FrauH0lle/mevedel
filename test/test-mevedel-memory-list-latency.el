;;; test-mevedel-memory-list-latency.el --- Cockpit latency regressions -*- lexical-binding: t -*-

;;; Commentary:
;; Exercise native cockpit entry points against isolated accepted history.

;;; Code:

(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "helpers"))
(require 'memory-history-fixtures
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "memory-history-fixtures"))
(require 'mevedel-memory-list)
(require 'mevedel-memory-library)
(require 'mevedel-memory-store)
(require 'mevedel-memory-write)
(require 'mevedel-journal-worker)
(require 'mevedel-session-control-fs)
(require 'mevedel-view)
(require 'mevedel-view-composer)
(require 'mevedel-memory-list-test-support
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "mevedel-memory-list-test-support"))

(mevedel-deftest mevedel-memory-list-latency
    (:vars* ((root (make-temp-file "mevedel-cockpit-latency-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (memory (file-name-concat root "memory"))
             (mevedel-memory-dirs (list memory))
             (batches (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 4 1))
             (items (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 8 2))
             (context (mevedel-cockpit-workspace-context workspace))
             (mevedel-memory-decision--inhibit-recovery nil)
             (mevedel-journal-cleanup--inhibit-scheduling t))
     :after-each ((when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
                  (mevedel-memory-decision-stop-recovery)
                  (delete-directory root t)))
  (progn
    (make-directory memory)
    (write-region "A current topic.\n" nil (file-name-concat memory "topic.md") nil 'silent)
    (mevedel-workspace-identity-ensure root)
    (mevedel-test-memory-history-create workspace batches items
                                        (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 8192 512))
    ,test)
  (test)
  :doc "measure native open and all three tabs against authentic applied-note history"
  (let ((read (symbol-function 'mevedel-memory-store-accepted)) samples sources (calls 0))
    (cl-letf (((symbol-function 'mevedel-memory-store-accepted)
               (lambda (&rest args) (cl-incf calls) (apply read args))))
      (save-window-excursion
        (dotimes (_ (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 3 1))
          ;; Measure the complete scan-backed open, not a counts-chosen Memories view.
          (setf (mevedel-workspace-memory-observation workspace) nil)
          (let* ((start (float-time)) (last start) (gap 0) (ticks 0)
                 (collections gcs-done) (gc-seconds gc-elapsed)
                 (timer (run-at-time .01 .01
                                     (lambda ()
                                       (let ((now (float-time)))
                                         (setq gap (max gap (- now last)) last now)
                                         (cl-incf ticks))))))
            (unwind-protect
                (progn
                  (mevedel-memory-list-open context)
                  (push (list 'open (- (float-time) start)) samples)
                  (with-current-buffer "*mevedel memory*"
                    ;; Without prior counts, opening must scan to choose a view.
                    (let* ((job (or mevedel-memory-list--job (ert-fail "Opening did not start a history scan")))
                           (library (cadr (member "-l" (process-command (plist-get job :worker))))))
                      (should (equal (locate-library "mevedel-memory-list") library))
                      (when-let* ((snapshot (getenv "MEVEDEL_COCKPIT_SNAPSHOT")))
                        (dolist (source (list library (symbol-file 'mevedel-memory-list-open)
                                              (symbol-file 'gptel-request)))
                          (should (file-in-directory-p source snapshot))))
                      (push (list :editor (symbol-file 'mevedel-memory-list-open) :child library
                                  :gptel (symbol-file 'gptel-request)) sources))
                    (with-timeout (45 (ert-fail "Recovery did not admit the display scan"))
                      (while mevedel-memory-list--recovery (accept-process-output nil .01)))
                    (push (list 'recovery-ready (- (float-time) start)) samples))
                  (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
                  (push (list 'ready (- (float-time) start)) samples)
                  (push (list 'max-timer-gap gap) samples)
                  (push (list 'max-timer-lateness (max 0 (- gap .01))) samples)
                  (push (list 'editor-gc-count (- gcs-done collections)) samples)
                  (push (list 'editor-gc-seconds (- gc-elapsed gc-seconds)) samples)
                  (should (> ticks 0)))
              (cancel-timer timer)))
          (with-current-buffer "*mevedel memory*"
            (dolist (view '(candidates memories history))
              (let ((start (float-time)))
                (mevedel-memory-list-switch view)
                (push (list view (- (float-time) start)) samples)))
            ;; Recovery completion may have discarded history while Memories showed.
            (mevedel-test-memory-list-await)
            (should (= (* batches items) (length (mevedel-cockpit-surface-items))))))))
    (should (= (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 3 1) (length sources)))
    (when (getenv "MEVEDEL_COCKPIT_BENCHMARK")
      (princ (format "\nCOCKPIT-MEASURE %S accepted-calls=%d\nCOCKPIT-SOURCES %S\n"
                     (nreverse samples) calls sources))
      (princ (format "COCKPIT-CONFIG %S\n"
                     (list :emacs (emacs-version) :scope 'isolated-interpreted-batch
                           :timer-period .01 :gc-cons-threshold gc-cons-threshold
                           :gc-cons-percentage gc-cons-percentage :passes batches :notes (* batches items)
                           :bytes-per-note 8192))))))

(mevedel-deftest mevedel-memory-list-scan-batches
    (:vars* ((root (make-temp-file "mevedel-scan-batches-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (mevedel-memory-dirs nil)
             (mevedel-journal-cleanup--inhibit-scheduling t))
     :after-each ((delete-directory root t)))
  (progn (mevedel-workspace-identity-ensure root) ,test)
  (test)
  :doc "control programs grow by pass and bounded batches, not by decision row"
  (let ((run (symbol-function 'mevedel-session-control-fs--run-program)) samples)
    (dolist (items '(2 8))
      (mevedel-test-memory-history-create workspace 3 items 64)
      (let ((calls 0))
        (cl-letf (((symbol-function 'mevedel-session-control-fs--run-program)
                   (lambda (&rest args) (cl-incf calls) (apply run args))))
          (let ((rows (mevedel-memory-list--collect (mevedel-cockpit-workspace-context workspace))))
            (should (= (if (= items 2) 6 30) (length rows)))
            (should (cl-every (lambda (row) (eq 'applied (plist-get row :status))) rows))))
        (push calls samples)))
    ;; The second scan adds three passes with eight rows each.  Row-at-a-time
    ;; IO exceeds this budget even before accounting for the original passes.
    (should (< (- (car samples) (cadr samples)) 45)))
  :doc "invalid local bundles remain unavailable in the actual child reader"
  (let* ((bundles (mevedel-test-memory-history-create workspace 2 1 64))
         (pass (plist-get (plist-get (car bundles) :prepared) :id))
         (request (file-name-concat root "request.el"))
         (reply (file-name-concat root "reply.el")))
    (write-region "invalid" nil (file-name-concat (mevedel-memory-store--directory workspace pass) "accepted.el") nil 'silent)
    (mevedel-journal-worker--write request (list :root root :client (mevedel-workspace-identity-client) :roots nil))
    (mevedel-memory-list--run request reply)
    (let* ((result (mevedel-journal-worker--read reply)) (rows (plist-get result :rows)))
      (should-not (plist-get result :native))
      (should-not (plist-get result :error))
      (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows)))
      (should (= 2 (seq-count (lambda (row) (eq 'unavailable (plist-get row :status))) rows)))))
  :doc "retirement after proof authentication cannot leave an applied row"
  (progn
    (mevedel-test-memory-history-create workspace 1 2 64)
    (let ((run (symbol-function 'mevedel-session-control-fs-run-program)) raced)
    (cl-letf (((symbol-function 'mevedel-session-control-fs-run-program)
               (lambda (operations &rest args)
                 (when (eq (plist-get (car operations) :op) 'absent)
                   (setq raced t)
                   (make-directory (file-name-directory (plist-get (car operations) :path)) t)
                   (write-region "retired" nil (plist-get (car operations) :path) nil 'silent))
                 (apply run operations args))))
      (let ((rows (mevedel-memory-list--collect (mevedel-cockpit-workspace-context workspace))))
        (should raced)
        (should (= 3 (length rows)))
        (should (cl-every (lambda (row) (eq 'unavailable (plist-get row :status))) rows))))))
  :doc "a corrupt decision does not contaminate a healthy pass in the same batch"
  (progn
    (mevedel-test-memory-history-create workspace 2 1 64)
    (write-region "invalid" nil (car (mevedel-session-control-fs-list-directory
                                    (mevedel-memory-decision--directory workspace) mevedel-memory-write-intent-file-regexp)) nil 'silent)
  (let ((rows (mevedel-memory-list--collect (mevedel-cockpit-workspace-context workspace))))
    (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows)))
    (should (seq-some (lambda (row) (eq 'unavailable (plist-get row :status))) rows))))
  :doc "a write disappearing after grouping does not abort independent passes"
  (progn
    (mevedel-test-memory-history-create workspace 2 1 64)
    (let ((group (symbol-function 'mevedel-memory-write--groups)) removed)
    (cl-letf (((symbol-function 'mevedel-memory-write--groups)
               (lambda (&rest args)
                 (let ((groups (apply group args)))
                   (maphash (lambda (pass ids)
                              (when (and pass (not removed))
                                (setq removed t)
                                (delete-file (file-name-concat (mevedel-memory-write--directory workspace)
                                                               (concat (car ids) ".el"))))) groups)
                   groups))))
      (let ((rows (mevedel-memory-list--collect (mevedel-cockpit-workspace-context workspace))))
        (should removed)
        (should (= 1 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) rows))))))))

(mevedel-deftest mevedel-memory-list-reuse
    (:vars* ((root (make-temp-file "mevedel-history-reuse-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (mevedel-memory-dirs nil)
             (mevedel-journal-cleanup--inhibit-scheduling t)
             (request (file-name-concat root "request.el"))
             (reply (file-name-concat root "reply.el")))
     :after-each ((delete-directory root t)))
  (progn
    (mevedel-workspace-identity-ensure root)
    (mevedel-test-memory-history-create workspace 2 2 64)
    (cl-labels ((scan (&optional previous)
                  (mevedel-journal-worker--write
                   request (list :root root :client (mevedel-workspace-identity-client)
                                 :roots (mevedel-system--memory-roots workspace) :previous previous))
                  (let ((run (symbol-function 'mevedel-session-control-fs--run-program)) (calls 0))
                    (cl-letf (((symbol-function 'mevedel-session-control-fs--run-program)
                               (lambda (&rest args) (cl-incf calls) (apply run args))))
                      (mevedel-memory-list--run request reply))
                    (let ((result (mevedel-journal-worker--read reply)))
                      (should-not (plist-get result :error))
                      (cons result calls))))
                (topic ()
                  (let* ((memory (file-name-concat root "memory"))
                         (mevedel-memory-dirs (list memory)))
                    (make-directory memory)
                    (let* ((scope (mevedel-memory-scope-capture workspace))
                           (claim (mevedel-journal-claim-acquire (mevedel-memory-store--claim-directory workspace) 180)))
                      (unwind-protect
                          (let* ((prepared (mevedel-memory-store-prepare workspace claim scope nil ""))
                                 (accepted (mevedel-memory-store-accept-proposals
                                            workspace prepared
                                            (list :proposals (list (list :action 'promote :root (caar (plist-get scope :roots))
                                                                        :file "guide.md" :type "project" :title "Guide"
                                                                        :hook "Context" :reason "New evidence" :body "Guide.\n")))
                                            nil "test:model" nil))
                                 (pass (plist-get prepared :id)) (id (plist-get (car (plist-get accepted :proposals)) :id)))
                            (mevedel-memory-store-publish workspace pass)
                            (should (eq 'applied (plist-get (mevedel-memory-decision-apply workspace pass id) :status)))
                            (cons pass id))
                        (mevedel-journal-claim-settle claim 'cancelled ""))))))
      ,test))
  (test)
  :doc "unchanged child requests return identical rows with far fewer control programs"
  (dolist (mevedel-memory-dirs (list nil (list (file-name-concat root "z-memory") (file-name-concat root "a-memory"))))
    (dolist (directory mevedel-memory-dirs) (make-directory directory))
    (let* ((first (scan)) (second (scan (car first))))
      (should (= 4 (length (plist-get (car second) :rows))))
      (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))
      (should (< (cdr second) (/ (cdr first) 3)))))
  :doc "pending proposals are checked again when target contents change outside history"
  (progn
    (mevedel-test-memory-history-create workspace 1 1 64 t)
    (let* ((first (scan))
           (pending (seq-find (lambda (row) (eq 'pending (plist-get row :status))) (plist-get (car first) :rows))))
      (should (eq 'fresh (plist-get pending :check)))
      (write-region "changed" nil (file-name-concat root ".mevedel/shared/note-0-0.md") nil 'silent)
      (let* ((second (scan (car first)))
             (row (seq-find (lambda (row) (equal (plist-get row :id) (plist-get pending :id)))
                            (plist-get (car second) :rows))))
        (should (plist-get (car second) :fingerprint))
        (should (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
        (should (eq 'stale (plist-get row :check)))
        (should (= 4 (seq-count (lambda (row) (eq 'applied (plist-get row :status))) (plist-get (car second) :rows)))))))
  :doc "history changing during reuse falls back to a full scan on the same open"
  (let* ((first (scan))
         (run (symbol-function 'mevedel-session-control-fs--run-program))
         (pass (plist-get (car (plist-get (car first) :rows)) :pass))
         (marker (file-name-concat root ".mevedel/state/journal/retired-passes" pass))
         (checks 0) raced second)
    (cl-letf (((symbol-function 'mevedel-session-control-fs--run-program)
               (lambda (operations &rest args)
                 (when (and (eq 'stat-tree (plist-get (car operations) :op)) (= 2 (cl-incf checks)))
                   (setq raced t)
                   (make-directory (file-name-directory marker) t)
                   (write-region "retired" nil marker nil 'silent))
                 (apply run operations args))))
      (setq second (scan (car first))))
    (should raced)
    (should (= 2 (length (plist-get (car second) :rows))))
    (should-not (member pass (mapcar (lambda (row) (plist-get row :pass)) (plist-get (car second) :rows))))
    (let ((third (scan (car second))))
      (should (equal (plist-get (car second) :rows) (plist-get (car third) :rows)))))
  :doc "a new decision invalidates reuse and mixed passes have no duplicate rows"
  (let* ((accepted (car (mevedel-test-memory-history-create workspace 1 2 64 t)))
         (pass (plist-get (plist-get accepted :prepared) :id))
         (id (plist-get (car (plist-get accepted :proposals)) :id))
         (first (scan)))
    (should (plist-get (car first) :fingerprint))
    (mevedel-memory-decision-reject workspace pass id)
    (let* ((second (scan (car first))) (third (scan (car second)))
           (rows (plist-get (car third) :rows)))
      (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (= 6 (length rows)))
      (should (= 1 (seq-count (lambda (row) (eq 'rejected (plist-get row :status))) rows)))
      (should (= 1 (seq-count (lambda (row) (eq 'pending (plist-get row :status))) rows)))))
  :doc "retirement, expiry, write evidence and marker membership changes force full scans"
  (dolist (kind '(retirement expiry write marker))
    (let* ((first (scan)) (pass (plist-get (car (plist-get (car first) :rows)) :pass))
           (warm (scan (car first))) path)
      (should (plist-get (car first) :fingerprint))
      (pcase kind
        ('retirement (setq path (file-name-concat root ".mevedel/state/journal/retired-passes" pass)))
        ('expiry (setq path (file-name-concat (mevedel-memory-store--directory workspace pass) "accepted.el")))
        ('write (setq path (car (mevedel-session-control-fs-list-directory
                                (mevedel-memory-write--directory workspace) mevedel-memory-write-intent-file-regexp))))
        ('marker (setq path (file-name-concat (car (plist-get (car first) :markers)) "new.pin"))))
      (let ((before (when (file-exists-p path) (mevedel-session-control-fs-read-file path))))
        (make-directory (file-name-directory path) t)
        (unwind-protect
            (progn
              (if (eq kind 'expiry) (delete-file path) (write-region "changed" nil path nil 'silent))
              (let ((second (scan (car first))))
                (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
                (should (> (cdr second) (* 3 (cdr warm))))
                (should (equal (plist-get (car second) :rows) (plist-get (car (scan)) :rows)))))
          (if before (write-region before nil path nil 'silent) (delete-file path))))))
  :doc "reversals replace applied rows and historical marker roots need a covered baseline"
  (let* ((item (topic)) (first (scan)) (baseline (scan (car first))))
    (should-not (plist-get (car first) :fingerprint))
    (should (plist-get (car baseline) :fingerprint))
    (should (eq 'reversed (plist-get (mevedel-memory-decision-reverse workspace (car item) (cdr item)) :status)))
    (let* ((second (scan (car baseline)))
           (row (seq-find (lambda (row) (equal (cdr item) (plist-get row :id))) (plist-get (car second) :rows))))
      (should-not (equal (plist-get (car baseline) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (eq 'reversed (plist-get row :status)))))
  :doc "a newly discovered external marker cannot certify rows read before its creation"
  (let* ((item (topic))
         (intent (plist-get (seq-find (lambda (row) (equal (car item) (plist-get (plist-get row :intent) :pass)))
                                     (mevedel-memory-write--list workspace)) :intent))
         (pin (mevedel-memory-write--pin intent))
         (run (symbol-function 'mevedel-session-control-fs--run-program))
         (checks 0) first)
    (cl-letf (((symbol-function 'mevedel-session-control-fs--run-program)
               (lambda (operations &rest args)
                 (when (and (eq 'stat-tree (plist-get (car operations) :op)) (= 2 (cl-incf checks)))
                   (write-region (plist-get intent :hash) nil pin nil 'silent))
                 (apply run operations args))))
      (setq first (scan)))
    (should (= 2 checks))
    (should-not (plist-get (car first) :fingerprint))
    (let ((second (scan (car first))))
      (should (plist-get (car second) :fingerprint))
      (should (eq 'recovery-required
                  (plist-get (seq-find (lambda (row) (equal (cdr item) (plist-get row :id)))
                                       (plist-get (car second) :rows)) :status)))))
  :doc "configured roots, workspace identity and client identity invalidate unchanged metadata"
  (let* ((first (scan)) (previous (car first)))
    (should (plist-get previous :fingerprint))
    (dolist (position '(0 1 2 3 4))
      (let ((changed (mevedel-memory-library-copy previous)))
        (setf (nth position (plist-get changed :key)) 'other-context)
        (let ((second (scan changed)))
          (should (>= (cdr second) (cdr first)))
          (should (equal (plist-get previous :rows) (plist-get (car second) :rows))))))
    (let ((mevedel-memory-dirs (list (file-name-concat root "another-memory"))))
      (make-directory (car mevedel-memory-dirs))
      (let ((second (scan previous)))
        (should-not (equal (plist-get previous :key) (plist-get (car second) :key)))
        (should (>= (cdr second) (cdr first))))))
  :doc "a configured root replaced by a symlink to another directory forces a full scan"
  (let* ((memory (file-name-concat root "memory"))
         (replacement (file-name-concat root "replacement-memory")))
    (topic)
    ;; Without write markers the replacement leaves the history metadata unchanged.
    (delete-directory (file-name-concat memory ".mevedel/state/memory-write/root/pending"))
    (let* ((mevedel-memory-dirs (list memory))
           (baseline (scan (car (scan)))))
      (should (plist-get (car baseline) :fingerprint))
      (rename-file memory (file-name-concat root "original-memory"))
      (make-directory replacement)
      (make-symbolic-link replacement memory)
      (let ((second (scan (car baseline))))
        (should (memq 'unavailable (mapcar (lambda (row) (plist-get row :status)) (plist-get (car second) :rows))))
        (should (equal (plist-get (car second) :rows) (plist-get (car (scan)) :rows))))))
  :doc "same-size rewrites with restored mtime still invalidate the history observation"
  (let* ((first (scan)) (warm (scan (car first)))
         (pass (plist-get (car (plist-get (car first) :rows)) :pass))
         (path (file-name-concat (mevedel-memory-store--directory workspace pass) "accepted.el"))
         (stamp (file-attribute-modification-time (file-attributes path)))
         (text (mevedel-session-control-fs-read-file path)))
    (sleep-for .02)
    (write-region text nil path nil 'silent)
    (set-file-times path stamp)
    (let ((second (scan (car first))))
      (should (> (cdr second) (* 3 (cdr warm))))
      (should-not (equal (plist-get (car first) :fingerprint) (plist-get (car second) :fingerprint)))
      (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))))
  :doc "failed, unrunnable and unsafe metadata checks fall back to full authentication"
  (let* ((first (scan)) (run (symbol-function 'mevedel-session-control-fs--run-program)))
    (should (plist-get (car first) :fingerprint))
    (dolist (kind '(failed unrunnable symlink))
      (let ((attempts 0) second)
        (pcase kind
          ('failed
           (cl-letf (((symbol-function 'mevedel-session-control-fs--run-program)
                      (lambda (operations &rest args)
                        (if (eq 'stat-tree (plist-get (car operations) :op))
                            (progn (cl-incf attempts) (error "Injected metadata failure"))
                          (apply run operations args)))))
             (setq second (scan (car first))))
           (should (> attempts 0)))
          ('unrunnable
           (let ((mevedel-session-control-fs--program-script
                  (replace-regexp-in-string "    stat-tree)" "    disabled-stat-tree)"
                                            mevedel-session-control-fs--program-script t t)))
             (setq second (scan (car first)))))
          ('symlink
           (make-symbolic-link "missing" (file-name-concat root ".mevedel/state/journal/unsafe"))
           (setq second (scan (car first)))))
        (should-not (plist-get (car second) :fingerprint))
        (should (> (cdr second) 10))
        (should (equal (plist-get (car first) :rows) (plist-get (car second) :rows)))))))

(mevedel-deftest mevedel-memory-list--received
    (:vars* ((root (make-temp-file "mevedel-cockpit-race-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (context (mevedel-cockpit-workspace-context workspace))
             (buffer (generate-new-buffer " *memory-race*"))
             (mevedel-memory-dirs nil)
             (observation (list :at (float-time) :pending 1))
             (rows (list (list :id "pending" :pass "pass" :status 'pending
                               :proposal (list :action 'update :type "project" :title "Pending"))
                         (list :id "done" :pass "pass" :status 'applied
                               :proposal (list :action 'update :type "project" :title "Done"))))
             job)
     :after-each ((when (buffer-live-p buffer) (kill-buffer buffer)) (delete-directory root t)))
  (progn
    (mevedel-workspace-identity-ensure root)
    ;; Some lifecycle cases need no reply fixture.
    (ignore observation rows)
    (with-current-buffer buffer
      (mevedel-memory-list-mode)
      (setq mevedel-cockpit--context context
            job (list :context context :root root :identity (mevedel-workspace-identity-read root)
                      :client (mevedel-workspace-identity-client) :roots nil)
            mevedel-memory-list--job job))
    ,test)
