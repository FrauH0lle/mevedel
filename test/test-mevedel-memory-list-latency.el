;;; test-mevedel-memory-list-latency.el --- Cockpit latency regressions -*- lexical-binding: t -*-

;;; Commentary:
;; Exercise native cockpit entry points against isolated accepted history.

;;; Code:

(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file)) "helpers"))
(require 'memory-history-fixtures
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name)) "memory-history-fixtures"))
(require 'mevedel-memory-list)
(require 'mevedel-memory-library)
(require 'mevedel-memory-store)
(require 'mevedel-journal-worker)
(require 'mevedel-view)
(require 'mevedel-memory-list-test-support
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name)) "mevedel-memory-list-test-support"))

(mevedel-deftest mevedel-memory-list--copy
    (:doc "large display observations copy strings without recursive list-spine depth")
  (let* ((original (make-list 10000 (list :title (copy-sequence "Display"))))
         (copied (mevedel-memory-list--copy original)))
    (should (equal original copied))
    (aset (plist-get (car copied) :title) 0 ?X)
    (should (equal "Display" (plist-get (car original) :title)))
    (should (equal "Display" (plist-get (cadr copied) :title)))))

(mevedel-deftest mevedel-memory-list-latency
    (:vars* ((root (make-temp-file "mevedel-cockpit-latency-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (memory (file-name-concat root "memory"))
             (mevedel-memory-dirs (list memory))
             (batches (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 4 1))
             (items (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 8 2))
             (context (mevedel-cockpit-workspace-context workspace))
             (mevedel-memory-decision--inhibit-recovery nil)
             (mevedel-journal-cleanup--inhibit-scheduling t))
     :after-each ((when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
                  (mevedel-memory-decision-stop-recovery)
                  (delete-directory root t)))
  (progn
    (make-directory memory)
    (write-region "A current topic.\n" nil (file-name-concat memory "topic.md") nil 'silent)
    (mevedel-workspace-identity-ensure root)
    (mevedel-test-memory-history-create workspace batches items
                                        (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 8192 512))
    ,test)
  (test)
  :doc "measure native open and all three tabs against authentic applied-note history"
  (let ((read (symbol-function 'mevedel-memory-store-accepted)) samples sources (calls 0))
    (cl-letf (((symbol-function 'mevedel-memory-store-accepted)
               (lambda (&rest args) (cl-incf calls) (apply read args))))
      (save-window-excursion
        (dotimes (_ (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 3 1))
          (let* ((start (float-time)) (last start) (gap 0) (ticks 0)
                 (collections gcs-done) (gc-seconds gc-elapsed)
                 (timer (run-at-time .01 .01
                                     (lambda ()
                                       (let ((now (float-time)))
                                         (setq gap (max gap (- now last)) last now)
                                         (cl-incf ticks))))))
            (unwind-protect
                (progn
                  (mevedel-memory-list-open context)
                  (push (list 'open (- (float-time) start)) samples)
                  (with-current-buffer "*mevedel memory*"
                    (with-timeout (45 (ert-fail "Recovery did not admit the display scan"))
                      (while mevedel-memory-list--recovery (accept-process-output nil .01)))
                    (push (list 'recovery-ready (- (float-time) start)) samples)
                    (when-let* ((job mevedel-memory-list--job))
                      (let ((library (cadr (member "-l" (process-command (plist-get job :worker))))))
                        (should (equal (locate-library "mevedel-memory-list") library))
                        (when-let* ((snapshot (getenv "MEVEDEL_COCKPIT_SNAPSHOT")))
                          (dolist (source (list library (symbol-file 'mevedel-memory-list-open)
                                                (symbol-file 'gptel-request)))
                            (should (file-in-directory-p source snapshot))))
                        (push (list :editor (symbol-file 'mevedel-memory-list-open) :child library
                                    :gptel (symbol-file 'gptel-request)) sources))))
                  (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
                  (push (list 'ready (- (float-time) start)) samples)
                  (push (list 'max-timer-gap gap) samples)
                  (push (list 'max-timer-lateness (max 0 (- gap .01))) samples)
                  (push (list 'editor-gc-count (- gcs-done collections)) samples)
                  (push (list 'editor-gc-seconds (- gc-elapsed gc-seconds)) samples)
                  (should (> ticks 0)))
              (cancel-timer timer)))
          (with-current-buffer "*mevedel memory*"
            (dolist (view '(candidates memories history))
              (let ((start (float-time)))
                (mevedel-memory-list-switch view)
                (push (list view (- (float-time) start)) samples)))
            (should (= (* batches items) (length (mevedel-cockpit-surface-items))))))))
    (should (= (if (getenv "MEVEDEL_COCKPIT_BENCHMARK") 3 1) (length sources)))
    (when (getenv "MEVEDEL_COCKPIT_BENCHMARK")
      (princ (format "\nCOCKPIT-MEASURE %S accepted-calls=%d\nCOCKPIT-SOURCES %S\n"
                     (nreverse samples) calls sources))
      (princ (format "COCKPIT-CONFIG %S\n"
                     (list :emacs (emacs-version) :scope 'isolated-interpreted-batch
                           :timer-period .01 :gc-cons-threshold gc-cons-threshold
                           :gc-cons-percentage gc-cons-percentage :passes batches :notes (* batches items)
                           :bytes-per-note 8192))))))

(mevedel-deftest mevedel-memory-list--received
    (:vars* ((root (make-temp-file "mevedel-cockpit-race-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (context (mevedel-cockpit-workspace-context workspace))
             (buffer (generate-new-buffer " *memory-race*"))
             (mevedel-memory-dirs nil)
             (observation (list :at (float-time) :pending 1))
             (rows (list (list :id "pending" :pass "pass" :status 'pending
                               :proposal (list :action 'update :type "project" :title "Pending"))
                         (list :id "done" :pass "pass" :status 'applied
                               :proposal (list :action 'update :type "project" :title "Done"))))
             job)
     :after-each ((when (buffer-live-p buffer) (kill-buffer buffer)) (delete-directory root t)))
  (progn
    (mevedel-workspace-identity-ensure root)
    (with-current-buffer buffer
      (mevedel-memory-list-mode)
      (setq mevedel-cockpit--context context
            job (list :context context :root root :identity (mevedel-workspace-identity-read root)
                      :client (mevedel-workspace-identity-client) :roots nil)
            mevedel-memory-list--job job))
    ,test)
  (test)
  :doc "completion renders the newest tab without changing focus, text, or selected row"
  (save-window-excursion
    (with-temp-buffer
      (insert "> draft\nsecond line")
      (switch-to-buffer (current-buffer))
      (let ((origin (current-buffer)) (window (selected-window)))
        (with-current-buffer buffer
          (mevedel-memory-list-history)
          (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
          (should (eq mevedel-memory-list--view 'history))
          (should (equal "done" (tabulated-list-get-id)))
          (should (string-search "Done" (buffer-string)))
          (should-not (string-search "Pending" (buffer-string)))
          (mevedel-memory-list-candidates)
          (should (equal "pending" (tabulated-list-get-id)))
          (mevedel-memory-list-history)
          (should (equal "done" (tabulated-list-get-id))))
        (should (eq window (selected-window)))
        (should (eq origin (window-buffer window)))
        (should (equal "> draft\nsecond line" (buffer-string))))))
  :doc "older and duplicate deliveries cannot overwrite a newer observation"
  (with-current-buffer buffer
    (setq mevedel-memory-list--view 'history)
    (let ((old job))
      (setq job (copy-sequence job) mevedel-memory-list--job job)
      (mevedel-memory-list--received buffer old '(:error "Old failure"))
      (should-not mevedel-memory-list--error)
      (should (eq job mevedel-memory-list--job))
      (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
      (mevedel-memory-list--received buffer job '(:error "Duplicate failure"))
      (should-not mevedel-memory-list--error)
      (should (equal "done" (tabulated-list-get-id)))))
  :doc "a replaced context or killed buffer cannot receive old rows"
  (with-current-buffer buffer
    (setq mevedel-cockpit--context (copy-sequence context))
    (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
    (should-not mevedel-memory-list--snapshot)
    (should-not mevedel-memory-list--job)
    (should (string-search "context changed" mevedel-memory-list--error))
    (kill-buffer buffer)
    (mevedel-memory-list--received buffer job (list :rows rows :observation observation)))
  :doc "a replaced workspace identity is reported rather than presented as a valid scan"
  (with-current-buffer buffer
    (write-region (concat (make-string 64 ?a) "\n") nil (mevedel-workspace-identity--path root) nil 'silent)
    (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
    (should-not mevedel-memory-list--snapshot)
    (should (string-search "context changed" mevedel-memory-list--error)))
  :doc "owner death clears loading and old rows without reviving the dead session"
  (let ((view (generate-new-buffer " *memory-dead-view*"))
        (data (generate-new-buffer " *memory-dead-data*"))
        (session (mevedel-session--create :workspace workspace)))
    (unwind-protect
        (with-current-buffer buffer
          (with-current-buffer data (setq-local mevedel--session session))
          (setq context (list :workspace workspace :session session :view-buffer view :data-buffer data)
                mevedel-cockpit--context context)
          (plist-put job :context context)
          (plist-put job :session session)
          (kill-buffer view)
          (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
          (should-not mevedel-memory-list--job)
          (should-not mevedel-cockpit--items)
          (should (string-search "context changed" mevedel-memory-list--error))
          (should-not (string-search "Loading history" (mevedel-memory-list--header nil context))))
      (when (buffer-live-p view) (kill-buffer view))
      (kill-buffer data)))
  :doc "the recovery watcher immediately cancels an in-flight scan after owner death"
  (let ((view (generate-new-buffer " *memory-watch-view*"))
        (data (generate-new-buffer " *memory-watch-data*"))
        (session (mevedel-session--create :workspace workspace)))
    (unwind-protect
        (with-current-buffer buffer
          (with-current-buffer data (setq-local mevedel--session session))
          (setq context (list :workspace workspace :session session :view-buffer view :data-buffer data)
                mevedel-cockpit--context context)
          (mevedel-memory-list--start context)
          (let ((child (plist-get mevedel-memory-list--job :worker))
                (watcher (list :context context :root root :expires (+ 180 (float-time))
                               :timer (run-at-time 180 nil #'ignore))))
            (setq mevedel-memory-list--recovery watcher)
            (should (process-live-p child))
            (kill-buffer view)
            (mevedel-memory-list--observe-recovery buffer watcher)
            (should-not (process-live-p child))
            (should-not mevedel-memory-list--job)
            (should-not mevedel-memory-list--recovery)
            (should (string-search "owner is unavailable" (mevedel-memory-list--header nil context)))))
      (when (buffer-live-p view) (kill-buffer view))
      (kill-buffer data)))
  :doc "malformed and proof-bearing responses fail visibly rather than claim pending status"
  (with-current-buffer buffer
    (dolist (reply (list nil (list :rows (list '(:id "bad" :status bogus)) :observation observation)
                        (list :rows (list '(:id "bad" :status pending :accepted proof)) :observation observation)))
      (setq mevedel-memory-list--job job mevedel-memory-list--error nil)
      (plist-put job :retired nil)
      (mevedel-memory-list--received buffer job reply)
      (should (string-search "Invalid memory display observation" mevedel-memory-list--error))
      (should (string-search "Scan failed" (mevedel-memory-list--header nil context)))
      (should-not mevedel-cockpit--items)))
  :doc "returned rows and input strings cannot mutate the display snapshot or workspace counters"
  (with-current-buffer buffer
    (setq mevedel-memory-list--view 'candidates)
    (mevedel-memory-list--received buffer job (list :rows rows :observation observation))
    (aset (plist-get (plist-get (car rows) :proposal) :title) 0 ?X)
    (let ((returned (mevedel-memory-list--visible context)))
      (aset (plist-get (plist-get (car returned) :proposal) :title) 0 ?Y))
    (should (equal "Pending" (plist-get (plist-get (car (mevedel-memory-list--visible context)) :proposal) :title)))
    (setf (plist-get observation :pending) 99)
    (should (= 1 (plist-get (mevedel-workspace-memory-observation workspace) :pending)))))

(mevedel-deftest mevedel-memory-list--start
    (:vars* ((root (make-temp-file "mevedel-cockpit-lifecycle-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (context (mevedel-cockpit-workspace-context workspace))
             (buffer (generate-new-buffer " *memory-lifecycle*"))
             (mevedel-memory-dirs nil))
     :after-each ((when (buffer-live-p buffer) (kill-buffer buffer))
                  (when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
                  (delete-directory root t)))
  (progn
    (mevedel-workspace-identity-ensure root)
    (with-current-buffer buffer
      (mevedel-memory-list-mode)
      (setq mevedel-cockpit--context context))
    ,test)
  (test)
  :doc "explicit refresh stops the old child and late completion cannot replace its successor"
  (with-current-buffer buffer
    (mevedel-memory-list--start context)
    (let* ((old mevedel-memory-list--job) (child (plist-get old :worker))
           (directory (plist-get old :directory)))
      (should (process-live-p child))
      (mevedel-memory-list-refresh)
      (should-not (process-live-p child))
      (should-not (file-directory-p directory))
      (should-not (eq old mevedel-memory-list--job))
      (mevedel-memory-list--received buffer old '(:error "Late failure"))
      (mevedel-test-memory-list-await)
      (should-not mevedel-memory-list--error)
      (should-not (mevedel-cockpit-surface-items))))
  :doc "buffer death and mode change stop owned display children without recreating the buffer"
  (dolist (kill '(nil t))
    (with-current-buffer buffer
      (mevedel-memory-list-mode)
      (setq mevedel-cockpit--context context)
      (mevedel-memory-list--start context)
      (let ((old mevedel-memory-list--job))
        (if kill (kill-buffer buffer) (fundamental-mode))
        (should-not (process-live-p (plist-get old :worker)))
        (should-not (file-directory-p (plist-get old :directory)))
        (mevedel-memory-list--received buffer old '(:error "Late failure")))))
  :doc "the original deadline stops its child and leaves a visible retryable error"
  (with-current-buffer buffer
    (mevedel-memory-list--start context)
    (let ((job mevedel-memory-list--job))
      (funcall (timer--function (plist-get job :timer)))
      (should-not mevedel-memory-list--job)
      (should-not (process-live-p (plist-get job :worker)))
      (should (string-search "timed out" mevedel-memory-list--error))
      (should (string-search "g retries" (mevedel-memory-list--header nil context)))))
  :doc "reopening observes a coalesced recovery owner started outside this cockpit"
  (let* ((mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (mevedel-memory-store--claim-directory workspace))
         (owner (list 'existing-owner)))
    (puthash key owner mevedel-memory-decision--recovery-workers)
    (save-window-excursion
      (mevedel-memory-list-open context)
      (let ((previous (buffer-local-value 'mevedel-memory-list--recovery (get-buffer "*mevedel memory*"))))
        (with-current-buffer (mevedel-memory-list-open context)
          (should-not (eq previous mevedel-memory-list--recovery))
          (should-not (memq (plist-get previous :timer) timer-list))
          (let ((watcher mevedel-memory-list--recovery))
            (mevedel-memory-list--observe-recovery (current-buffer) watcher)
            (should (eq watcher mevedel-memory-list--recovery))
            (should (eq owner (gethash key mevedel-memory-decision--recovery-workers)))
            (remhash key mevedel-memory-decision--recovery-workers)
            (mevedel-memory-list--observe-recovery (current-buffer) watcher)
            (mevedel-test-memory-list-await)
            (should-not mevedel-memory-list--recovery)
            (should mevedel-memory-list--snapshot))))))
  :doc "opening scans during recovery, refreshes after its owner retires, and tabs reuse each snapshot"
  (let* ((starts 0) (start (symbol-function 'mevedel-memory-list--start))
         (mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (mevedel-memory-store--claim-directory workspace))
         (owner (list 'existing-owner)))
    (puthash key owner mevedel-memory-decision--recovery-workers)
    (cl-letf (((symbol-function 'mevedel-memory-list--start)
               (lambda (context) (cl-incf starts) (funcall start context))))
      (unwind-protect
          (save-window-excursion
            (with-current-buffer (mevedel-memory-list-open context)
              (let ((child (plist-get mevedel-memory-list--job :worker)))
                (should (processp child))
                (with-timeout (45 (ert-fail "Independent display scan did not finish"))
                  (while mevedel-memory-list--job (accept-process-output nil .01)))
                (should-not (process-live-p child)))
              (should mevedel-memory-list--snapshot)
              (should mevedel-memory-list--recovery)
              (should (eq owner (gethash key mevedel-memory-decision--recovery-workers)))
              (should (= 1 starts))
              (dolist (view '(history candidates memories history)) (mevedel-memory-list-switch view))
              (should (= 1 starts))
              (remhash key mevedel-memory-decision--recovery-workers)
              (mevedel-memory-list--observe-recovery (current-buffer) mevedel-memory-list--recovery)
              (mevedel-test-memory-list-await)
              (should (= 2 starts))
              (mevedel-memory-list-refresh)
              (mevedel-test-memory-list-await)
              (should (= 3 starts))))
        (when (eq owner (gethash key mevedel-memory-decision--recovery-workers))
          (remhash key mevedel-memory-decision--recovery-workers))
        (when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*")))))
  :doc "Memories inventories once while recovery is pending and keeps that independent snapshot"
  (let* ((mevedel-memory-decision--recovery-workers (make-hash-table :test #'equal))
         (key (mevedel-memory-store--claim-directory workspace))
         (read (symbol-function 'mevedel-memory-library-list)) (reads 0))
    (puthash key '(existing-owner) mevedel-memory-decision--recovery-workers)
    (cl-letf (((symbol-function 'mevedel-memory-library-list)
               (lambda (workspace) (cl-incf reads) (funcall read workspace))))
      (save-window-excursion
        (with-current-buffer (mevedel-memory-list-open context)
          (mevedel-memory-list-memories)
          (should (= 1 reads))
          (let ((watcher mevedel-memory-list--recovery))
            (remhash key mevedel-memory-decision--recovery-workers)
            (mevedel-memory-list--observe-recovery (current-buffer) watcher))
          (mevedel-test-memory-list-await)
          (should (= 1 reads))))))
  :doc "pending quit after actual process creation cannot orphan its child before handoff"
  (with-current-buffer buffer
    (let ((create (symbol-function 'make-process)) child directory cancelled)
      (unwind-protect
          (progn
            (let ((inhibit-quit nil))
              (cl-letf (((symbol-function 'make-process)
                         (lambda (&rest args)
                           (setq child (apply create args)
                                 directory (plist-get mevedel-memory-list--job :directory) quit-flag t)
                           (unless inhibit-quit (setq quit-flag nil) (signal 'quit nil))
                           child)))
                (condition-case nil (mevedel-memory-list--start context) (quit (setq cancelled t)))))
            (should child)
            (should cancelled)
            (should-not (process-live-p child))
            (should-not (file-directory-p directory))
            (should-not mevedel-memory-list--job))
        (setq quit-flag nil)
        (when (and child (process-live-p child)) (delete-process child)))))
  :doc "pending quit after real deadline creation cannot leak the unregistered timer"
  (with-current-buffer buffer
    (let ((schedule (symbol-function 'run-at-time)) timer child cancelled)
      (unwind-protect
          (progn
            (let ((inhibit-quit nil))
              (cl-letf (((symbol-function 'run-at-time)
                         (lambda (&rest args)
                           (setq timer (apply schedule args)
                                 child (plist-get mevedel-memory-list--job :worker) quit-flag t)
                           (unless inhibit-quit (setq quit-flag nil) (signal 'quit nil))
                           timer)))
                (condition-case nil (mevedel-memory-list--start context) (quit (setq cancelled t)))))
            (should timer)
            (should cancelled)
            (should-not (process-live-p child))
            (should-not (memq timer timer-list))
            (should-not mevedel-memory-list--job))
        (setq quit-flag nil)
        (when (timerp timer) (cancel-timer timer))
        (when (and child (process-live-p child)) (delete-process child)))))
  :doc "cleanup error or quit retains the retired child handle and makes callbacks inert until retry"
  (with-current-buffer buffer
    (dolist (failure '(error quit))
      (mevedel-memory-list--start context)
      (let* ((job mevedel-memory-list--job) (child (plist-get job :worker))
             (timer (plist-get job :timer)) (directory (plist-get job :directory))
             (stop (symbol-function 'delete-process)) caught)
        (cl-letf (((symbol-function 'delete-process)
                   (lambda (process)
                     (if (eq process child) (signal failure '("Injected stop failure")) (funcall stop process)))))
          (condition-case err (mevedel-memory-list--cancel) ((error quit) (setq caught (car err)))))
        (should (eq caught failure))
        (should (eq job mevedel-memory-list--job))
        (should (plist-get job :retired))
        (should (process-live-p child))
        (should-not (memq timer timer-list))
        (should (string-search "cleanup failed" (mevedel-memory-list--header nil context)))
        (mevedel-memory-list--received buffer job '(:error "Late failure"))
        (should (eq job mevedel-memory-list--job))
        (mevedel-memory-list--cancel)
        (should-not (process-live-p child))
        (should-not (file-directory-p directory))
        (should-not mevedel-memory-list--job))))
  :doc "request writing remains interruptible and releases its registered directory on quit"
  (with-current-buffer buffer
    (let (directory)
      (cl-letf (((symbol-function 'mevedel-journal-worker--write)
                 (lambda (&rest _)
                   (setq directory (plist-get mevedel-memory-list--job :directory))
                   (should-not inhibit-quit)
                   (signal 'quit nil))))
        (condition-case nil (mevedel-memory-list--start context) (quit nil)))
      (should directory)
      (should-not (file-directory-p directory))
      (should-not mevedel-memory-list--job)))
  :doc "unrelated background work cannot hold this workspace's display watcher"
  (let ((mevedel-transport--background-running t))
    (save-window-excursion
      (with-current-buffer (mevedel-memory-list-open context)
        (should-not (mevedel-memory-decision-recovering-p workspace))
        (mevedel-memory-list--observe-recovery (current-buffer) mevedel-memory-list--recovery)
        (should-not mevedel-memory-list--recovery)
        (mevedel-test-memory-list-await)
        (should mevedel-memory-list--snapshot)))))

(mevedel-deftest mevedel-memory-list-refresh
    (:vars* ((root (make-temp-file "mevedel-cockpit-selection-" t))
             (workspace (mevedel-workspace--create :root root :type 'project))
             (memory (file-name-concat root "memory"))
             (mevedel-memory-dirs (list memory))
             (mevedel-memory-decision--inhibit-recovery nil)
             (mevedel-journal-cleanup--inhibit-scheduling t)
             (context (mevedel-cockpit-workspace-context workspace)))
     :after-each ((when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
                  (mevedel-memory-decision-stop-recovery)
                  (delete-directory root t)))
  (progn
    (make-directory memory)
    (dolist (file '("first.md" "second.md"))
      (write-region "A current topic.\n" nil (file-name-concat memory file) nil 'silent))
    (mevedel-workspace-identity-ensure root)
    (mevedel-test-memory-history-create workspace 1 2 512)
    (mevedel-test-memory-history-create workspace 1 2 512 t)
    (save-window-excursion
      (with-current-buffer (mevedel-memory-list-open context)
        (mevedel-test-memory-list-await)
        ,test)))
  (test)
  :doc "g and review completion preserve a surviving non-first selection in every tab and rejection targets it"
  (progn
    (dolist (cause '(explicit completion))
      (dolist (view '(candidates memories history))
        (mevedel-memory-list-switch view)
        (should (>= (length (mevedel-cockpit-surface-items)) 2))
        (let ((selected (plist-get (cadr (mevedel-cockpit-surface-items)) :id)))
          (mevedel-cockpit-goto-id selected)
          (if (eq cause 'explicit)
              (call-interactively (key-binding (kbd "g")))
            (mevedel-test--with-captured-messages nil
              (mevedel-memory-list--finished workspace '(:outcome success :mode propose))))
          (mevedel-test-memory-list-await)
          (should (eq view mevedel-memory-list--view))
          (should (equal selected (tabulated-list-get-id))))))
    (mevedel-memory-list-candidates)
    (let* ((items (mevedel-cockpit-surface-items))
           (first (car items)) (selected (cadr items)))
      (mevedel-cockpit-goto-id (plist-get selected :id))
      (call-interactively (key-binding (kbd "g")))
      (mevedel-test-memory-list-await)
      (call-interactively (key-binding (kbd "r")))
      (mevedel-test-memory-list-await)
      (should (eq 'rejected (plist-get (mevedel-memory-decision-status workspace (plist-get selected :id)) :status)))
      (should-not (mevedel-memory-decision-status workspace (plist-get first :id)))))
  :doc "switching tabs during loading keeps their own non-first selections and acceptance targets the restored row"
  (let (selected history first)
    (dolist (view '(history candidates))
      (mevedel-memory-list-switch view)
      (should (>= (length (mevedel-cockpit-surface-items)) 2))
      (mevedel-cockpit-goto-id (plist-get (cadr (mevedel-cockpit-surface-items)) :id))
      (if (eq view 'history) (setq history (tabulated-list-get-id))
        (setq selected (mevedel-cockpit-surface-selected) first (car (mevedel-cockpit-surface-items)))))
    (call-interactively (key-binding (kbd "g")))
    (should mevedel-memory-list--job)
    (mevedel-memory-list-history)
    (mevedel-memory-list-candidates)
    (mevedel-memory-list-history)
    (mevedel-test-memory-list-await)
    (should (eq 'history mevedel-memory-list--view))
    (should (equal history (tabulated-list-get-id)))
    (mevedel-memory-list-candidates)
    (should (equal (plist-get selected :id) (tabulated-list-get-id)))
    (call-interactively (key-binding (kbd "a")))
    (mevedel-test-memory-list-await)
    (should (eq 'applied (plist-get (mevedel-memory-decision-status workspace (plist-get selected :id)) :status)))
    (should-not (mevedel-memory-decision-status workspace (plist-get first :id))))
  :doc "nonselected async refresh preserves each displayed window's row and the active real composer"
  (let* ((data (generate-new-buffer " *memory-selection-data*"))
         (view (generate-new-buffer " *memory-selection-chat*"))
         (session (mevedel-session-create "selection" workspace))
         (draft "> active draft\nsecond line") chat left right selected first)
    (unwind-protect
        (progn
          (with-current-buffer data (setq-local mevedel--session session))
          (mevedel-view--setup view data)
          (with-current-buffer view (mevedel-view-test--insert-composer-draft draft 4))
          (delete-other-windows)
          (switch-to-buffer view)
          (setq chat (selected-window) left (split-window-right)
                right (split-window left nil 'below))
          (let ((context (with-current-buffer view (mevedel-cockpit-current-context))))
            (with-selected-window left
              (let ((display-buffer-overriding-action '(display-buffer-same-window)))
                (mevedel-memory-list-open context))))
          (set-window-buffer right (get-buffer "*mevedel memory*"))
          (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
          (dolist (tab '(history memories candidates))
            (let (left-id right-id)
              (with-selected-window left
                (mevedel-memory-list-switch tab)
                (setq left-id (plist-get (car (mevedel-cockpit-surface-items)) :id)
                      right-id (plist-get (cadr (mevedel-cockpit-surface-items)) :id))
                (should left-id) (should right-id)
                (mevedel-cockpit-goto-id left-id))
              (with-selected-window right (mevedel-cockpit-goto-id right-id))
              (with-selected-window left
                (call-interactively (key-binding (kbd "g")))
                (mevedel-memory-list-switch (if (eq tab 'history) 'candidates 'history))
                (mevedel-memory-list-switch tab))
              ;; Memories remains usable while history is loading. A newer
              ;; window selection must beat the one saved before refresh.
              (when (eq tab 'memories)
                (with-selected-window right (mevedel-cockpit-goto-id left-id))
                (setq right-id left-id))
              (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
              (should (eq chat (selected-window)))
              (with-current-buffer view
                (should (equal draft (mevedel-view--input-text)))
                (should (= (point) (+ (mevedel-view--input-start) 4))))
              (with-selected-window left (should (equal left-id (tabulated-list-get-id))))
              (with-selected-window right (should (equal right-id (tabulated-list-get-id))))))
          (with-selected-window right
            (setq selected (mevedel-cockpit-surface-selected)
                  first (car (mevedel-cockpit-surface-items)))
            (should-not (equal (plist-get selected :id) (plist-get first :id)))
            (call-interactively (key-binding (kbd "r"))))
          (mevedel-test-memory-list-await (get-buffer "*mevedel memory*"))
          (should (eq 'rejected (plist-get (mevedel-memory-decision-status workspace (plist-get selected :id)) :status)))
          (should-not (mevedel-memory-decision-status workspace (plist-get first :id)))
          (should (eq chat (selected-window)))
          (with-current-buffer view
            (should (equal draft (mevedel-view--input-text)))
            (should (= (point) (+ (mevedel-view--input-start) 4)))))
      (when (get-buffer "*mevedel memory*") (kill-buffer "*mevedel memory*"))
      (when (buffer-live-p view) (kill-buffer view))
      (when (buffer-live-p data) (kill-buffer data)))))

(provide 'test-mevedel-memory-list-latency)
