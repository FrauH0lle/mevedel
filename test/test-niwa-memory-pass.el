;;; test-niwa-memory-pass.el -- Consolidation coordination -*- lexical-binding: t -*-

;;; Commentary:

;; Exercise candidate selection and pass settlement against real journal state.

;;; Code:

(require 'niwa-journal-test-support
         (file-name-concat
          (file-name-directory
           (or buffer-file-name load-file-name byte-compile-current-file))
          "niwa-journal-test-support"))
(require 'niwa-journal-index)
(require 'niwa-memory-pass)
(require 'gptel-openai)
(require 'niwa-memory-store)
(require 'niwa-memory-review)
(require 'niwa-telemetry)

(defun niwa-test-memory-pass--digest (workspace number session name)
  "Publish a dated test digest NUMBER for SESSION and NAME in WORKSPACE."
  (niwa-journal-store-publish-digest
   (niwa-workspace-root workspace)
   (list :capture-id (format "%064x" number) :session session :session-name name
         :workspace (niwa-workspace-identity-read (niwa-workspace-root workspace))
         :trigger 'session-end :segment 1 :source-revision (make-string 64 ?c)
         :turns '(1) :turn-ids (list (format "%064x" number))
         :created (format "2026-08-%02dT12:00:00Z" number) :model "test:model")
   "## Done\n- Observed: Tests passed.\n\n## Learned\n- none\n\n## Surprised\n- none\n\n## Unfinished\n- none"))

(niwa-deftest niwa-memory-pass-select ()
  ,test
  (test)
  :doc "general coverage is excluded while completed evidence from a live session remains eligible"
  (niwa-test-journal-capture--with-session
   (lambda (session buffer)
     (niwa-test-journal-capture--turn session buffer "Check source" "Tests passed")
     (let* ((workspace (niwa-session-workspace session))
            (root (niwa-workspace-root workspace))
            (first (niwa-test-memory-pass--digest workspace 1 "closed-a" "A"))
            (live (niwa-test-memory-pass--digest workspace 2 (niwa-session-session-id session)
                                                   (niwa-session-name session)))
            (third (niwa-test-memory-pass--digest workspace 3 "closed-c" "C")))
       (niwa-journal-store-publish-review
        root (list :pass-id (make-string 64 ?d) :workspace (niwa-workspace-identity-read root)
                   :created "2026-08-04T12:00:00Z" :model "test:model" :focus ""
                   :digests (list (plist-get first :id)) :proposals nil :references nil))
       (let* ((entries (niwa-journal-store-entries root))
              (selection (niwa-memory-pass-select entries)))
         (should (equal (list live third) (plist-get selection :entries)))
         (should-not (plist-get selection :excluded))
         (should (= 2 (plist-get selection :eligible)))
         (should (= 0 (plist-get selection :remaining)))
         (should (equal (list first live third)
                        (plist-get (niwa-memory-pass-select entries t) :entries)))
         (let ((niwa-journal-enabled nil)) (kill-buffer buffer))
         (niwa-session-persistence-lock-release (niwa-session-save-path session) session)
         (should (equal (list live third)
                        (plist-get (niwa-memory-pass-select entries) :entries)))
         (should (equal entries (niwa-journal-store-entries root)))))))
  :doc "selection freezes twenty oldest digests and reports the remaining eligible backlog"
  (niwa-test-journal-capture--with-session
   (lambda (session _buffer)
     (let* ((workspace (niwa-session-workspace session))
            (root (niwa-workspace-root workspace))
            published)
       (dotimes (index 24)
         (push (niwa-test-memory-pass--digest workspace (1+ index) "closed" "Closed") published))
       (setq published (nreverse published))
       (let* ((entries (niwa-journal-store-entries root))
              (selection (niwa-memory-pass-select entries)))
         (should (equal (seq-take published 20) (plist-get selection :entries)))
         (should (= 24 (plist-get selection :eligible)))
         (should (= 4 (plist-get selection :remaining)))
         (should-not (plist-get selection :excluded))
         (niwa-test-memory-pass--digest workspace 25 "arrived-later" "Later")
         (should (equal selection (niwa-memory-pass-select entries)))
         (should (= 5 (plist-get (niwa-memory-pass-select
                                 (niwa-journal-store-entries root)) :remaining)))))))
  :doc "published evidence remains eligible without reading or changing source session locks"
  (niwa-test-journal-capture--with-session
   (lambda (session buffer)
     (niwa-test-journal-capture--turn session buffer "Check source" "Tests passed")
     (let* ((workspace (niwa-session-workspace session))
            (root (niwa-workspace-root workspace))
            (entry (niwa-test-memory-pass--digest workspace 1 (niwa-session-session-id session)
                                                    (niwa-session-name session)))
            (lock (file-name-concat (niwa-session-save-path session) ".lock")))
       (let ((niwa-journal-enabled nil)) (kill-buffer buffer))
       (niwa-session-persistence-lock-release (niwa-session-save-path session) session)
       (dolist (contents (list "(:hostname \"another-host\" :pid 123)" "("
                              (format "(:hostname %S :pid nil)" (system-name))))
         (write-region contents nil lock nil 'silent)
         (let ((selection (niwa-memory-pass-select (niwa-journal-store-entries root))))
           (should (equal (list entry) (plist-get selection :entries)))
           (should (equal contents (niwa-session-control-fs-read-file lock)))))
       (delete-file lock))))
  :doc "completed evidence from portable sessions remains eligible without changing their leases"
  (let ((local-root (file-name-as-directory (make-temp-file "niwa-memory-live-" t))))
    (unwind-protect
        (niwa-test--with-local-shell-tramp '("memory-live")
          (cl-destructuring-bind (workspace session directory _segment)
              (test-niwa-session-persistence--make-remote-restore-fixture "memory-live" local-root "")
            (let* ((entry (niwa-test-memory-pass--digest workspace 1 (niwa-session-session-id session)
                                                          (niwa-session-name session)))
                   (root (niwa-workspace-root workspace))
                   (entries (niwa-journal-store-entries root)))
              (dolist (owner (list (make-string 64 ?f) niwa-session-durability--client-id))
                (unwind-protect
                    (progn
                      (let ((niwa-session-durability--client-id owner))
                        (should (niwa-session-durability-lease-acquire directory "Other conversation")))
                      (let* ((before (niwa-session-durability-lease-status directory))
                             (selection (niwa-memory-pass-select entries)))
                        (should (equal (list entry) (plist-get selection :entries)))
                        (should (equal before (niwa-session-durability-lease-status directory)))))
                  (let ((niwa-session-durability--client-id owner))
                    (niwa-session-durability-lease-release directory))))
              (should (equal (list entry) (plist-get (niwa-memory-pass-select entries) :entries))))))
      (delete-directory local-root t)
      (niwa-workspace-clear-registry)))
  :doc "an independent Emacs holder can continue while its completed evidence is selected"
  (niwa-test-journal-capture--with-session
   (lambda (session buffer)
     (niwa-test-journal-capture--turn session buffer "Check source" "Tests passed")
     (let* ((workspace (niwa-session-workspace session))
            (root (niwa-workspace-root workspace))
            (directory (niwa-session-save-path session))
            (entry (niwa-test-memory-pass--digest workspace 1 (niwa-session-session-id session)
                                                    (niwa-session-name session)))
            (runner (file-name-concat root "holder.el"))
            (ready (file-name-concat root "ready"))
            (release (file-name-concat root "release"))
            (output (generate-new-buffer " *memory-holder*"))
            process)
       (unwind-protect
           (progn
             (let ((niwa-journal-enabled nil)) (kill-buffer buffer))
             (niwa-session-persistence-lock-release directory session)
             (with-temp-file runner
               (insert ";;; -*- lexical-binding: t -*-\n")
               (prin1
                `(progn
                   (setq load-path ',load-path)
                   (require 'niwa-structs)
                   (require 'niwa-session-persistence)
                   (let ((owner (niwa-session--create
                                 :workspace (niwa-workspace--create :type 'file :root ,root)))
                         (deadline (+ (float-time) 15)))
                     (unwind-protect
                         (progn
                           (unless (niwa-session-persistence-lock-acquire ,directory "Independent holder" owner)
                             (error "Could not acquire test session"))
                           (write-region "ready" nil ,ready nil 'silent)
                           (while (and (not (file-exists-p ,release)) (< (float-time) deadline))
                             (accept-process-output nil 0.01)))
                       (niwa-session-persistence-lock-release ,directory owner))))
                (current-buffer)))
             (setq process (make-process :name "memory-independent-holder" :buffer output :noquery t
                                         :sentinel #'ignore
                                         :command (list (file-name-concat invocation-directory invocation-name)
                                                        "-Q" "--batch" "-l" runner)))
             (with-timeout (10 (ert-fail "Independent holder did not acquire authority"))
               (while (and (process-live-p process) (not (file-exists-p ready)))
                 (accept-process-output nil 0.01)))
             (ert-info ((with-current-buffer output (buffer-string)))
               (should (file-exists-p ready))
               (should (process-live-p process)))
             (let ((selection (niwa-memory-pass-select (niwa-journal-store-entries root))))
               (should (equal (list entry) (plist-get selection :entries))))
             (write-region "release" nil release nil 'silent)
             (with-timeout (10 (ert-fail "Independent holder did not release authority"))
               (while (process-live-p process) (accept-process-output nil 0.01)))
             (should (= 0 (process-exit-status process)))
             (should (equal (list entry)
                            (plist-get (niwa-memory-pass-select (niwa-journal-store-entries root)) :entries))))
         (when (process-live-p process) (delete-process process))
         (kill-buffer output))))))

(niwa-deftest niwa-memory-pass-start
    (:vars* ((directory (make-temp-file "niwa-memory-coordinator-" t))
             (workspace (niwa-workspace--create :root directory))
             (identity (niwa-workspace-identity-ensure directory))
             (niwa-memory-dirs nil)
             (niwa-memory-consolidation-mode 'manual)
             ;; Most cases test settlement, not process dispatch.  Telemetry,
             ;; disk failure and the late-callback race retain real children;
             ;; test-niwa-memory-pass-worker covers their other boundaries.
             (niwa-journal-worker--child-p t)
             (gptel--known-backends nil)
             (model (make-symbol "review-model"))
             (backend (gptel-make-openai "coordinator-test" :key "test-only" :models (list model)))
             (real-request (symbol-function 'gptel-request))
             (none "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n## Remove\n- none\n## Instructions\n- none\n## No action\n- No supported changes.")
             (settlements 0) request provider state result)
     :before-each ((put model :context-window 128) (put model :capabilities '(tool-use)))
     :after-each ((niwa-memory-pass-cancel workspace) (delete-directory directory t)))
  (cl-letf (((symbol-function 'niwa-model-resolve-workload)
             (lambda (&rest _) (list :backend backend :model model)))
            ((symbol-function 'gptel-request)
             (lambda (prompt &rest args)
               (let ((fsm (apply real-request prompt (plist-put (copy-sequence args) :dry-run t))))
                 (unless (plist-get args :dry-run)
                   (setq request fsm provider (plist-get args :callback)))
                 fsm))))
    (cl-labels ((start (&rest options)
                  (setq state (apply #'niwa-memory-pass-start workspace
                                     (lambda (value) (cl-incf settlements) (setq result value)) options))
                  (if niwa-journal-worker--child-p
                      (should-not (plist-get state :worker))
                    (should (processp (plist-get state :worker))))
                  (let ((deadline (+ (float-time) 10)))
                    (while (and state (not (plist-get state :request))
                                (not (plist-get state :settled)) (< (float-time) deadline))
                      (accept-process-output nil .01)))
                  state)
                (finish (text)
                  (funcall provider text (gptel-fsm-info request))
                  (gptel--fsm-transition request 'DONE)
                  (if niwa-journal-worker--child-p
                      (should-not (plist-get state :worker))
                    (should (processp (plist-get state :worker))))
                  (let ((deadline (+ (float-time) 15)))
                    (while (and (not (plist-get state :settled)) (< (float-time) deadline))
                      (accept-process-output nil .01))))
                (check-output (record text &optional reasoning)
                  (should (= (string-bytes (concat reasoning text)) (plist-get record :output-bytes)))
                  (should (= (niwa-context-summary--estimated-tokens "" (concat reasoning text))
                             (plist-get record :output-estimated-tokens)))
                  (should (= (string-bytes text) (plist-get record :result-bytes)))
                  (should (= (string-bytes text) (plist-get record :reply-bytes)))
                  (should (= (string-bytes (or reasoning "")) (plist-get record :reasoning-bytes)))
                  (should (= 0 (plist-get record :tool-call-bytes)))
                  (should (= 0 (plist-get record :tool-call-count)))
                  (should (= 1 (plist-get record :rounds)))
                  (should-not (plist-get record :budget-kind))
                  (should-not (plist-get record :output-limit)))
                (events ()
                  (with-temp-buffer
                    (insert-file-contents
                     (file-name-concat directory ".niwa" "state" "diagnostics" niwa-telemetry-file-name))
                    (goto-char (point-min))
                    (let (values)
                      (condition-case nil
                          (while t (push (read (current-buffer)) values))
                        (end-of-file (nreverse values)))))))
      ,test))
  (test)
  :doc "telemetry reports focused review counts and usage without private focus or content"
  (let ((niwa-journal-worker--child-p nil))
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start :focus "SECRET focus")
    (setf (plist-get (gptel-fsm-info request) :tokens) '(:input 11 :cached 3 :output 5)
          (plist-get (gptel-fsm-info request) :stream) nil)
    (finish none)
    (let* ((records (events)) (completed (cadr records)))
      (should (equal '(memory-consolidation-fired memory-consolidation-completed)
                     (mapcar (lambda (event) (plist-get event :event)) records)))
      (should (eq 'focused (plist-get completed :scope)))
      (should (eq 'memory (plist-get completed :workload)))
      (should (eq 'manual (plist-get completed :mode)))
      (should (= 1 (plist-get completed :reviewed-count)))
      (should (= 0 (plist-get completed :covered-count)))
      (should (= 0 (plist-get completed :proposed-count)))
      (should (= 11 (plist-get completed :input-tokens)))
      (should (= 3 (plist-get completed :cached-tokens)))
      (should (= 5 (plist-get completed :output-tokens)))
      (check-output completed none)
      (check-output result none)
      (should (equal (plist-get (plist-get state :claim) :owner) (plist-get completed :pass-id)))
      (should (numberp (plist-get completed :duration-ms)))
      (should-not (plist-get completed :dropped-keys))
      (should-not (string-match-p "SECRET\\|test-only\\|No supported changes" (prin1-to-string records)))))
  :doc "telemetry retains reported usage and unconsumed backlog on cancellation without duplicate late events"
  (progn
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start)
    (setf (plist-get (gptel-fsm-info request) :tokens) '(:input 17 :cached 2 :output 4)
          (plist-get (gptel-fsm-info request) :stream) nil)
    (funcall provider "SECRET partial response" (gptel-fsm-info request))
    (niwa-memory-pass-cancel workspace)
    (finish none)
    (let* ((records (events)) (killed (cadr records)))
      (should (equal '(memory-consolidation-fired memory-consolidation-killed)
                     (mapcar (lambda (event) (plist-get event :event)) records)))
      (should (= 17 (plist-get killed :input-tokens)))
      (should (= 4 (plist-get killed :output-tokens)))
      (check-output killed "SECRET partial response")
      (check-output result "SECRET partial response")
      (should (= 1 (plist-get killed :remaining-count)))
      (should (= 0 (plist-get killed :covered-count)))
      (should (= 1 (plist-get result :remaining)))
      (should-not (string-match-p "SECRET" (prin1-to-string records)))))
  :doc "telemetry preserves provider usage when accepting a valid result fails on disk"
  (let ((niwa-journal-worker--child-p nil))
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start)
    (make-directory (file-name-concat
                     (niwa-memory-store--directory workspace (plist-get (plist-get state :claim) :owner))
                     "accepted.el"))
    (setf (plist-get (gptel-fsm-info request) :tokens) '(:input 19 :cached 0 :output 6)
          (plist-get (gptel-fsm-info request) :stream) nil)
    (funcall provider '(reasoning . "SECRET reasoning") (gptel-fsm-info request))
    (finish none)
    (let* ((records (events)) (failed (cadr records)))
      (should (equal '(memory-consolidation-fired memory-consolidation-failed)
                     (mapcar (lambda (event) (plist-get event :event)) records)))
      (should (= 19 (plist-get failed :input-tokens)))
      (should (= 6 (plist-get result :output-tokens)))
      (check-output failed none "SECRET reasoning")
      (check-output result none "SECRET reasoning")
      (should (= 1 (plist-get failed :remaining-count)))
      (should (= 0 (plist-get failed :covered-count)))
      (should (eq 'publication (plist-get failed :failure-class)))
      (should-not (plist-member failed :error))))
  :doc "publishes one complete batch only after success and leaves a later arrival unreviewed"
  (let ((first (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")))
    (start)
    (should (eq state (niwa-memory-pass-running workspace)))
    (should (= 1 (length (niwa-journal-index-unreviewed (niwa-journal-store-entries directory)))))
    (with-current-buffer (plist-get (plist-get state :request) :buffer) (should-not niwa--session))
    (should-error (niwa-memory-pass-start workspace #'ignore))
    (let ((later (niwa-test-memory-pass--digest workspace 2 "later" "Later")))
      (finish none)
      (check-output result none)
      (should (= settlements 1))
      (should (eq 'success (plist-get result :outcome)))
      (should (equal (list (plist-get first :id)) (plist-get (plist-get result :entry) :digests)))
      (should (equal (list later) (niwa-journal-index-unreviewed (niwa-journal-store-entries directory)))))
    (should-not (niwa-memory-pass-running workspace))
    (should-not (timerp (plist-get state :timer))))
  :doc "cancellation fences a late callback while a successor remains live"
  (let ((niwa-journal-worker--child-p nil))
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start)
    (let ((old-provider provider) (old-request request) (old-claim (plist-get state :claim)))
      (should (niwa-memory-pass-cancel workspace))
      (should (eq 'cancelled (plist-get (niwa-journal-claim-outcome old-claim) :status)))
      (should (eq 'aborted (plist-get result :outcome)))
      (start)
      (funcall old-provider none (gptel-fsm-info old-request))
      (gptel--fsm-transition old-request 'DONE)
      (should (= settlements 1))
      (should (eq state (niwa-memory-pass-running workspace)))
      (should-not (niwa-journal-claim-outcome (plist-get state :claim)))
      (finish none)
      (should (= settlements 2))
      (should-not (niwa-journal-index-unreviewed (niwa-journal-store-entries directory)))))
  :doc "malformed output consumes no coverage and a later request may retry"
  (progn
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start)
    (setf (plist-get (gptel-fsm-info request) :tokens) '(:input 23 :cached 1 :output 3)
          (plist-get (gptel-fsm-info request) :stream) nil)
    (finish "SECRET invalid review")
    (should (eq 'error (plist-get result :outcome)))
    (let ((failed (cadr (events))))
      (should (eq 'memory-consolidation-failed (plist-get failed :event)))
      (should (eq 'review (plist-get failed :failure-class)))
      (should (= 23 (plist-get failed :input-tokens)))
      (should (= 1 (plist-get failed :remaining-count)))
      (should-not (string-match-p "SECRET" (prin1-to-string failed))))
    (should (eq 'failed (plist-get (niwa-journal-claim-outcome (plist-get state :claim)) :status)))
    (should (= 1 (length (niwa-journal-index-unreviewed (niwa-journal-store-entries directory)))))
    (start)
    (finish none)
    (should (eq 'success (plist-get result :outcome))))
  :doc "explicit empty and focused passes do not consume general review evidence"
  (progn
    (start :memory-only t)
    (finish none)
    (should (eq 'success (plist-get result :outcome)))
    (should-not (plist-get (plist-get result :entry) :digests))
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start :focus "Test conditions")
    (finish none)
    (should (eq 'success (plist-get result :outcome)))
    (should (= 1 (length (niwa-journal-index-unreviewed (niwa-journal-store-entries directory))))))
  :doc "closing the running inspection buffer cancels and retires the local pass"
  (progn
    (niwa-test-memory-pass--digest workspace 1 "closed" "Closed")
    (start)
    (kill-buffer (plist-get (plist-get state :request) :buffer))
    (should (eq 'aborted (plist-get result :outcome)))
    (should (= settlements 1))
    (should-not (niwa-memory-pass-running workspace))
    (should (eq 'cancelled (plist-get (niwa-journal-claim-outcome (plist-get state :claim)) :status)))
    (should (= 1 (length (niwa-journal-index-unreviewed (niwa-journal-store-entries directory))))))
  :doc "recovers an accepted result before selecting a successor batch"
  (let* ((entry (niwa-test-memory-pass--digest workspace 1 "closed" "Closed"))
         (claim (niwa-journal-claim-acquire (niwa-memory-store--claim-directory workspace) 180))
         (prepared (niwa-memory-store-prepare workspace claim (niwa-memory-scope-capture workspace) (list entry) "")))
    (niwa-memory-store-accept workspace prepared none (list entry) "test:model" nil)
    (should (= 1 (length (niwa-journal-store-entries directory))))
    (start :memory-only t)
    (should-not (plist-get (plist-get state :prepared) :entries))
    (should-not (niwa-journal-index-unreviewed (niwa-journal-store-entries directory)))
    (finish none)
    (should (= 3 (length (niwa-journal-store-entries directory))))))

(niwa-deftest niwa-memory-pass--finish ()
  ,test
  (test)
  :doc "budget diagnostics survive callback settlement and cancellation snapshots without raw text"
  (dolist (kind '(output-bytes output-estimated-tokens output-tokens proposal-bytes))
    (dolist (outcome '(error aborted))
      (let* ((directory (make-temp-file "niwa-memory-budget-pass-" t))
             (workspace (niwa-workspace--create :root directory))
             (claim (niwa-journal-claim-acquire (niwa-memory-store--claim-directory workspace) 180))
             (diagnostics (list :input-tokens 19 :cached-tokens 3 :output-tokens 17
                                :output-bytes 257 :output-estimated-tokens 65 :result-bytes 12
                                :reasoning-bytes 180 :reply-bytes 45 :tool-call-bytes 32
                                :tool-call-count 2 :rounds 3
                                :budget-kind kind :output-limit 256))
             (callbacks 0)
             (state (list :workspace workspace :claim claim :settled nil
                          :callback (lambda (_result) (cl-incf callbacks))
                          :request (list :usage (lambda () (copy-sequence diagnostics))))))
        (unwind-protect
            (progn
              (puthash (plist-get claim :directory) state niwa-memory-pass--running)
              (if (eq outcome 'aborted)
                  (niwa-memory-pass-cancel workspace)
                ;; A callback is authoritative even if the live snapshot differs.
                (let ((callback-result (append (list :outcome outcome :error "SECRET error"
                                                     :reply "SECRET reply" :reasoning "SECRET reasoning")
                                               (copy-sequence diagnostics))))
                  (plist-put diagnostics :result-bytes 0)
                  (niwa-memory-pass--finish state callback-result)
                  (plist-put diagnostics :result-bytes 12)))
              (niwa-memory-pass--finish state '(:outcome error :output-bytes 999))
              (should (= 1 callbacks))
              (should-not (niwa-memory-pass-running workspace))
              (let* ((records (with-temp-buffer
                                (insert-file-contents (file-name-concat directory ".niwa" "state" "diagnostics"
                                                                        niwa-telemetry-file-name))
                                (goto-char (point-min))
                                (list (read (current-buffer)) (ignore-errors (read (current-buffer))))))
                     (event (car records)))
                (should-not (cadr records))
                (should (eq (if (eq outcome 'aborted) 'memory-consolidation-killed
                              'memory-consolidation-failed)
                            (plist-get event :event)))
                (should (eq (and (eq outcome 'error) 'output-limit) (plist-get event :failure-class)))
                (dolist (record (list event (plist-get state :result)))
                  (cl-loop for (key value) on diagnostics by #'cddr
                           do (should (equal value (plist-get record key)))))
                (should-not (plist-get event :dropped-keys))
                (should-not (string-match-p "SECRET" (prin1-to-string event)))))
          (remhash (plist-get claim :directory) niwa-memory-pass--running)
          (delete-directory directory t)))))
  :doc "an expired owner's late success cannot publish or alter its successor's evidence pins"
  (let* ((directory (make-temp-file "niwa-memory-expired-owner-" t))
         (workspace (niwa-workspace--create :root directory))
         (identity (niwa-workspace-identity-ensure directory))
         (niwa-memory-dirs nil)
         (gptel--known-backends nil)
         (backend (gptel-make-openai "expired-test" :key "test-only" :models '(test-model)))
         (entry (niwa-test-memory-pass--digest workspace 1 "closed" "Closed"))
         (scope (niwa-memory-scope-capture workspace))
         (key (niwa-memory-store--claim-directory workspace))
         (claim (niwa-journal-claim-acquire key 2))
         (prepared (niwa-memory-store-prepare workspace claim scope (list entry) ""))
         (state (list :workspace workspace :claim claim :prepared prepared :settled nil))
         successor)
    (unwind-protect
        (progn
          (while (< (niwa-session-control-fs-target-time key) (plist-get claim :expires-at))
            (accept-process-output nil 0.05))
          (setq successor (niwa-journal-claim-acquire key 180))
          (should successor)
          (let* ((next (niwa-memory-store-prepare workspace successor scope (list entry) ""))
                 (pin (niwa-memory-store--pin workspace (plist-get successor :owner) (plist-get entry :id))))
            (niwa-memory-pass--finish
             state (list :outcome 'success :entries (list entry) :policy (list :backend backend :model 'test-model)
                         :reply "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n## Remove\n- none\n## Instructions\n- none\n## No action\n- No changes."))
            (let ((deadline (+ (float-time) 15)))
              (while (and (not (plist-get state :settled)) (< (float-time) deadline))
                (accept-process-output nil .01)))
            (should (eq 'error (plist-get (plist-get state :result) :outcome)))
            (should (eq 'expired (plist-get (niwa-journal-claim-outcome claim) :status)))
            (should-not (niwa-journal-claim-outcome successor))
            (should (equal successor (niwa-journal-claim-current key)))
            (should (equal (plist-get next :hash) (niwa-session-control-fs-read-file pin)))
            (should-not (file-exists-p (niwa-memory-store--pin workspace (plist-get claim :owner) (plist-get entry :id))))
            (should (equal (list entry) (niwa-journal-index-unreviewed (niwa-journal-store-entries directory))))))
      (when successor (niwa-journal-claim-settle successor 'cancelled ""))
      (delete-directory directory t))))

