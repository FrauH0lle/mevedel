FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
       bash bubblewrap git openssh-server python3 ripgrep util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash niwa \
    && install -d -m 0700 /home/niwa/.ssh \
    && touch /home/niwa/.ssh/authorized_keys \
    && chown -R niwa:niwa /home/niwa/.ssh \
    && install -d -o niwa -g niwa /workspace \
    && install -d -m 0755 /run/sshd \
    && ssh-keygen -A

EXPOSE 22

ENTRYPOINT ["/bin/sh", "-c", "chown -R niwa:niwa /workspace && exec /usr/sbin/sshd -D -e -o PasswordAuthentication=no -o PermitRootLogin=no -o StrictModes=no"]
