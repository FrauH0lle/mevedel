;;; test-niwa-memory-pass-worker.el --- Async preparation tests -*- lexical-binding: t -*-

;;; Commentary:
;; Real storage children retain configured roots and cancellation boundaries.

;;; Code:
(require 'helpers
         (file-name-concat
          (file-name-directory (or buffer-file-name load-file-name byte-compile-current-file))
          "helpers"))
(require 'niwa-memory-pass)
(require 'niwa-memory-review)
(require 'niwa-journal-worker)
(require 'gptel-openai)

(niwa-deftest niwa-memory-pass--prepare ()
  (let* ((directory (make-temp-file "niwa-pass-worker-" t))
         (workspace (niwa-workspace--create :root directory))
         (memory (file-name-concat directory "configured-memory"))
         (niwa-memory-dirs (list memory))
         (kill-emacs-hook kill-emacs-hook)
         (origin (current-buffer))
         (gptel--known-backends nil)
         (backend (gptel-make-openai "worker-test" :key "test-only" :models '(test-model)))
         (worker-start (symbol-function 'niwa-journal-worker-start))
         (publications 0)
         state observed result tick timer review-callback)
    (unwind-protect
        (progn
          (make-directory memory)
          (with-temp-file (file-name-concat memory "topic.md") (insert "Original configured fact.\n"))
          (cl-letf (((symbol-function 'niwa-journal-worker-start)
                     (cl-function (lambda (ws operation payload callback &key owner)
                       (when (eq operation 'memory-publish)
                         (cl-incf publications)
                         (should-not (plist-member payload :inspected)))
                       (funcall worker-start ws operation payload callback :owner owner))))
                    ((symbol-function 'niwa-memory-decision-recover)
                     (lambda (&rest _) (ert-fail "Recovery ran in the editor")))
                    ((symbol-function 'niwa-memory-store-recover)
                     (lambda (&rest _) (ert-fail "Store recovery ran in the editor")))
                    ((symbol-function 'niwa-memory-review-request)
                     (lambda (scope _entries callback &rest _)
                       (should (eq origin (current-buffer)))
                       (setq observed scope review-callback callback)
                       (list :cancel #'ignore))))
            (setq state (niwa-memory-pass-start
                         workspace (lambda (value) (setq result value)) :memory-only t))
            (should (processp (plist-get state :worker)))
            (should-not observed)
            (setq niwa-memory-dirs nil
                  timer (run-at-time 0 nil (lambda () (setq tick t))))
            (with-temp-buffer
             (let ((deadline (+ (float-time) 15)))
              (while (and (not observed) (not result) (< (float-time) deadline))
                (accept-process-output nil .01))))
            (should tick)
            (should-not result)
            (let* ((root (car (plist-get observed :roots)))
                   (snapshot (niwa-memory-scope-before observed (car root) "topic.md")))
              (should (equal "Original configured fact.\n" (plist-get snapshot :bytes)))
              (should (equal (niwa-workspace-identity-client) (plist-get (cdr root) :client))))
            (should (plist-get state :prepared))
            (funcall review-callback
                     (list :outcome 'success :entries (plist-get (plist-get state :prepared) :entries)
                           :policy (list :backend backend :model 'test-model)
                           :reply "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n## Remove\n- none\n## Instructions\n- none\n## No action\n- No supported changes."))
            (should (processp (plist-get state :worker)))
            (should-not result)
            (let ((deadline (+ (float-time) 15)))
              (while (and (not result) (< (float-time) deadline))
                (accept-process-output nil .01)))
            (should (eq 'success (plist-get result :outcome)))
            (should (= 1 publications))
            (should (= 1 (length (niwa-journal-store-entries directory))))))
      (when timer (cancel-timer timer))
      (niwa-memory-pass-cancel workspace)
      (delete-directory directory t))))

(niwa-deftest niwa-memory-pass-start/chunk-worker ()
  (let* ((directory (make-temp-file "niwa-chunk-worker-" t))
         (workspace (niwa-workspace--create :root directory))
         (shared (file-name-concat directory ".niwa" "shared"))
         (path (file-name-concat shared "large.md"))
         (niwa-memory-dirs nil)
         (niwa-memory-notes-max-review-bytes (* 48 1024))
         (niwa-working-note-max-age-days 9)
         state observed result review-callback)
    (unwind-protect
        (progn
          (make-directory shared t)
          (write-region (make-string (* 40 1024) ?x) nil path nil 'silent)
          ;; Younger than the default: a child ignoring the frozen setting cannot admit it.
          (set-file-times path (time-subtract nil (* 10 86400)))
          (cl-letf (((symbol-function 'niwa-memory-review-request)
                     (lambda (scope _entries callback &rest _)
                       (setq observed scope review-callback callback)
                       (list :cancel #'ignore))))
            (setq state (niwa-memory-pass-start workspace (lambda (value) (setq result value)) :memory-only t)
                  niwa-memory-notes-max-review-bytes (* 32 1024)
                  niwa-working-note-max-age-days nil)
            (should (processp (plist-get state :worker)))
            (let ((deadline (+ (float-time) 15)))
              (while (and (not observed) (not result) (< (float-time) deadline))
                (accept-process-output nil .01)))
            (should observed)
            (should-not result)
            (should (plist-get (car (niwa-memory-notes-documents observed)) :chunked))
            (funcall review-callback '(:outcome restart-required :error "Note changed; restart when quiet"))
            (should (eq 'restart-required (plist-get result :outcome)))
            (should (eq 'cancelled (plist-get (niwa-journal-claim-outcome (plist-get state :claim)) :status)))
            (should-not (niwa-memory-store-accepted workspace (plist-get (plist-get state :claim) :owner)))
            (should (file-exists-p path))))
      (niwa-memory-pass-cancel workspace)
      (delete-directory directory t))))

(niwa-deftest niwa-memory-pass--prepared ()
  (let* ((directory (make-temp-file "niwa-pass-cancel-" t))
         (workspace (niwa-workspace--create :root directory))
         (niwa-memory-dirs nil)
         (kill-emacs-hook kill-emacs-hook)
         (settlements 0) state result worker)
    (unwind-protect
        (cl-letf (((symbol-function 'niwa-memory-review-request)
                   (lambda (&rest _) (ert-fail "Cancelled preparation started inference"))))
          (setq state (niwa-memory-pass-start
                       workspace (lambda (value) (cl-incf settlements) (setq result value))
                       :memory-only t)
                worker (plist-get state :worker))
          (should (processp worker))
          (niwa-memory-pass-cancel workspace)
          (accept-process-output nil .02)
          (niwa-memory-pass--prepared state '(:error "Late child") "" t)
          (should (= settlements 1))
          (should (eq 'aborted (plist-get result :outcome)))
          (should-not (process-live-p worker))
          (should-not (niwa-memory-pass-running workspace))
          (should (eq 'cancelled (plist-get (niwa-journal-claim-outcome
                                            (plist-get state :claim)) :status))))
      (niwa-memory-pass-cancel workspace)
      (delete-directory directory t))))

(niwa-deftest niwa-memory-pass--publish ()
  (let* ((directory (make-temp-file "niwa-pass-publication-" t))
         (workspace (niwa-workspace--create :root directory))
         (niwa-memory-dirs nil)
         (none "## Promote\n- none\n## Update\n- none\n## Merge\n- none\n## Remove\n- none\n## Instructions\n- none\n## No action\n- No supported changes.")
         claim)
    (unwind-protect
        (progn
          (niwa-workspace-identity-ensure directory)
          (setq claim (niwa-journal-claim-acquire
                       (niwa-memory-store--claim-directory workspace) 180))
          (let* ((prepared (niwa-memory-store-prepare
                            workspace claim (niwa-memory-scope-capture workspace) nil ""))
                 (payload (list :prepared prepared :reply none :entries nil :model "test:fixture"))
                 (result
                  (cl-letf (((symbol-function 'niwa-memory-store-publish)
                             (lambda (&rest _) (error "Injected publication failure"))))
                    (niwa-memory-pass--publish workspace payload))))
            (should (plist-get result :error))
            (should (plist-get result :accepted))
            (should (eq 'completed (plist-get (niwa-journal-claim-outcome claim) :status)))
            (should (niwa-memory-store-publish workspace (plist-get prepared :id)))
            (should (niwa-memory-store-accepted workspace (plist-get prepared :id)))))
      (when claim (niwa-journal-claim-settle claim 'cancelled ""))
      (delete-directory directory t))))

(niwa-deftest niwa-memory-pass-start/automatic-worker ()
  (let* ((directory (make-temp-file "niwa-pass-gate-" t))
         (workspace (niwa-workspace--create :root directory))
         (niwa-memory-dirs nil)
         (niwa-memory-pass--inhibit-scheduling nil)
         (niwa-memory-consolidation-mode 'propose)
         (niwa-memory-consolidation-min-hours 9)
         (niwa-memory-consolidation-min-digests 7)
         state)
    (unwind-protect
        (cl-letf (((symbol-function 'niwa-memory-review-request)
                   (lambda (&rest _) (ert-fail "Skipped admission started inference"))))
          (setq state (niwa-memory-pass-start
                       workspace (lambda (_) (ert-fail "Skipped admission called completion")) :automatic t))
          (should (processp (plist-get state :worker)))
          (setq niwa-memory-consolidation-min-hours 0
                niwa-memory-consolidation-min-digests 1)
          (let ((until (+ (float-time) 10)))
            (while (and (not (plist-get state :settled)) (< (float-time) until))
              (accept-process-output nil .01)))
          (should (plist-get state :skipped))
          (should-not (niwa-memory-pass-running workspace))
          (should (= 9 (plist-get (niwa-workspace-memory-schedule workspace) :hours)))
          (should (= 7 (plist-get (niwa-workspace-memory-schedule workspace) :digests)))
          (should (eq 'cancelled (plist-get (niwa-journal-claim-outcome (plist-get state :claim)) :status))))
      (niwa-memory-pass-cancel workspace)
      (delete-directory directory t))))

(provide 'test-niwa-memory-pass-worker)
;;; test-niwa-memory-pass-worker.el ends here
