;;; test-niwa-claude-code-goal.el --- Native Goal boundaries -*- lexical-binding: t -*-

;;; Commentary:
;; Exercise Goal observations and accounting through admitted subscription turns.

;;; Code:

(require 'niwa-engine-test-support
         (file-name-concat (file-name-directory (or load-file-name buffer-file-name))
                           "niwa-engine-test-support"))
(require 'niwa-claude-code)
(require 'niwa-claude-code-session)

(niwa-deftest niwa--send-request/claude-goal-unknown-usage (:quiet t)
  (dolist (case '((100 nil 0 budget-limited)
                  (nil nil 0 active)
                  (100 ((inputTokens . 10) (cachedWriteTokens . 0)) 10 budget-limited)))
    (niwa-engine-test--with-claude-session
      (let* ((niwa-goal-token-budget (nth 0 case))
             (goal (niwa-goal-create "Read a large input and complete later" :session session))
             (input (make-string 40000 ?x)))
        (setq-local gptel-system-prompt "Goal fixture" gptel-tools nil)
        (cl-letf (((symbol-function 'niwa-claude-code-launch)
                   (niwa-engine-test--claude-launch
                    (lambda (_system mcp _model _effort &optional id _hook)
                      (list :meta `((responseText . "Large input accepted")
                                    (promptResponse . ((stopReason . "end_turn")
                                                       (usage . ,(nth 1 case)))))))))
                  ((symbol-function 'niwa-goal--schedule-continuation) #'ignore))
          (niwa--insert-user-turn input)
          (niwa--send-request input)
          (niwa-test--await 5 "Goal turn did not finish" (not (niwa-turn-busy-p buffer))))
        (should (eq 'success (plist-get (niwa-engine-info request) :niwa-acp-outcome)))
        (should-not (plist-get (niwa-engine-info request) :niwa-goal-estimated-tokens))
        (should (= (nth 2 case) (niwa-goal-tokens-used goal)))
        (should (niwa-goal-tokens-incomplete-p goal))
        (should (eq (nth 3 case) (niwa-goal-status goal)))
        (should (niwa-goal-tokens-incomplete-p
                 (niwa-session-codec--goal-from-plist
                  (plist-get (niwa-session-codec-read
                              (niwa-session-artifacts-sidecar-path
                               (niwa-session-save-path session))) :goal))))
        (when (nth 0 case)
          (should-error (niwa-goal-resume) :type 'user-error)
          (niwa-goal-set-budget 1000)
          (should (eq 'budget-limited (niwa-goal-status goal)))
          (cl-letf (((symbol-function 'niwa-goal--schedule-continuation) #'ignore))
            (niwa-goal-set-budget "none"))
          (should (eq 'active (niwa-goal-status goal))))))))

(niwa-deftest niwa--send-request/claude-goal-startup-failure (:quiet t)
  (niwa-engine-test--with-claude-session
    (let* ((niwa-goal-token-budget 100)
           (goal (niwa-goal-create "Continue after login" :session session)))
      (setq-local gptel-system-prompt "Goal fixture" gptel-tools nil)
      (cl-letf (((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (_system mcp _model _effort &optional id _hook)
                    (list :prepare-launch (lambda (_ready fail)
                                            (funcall fail "Subscription login required")
                                            #'ignore)))))
                ((symbol-function 'niwa-goal--schedule-continuation) #'ignore))
        (niwa--insert-user-turn "Continue")
        (niwa--send-request "Continue")
        (niwa-test--await 5 "Startup failure did not settle" (not (niwa-turn-busy-p buffer))))
      (should (= 0 (niwa-goal-tokens-used goal)))
      (should-not (niwa-goal-tokens-incomplete-p goal))
      (should (eq 'paused (niwa-goal-status goal)))
      (should (string-search "Subscription login required" (niwa-goal-reason goal))))))

(niwa-deftest niwa--send-request/claude-goal-budget (:quiet t)
  (niwa-engine-test--with-claude-session
    (let* ((niwa-goal-token-budget 100)
           (file (file-name-concat root "evidence.txt"))
           (goal (niwa-goal-create "Read the two samples and finish" :session session))
           (before
            [(((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_start")
                         (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                                     (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                               (cache_read_input_tokens . 500) (output_tokens . 1))))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                     (cache_read_input_tokens . 500) (output_tokens . 1)))))))
             (((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_start")
                         (message . ((id . "sample-two") (model . "claude-sonnet-fixture")
                                     (usage . ((input_tokens . 20) (cache_creation_input_tokens . 10)
                                               (cache_read_input_tokens . 500) (output_tokens . 2)))))))))])
           (after
            [(((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 20))))))
              ((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 20))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "sample-one") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 10) (cache_creation_input_tokens . 40)
                                     (cache_read_input_tokens . 500) (output_tokens . 1))))))
              ((type . "assistant") (parent_tool_use_id . "foreign-child")
               (message . ((id . "not-this-owner") (model . "claude-sonnet-fixture")
                           (usage . ((input_tokens . 99999) (cache_creation_input_tokens . 99999)
                                     (cache_read_input_tokens . 99999) (output_tokens . 99999))))))
              ((type . "assistant") (parent_tool_use_id . nil)
               (message . ((id . "synthetic") (model . "<synthetic>")
                           (usage . ((input_tokens . 99999) (cache_creation_input_tokens . 99999)
                                     (cache_read_input_tokens . 99999) (output_tokens . 99999)))))))
             (((type . "stream_event") (parent_tool_use_id . nil)
               (event . ((type . "message_delta") (usage . ((output_tokens . 25)))))))])
           crossings readings)
      (write-region "Evidence" nil file nil 'silent)
      (setq-local gptel-system-prompt "Goal fixture"
                  gptel-tools (list (niwa-tool-gptel-tool (niwa-tool-ensure "Read"))))
      (cl-letf (((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (_system mcp _model _effort &optional id hook)
                    (list :control (lambda (owner event)
                                     (push (copy-sequence (plist-get (niwa-engine-info owner) :tokens-full)) readings)
                                     (let ((result (niwa-claude-code--control owner event)))
                                       (push (plist-get (plist-get result :hookSpecificOutput) :additionalContext) crossings)
                                       result))
                          :meta `((hookCommand . ,hook)
                                  (sdkBeforeBatches . ,(vconcat (mapcar #'vconcat before)))
                                  (sdkAfterBatches . ,(vconcat (mapcar #'vconcat after)))
                                  (toolBatches . [[((name . "Read") (id . "read-one") (args . ((file_path . ,file))))]
                                                  [((name . "Read") (id . "read-two") (args . ((file_path . ,file))))]])
                                  (promptResponse . ((stopReason . "end_turn")
                                                     (usage . ((inputTokens . 30) (outputTokens . 45)
                                                               (cachedWriteTokens . 50) (cachedReadTokens . 1000)))))))))))
        (niwa--insert-user-turn "Carry out the Goal")
        (niwa--send-request "Carry out the Goal")
        (niwa-test--await 5 "Budgeted native turn did not settle"
          (not (niwa-turn-busy-p buffer))))
      (ert-info ((format "%S %s" (plist-get (niwa-engine-info request) :error) niwa-test--captured))
        (should (eq 'success (plist-get (niwa-engine-info request) :niwa-acp-outcome))))
      (should (string-search "50%" (or (cadr crossings) "")))
      (should (string-search "80%" (or (car crossings) "")))
      (should (string-search "100%" (or (car crossings) "")))
      (should-not (string-search "50%" (or (car crossings) "")))
      (should (equal '((:input 80 :output 45 :cached 1000 :cache 50)
                       (:input 50 :output 20 :cached 500 :cache 40)) readings))
      (should (= 125 (niwa-goal-tokens-used goal)))
      (should (= 1 (niwa-goal-turns-run goal)))
      (should (eq 'budget-limited (niwa-goal-status goal))))))

(niwa-deftest niwa-goal-start/claude-continuation (:quiet t)
  (niwa-engine-test--with-claude-session
    (niwa-request-end)
    (let* ((view (generate-new-buffer " *claude-goal-composer*"))
           (file (file-name-concat root "evidence.txt"))
           (launches 0) prompts decisions goal
           (niwa-post-tool-use-functions
            (list (lambda (_event)
                    (when (memq launches '(2 3))
                      (when (= launches 2)
                        (with-current-buffer view
                          (niwa-view-composer-insert "Check the queued priority first")
                          (with-current-buffer (niwa-view-composer-buffer)
                            (niwa-view-send-follow-up))))
                      (with-current-buffer buffer (niwa-goal-pause)))
                    nil))))
      (unwind-protect
          (progn
            (write-region "Evidence" nil file nil 'silent)
            (setq-local gptel-system-prompt "Goal continuation fixture"
                        gptel-tools (list (niwa-tool-gptel-tool (niwa-tool-ensure "Read"))))
            (niwa-chat-install-request-hooks)
            (niwa-view--setup view buffer)
            (cl-letf (((symbol-function 'niwa-claude-code-launch)
                       (niwa-engine-test--claude-launch
                        (lambda (_system mcp _model _effort &optional id hook)
                          (cl-incf launches)
                          (list :observe (lambda (owner notification)
                                           (let ((message (alist-get 'message (alist-get 'params notification))))
                                             (when (equal "user" (alist-get 'type message))
                                               (cl-pushnew (map-nested-elt message '(message content)) prompts :test #'equal)))
                                           (niwa-claude-code--observe owner notification))
                                :control (lambda (owner event)
                                           (let ((decision (niwa-claude-code--control owner event)))
                                             (push decision decisions)
                                             decision))
                                :meta `((hookCommand . ,hook)
                                        (toolBatches . [[((name . "Read")
                                                          (id . ,(format "read-%d" launches))
                                                          (args . ((file_path . ,file))))]])
                                        (promptResponse . ((stopReason . "end_turn")
                                                           (usage . ((inputTokens . 10) (outputTokens . 5)
                                                                     (cachedWriteTokens . 0)))))))))))
              (setq goal (niwa-goal-start "Continue until the user pauses"))
              (niwa-test--await 8 "Automatic native continuation did not pause"
                (not (or (< (niwa-goal-turns-run goal) 2) (niwa-turn-busy-p buffer))))
              (should (= 2 launches))
              (should (eq 'paused (niwa-goal-status goal)))
              (should (equal "Check the queued priority first"
                             (plist-get (car (niwa-session-pending-follow-ups session)) :input)))
              (should (eq :json-false (plist-get (car decisions) :continue)))
              (should (string-search "goal-paused" (plist-get (car decisions) :stopReason)))
              (niwa-goal-resume)
              (niwa-test--await 8 "Resumed native Goal did not deliver queued input"
                (not (or (< (niwa-goal-turns-run goal) 3) (niwa-turn-busy-p buffer))))
              (should (= 3 launches))
              (should (eq 'paused (niwa-goal-status goal)))
              (should-not (niwa-session-pending-follow-ups session))
              (should (cl-some (lambda (block)
                                 (equal "Check the queued priority first" (alist-get 'text block)))
                               (car prompts)))
              (should (= 45 (niwa-goal-tokens-used goal)))
              (should (= 3 (niwa-session-turn-count session)))))
        (when (buffer-live-p view) (kill-buffer view))))))

(niwa-deftest niwa-goal-start/claude-stable-system-prompt (:quiet t)
  ,test
  (test)
  :doc "Goal turns resume Claude with an unchanged system prompt"
  (niwa-engine-test--with-claude-session
    (niwa-request-end)
    (let* ((file (file-name-concat root "evidence.txt"))
           (launches 0) systems goal
           (niwa-post-tool-use-functions
            (list (lambda (_event)
                    (when (= launches 2)
                      (with-current-buffer buffer (niwa-goal-pause)))
                    nil))))
      (write-region "Evidence" nil file nil 'silent)
      (setq-local gptel-system-prompt "Goal stable prompt fixture"
                  gptel-tools (list (niwa-tool-gptel-tool (niwa-tool-ensure "Read"))))
      (niwa-chat-install-request-hooks)
      (cl-letf (((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (system _mcp _model _effort &optional _id hook)
                    (cl-incf launches)
                    (push system systems)
                    (list :meta `((hookCommand . ,hook)
                                  (toolBatches . [[((name . "Read")
                                                    (id . ,(format "read-%d" launches))
                                                    (args . ((file_path . ,file))))]])
                                  (promptResponse . ((stopReason . "end_turn")
                                                     (usage . ((inputTokens . 10) (outputTokens . 5)
                                                               (cachedWriteTokens . 0)))))))))))
        (setq goal (niwa-goal-start "Continue until paused"))
        (niwa-test--await 8 "Goal continuation did not pause"
          (not (or (< (niwa-goal-turns-run goal) 2) (niwa-turn-busy-p buffer))))
        (should (= 2 launches))
        (should (equal (car systems) (cadr systems)))
        (should-not (string-search "Continue until paused" (cadr systems)))
        (let ((goals (cl-loop for record in (niwa-transcript-audit-records
                                            (buffer-string) 'injected-reminders)
                              append (cl-loop for item in (plist-get record :items)
                                              when (and (eq 'context-active-goal (plist-get item :type))
                                                        (string-search "Continue until paused" (plist-get item :body)))
                                              collect (plist-get item :body)))))
          (should (= 1 (length goals)))
          (should-not (string-search "Turns run:" (car goals))))))))

(niwa-deftest niwa-agent-control-spawn/claude-goal-usage (:quiet t)
  (niwa-engine-test--with-claude-session
    (let* ((niwa-goal-token-budget 100)
           (goal (niwa-goal-create "Investigate with a retained child" :session session))
           (file (file-name-concat root "evidence.txt"))
           (launches 0) record invocation warnings readings)
      (write-region "Evidence" nil file nil 'silent)
      (niwa-tool-ensure "Read")
      (setq-local gptel-system-prompt "Goal parent fixture" gptel-tools nil)
      (unwind-protect
          (cl-letf (((symbol-function 'niwa-claude-code-launch)
                     (niwa-engine-test--claude-launch
                      (lambda (_system mcp _model _effort &optional id hook)
                        (cl-incf launches)
                        (list :control (lambda (owner event)
                                         (push (niwa-goal-tokens-used goal) readings)
                                         (let ((result (niwa-claude-code--control owner event)))
                                           (push (plist-get (plist-get result :hookSpecificOutput) :additionalContext) warnings)
                                           result))
                              :meta (when (> launches 1)
                                      `((hookCommand . ,hook)
                                        (sdkBeforeBatches . [[((type . "assistant")
                                                               (parent_tool_use_id . nil)
                                                               (message . ((id . "child-sample")
                                                                           (usage . ((input_tokens . 40)
                                                                                     (cache_creation_input_tokens . 10)
                                                                                     (cache_read_input_tokens . 500)
                                                                                     (output_tokens . 20))))))]])
                                        (toolBatches . [[((name . "Read") (id . ,(format "child-read-%d" launches))
                                                          (args . ((file_path . ,file))))]])
                                        ;; The missing input counter must retain streamed input.
                                        (promptResponse . ((stopReason . "end_turn")
                                                           (usage . ((outputTokens . 25))))))))))))
            (niwa--insert-user-turn "wait")
            (niwa--send-request "wait")
            (niwa-test--await 5 "Root subscription request did not start"
              (string-search "waiting" (buffer-string)))
            (dotimes (phase 2)
              (if (zerop phase)
                  (niwa-agent-control-spawn
                   session "reader" "Read the evidence."
                   (lambda (value) (setq record (plist-get value :record)))
                   :agent (niwa-agent--create :name "reader" :description "Read evidence"
                                                :tools '(Read) :system-prompt "Read evidence")
                   :on-invocation (lambda (value) (setq invocation value)))
                (niwa-agent-control-send-message session "/root/reader" "Read again.")
                (setq invocation (niwa-agent-record-invocation record)))
              (ert-info ((format "Child admission: %s" niwa-test--captured))
                (should (niwa-agent-invocation-p invocation)))
              (niwa-test--await 8 "Goal child did not settle"
                (niwa-agent-invocation-runtime-settled-p invocation))
              (should (eq 'completed (niwa-agent-record-settled-outcome record)))
              (should (= (* 75 (1+ phase)) (niwa-goal-tokens-used goal)))
              (should (= 0 (niwa-goal-turns-run goal))))
            (should (equal '(145 70) readings))
            (should (string-search "50%" (or (cadr warnings) "")))
            (should (string-search "whole token budget" (or (car warnings) "")))
            (should (niwa-turn-busy-p buffer))
            (niwa-abort buffer)
            (niwa-test--await 5 "Goal parent did not abort" (not (niwa-turn-busy-p buffer))))
        (when (niwa-turn-busy-p buffer) (niwa-abort buffer))
        (when (and record (buffer-live-p (niwa-agent-record-conversation-buffer record)))
          (kill-buffer (niwa-agent-record-conversation-buffer record)))))))

(niwa-deftest niwa-goal-start/claude-verification (:quiet t)
  (niwa-engine-test--with-claude-session
    (niwa-request-end)
    (let* ((niwa-model-workloads '((goal-review :provider "Claude Code:opus")))
           (roots 0) (verifiers 0) decisions verifier-prompts goal)
      (niwa-tools-register)
      (setq-local gptel-system-prompt "Completion fixture"
                  gptel-tools (list (niwa-tool-gptel-tool (niwa-tool-ensure "UpdateGoal"))))
      (niwa-chat-install-request-hooks)
      (unwind-protect
          (cl-letf (((symbol-function 'niwa-claude-code-launch)
                 (niwa-engine-test--claude-launch
                  (lambda (_system mcp model _effort &optional id hook)
                    (let ((child (bound-and-true-p niwa--agent-invocation)))
                      (if child (cl-incf verifiers) (cl-incf roots))
                      (when (> roots 2) (ert-fail "Completion started an unexpected third root turn"))
                      (should (equal (if child "opus" "sonnet") model))
                      (list :observe (lambda (owner notification)
                                       (let ((message (alist-get 'message (alist-get 'params notification))))
                                         (when (and child (equal "user" (alist-get 'type message)))
                                           (cl-pushnew (map-nested-elt message '(message content))
                                                       verifier-prompts :test #'equal)))
                                       (niwa-claude-code--observe owner notification))
                            :control (lambda (owner event)
                                       (let ((decision (niwa-claude-code--control owner event)))
                                         (push decision decisions)
                                         decision))
                            :meta (append
                                   `((hookCommand . ,hook)
                                     (promptResponse . ((stopReason . "end_turn")
                                                        (usage . ((inputTokens . 10) (outputTokens . 5)
                                                                  (cachedWriteTokens . 0))))))
                                   (if child
                                       `((responseText . ,(if (= verifiers 1)
                                                              "The acceptance check is missing.\nVERDICT: FAIL"
                                                            "The acceptance check passed.\nVERDICT: PASS")))
                                     `((toolBatches . [[((name . "UpdateGoal")
                                                         (id . ,(format "complete-%d" roots))
                                                         (args . ((status . "complete")
                                                                  (summary . "Untrusted implementer assertion"))))]]))))))))))
        (setq goal (niwa-goal-start "Implement the independently checked fixture"))
        (niwa-test--await 12 (format "Native completion did not settle: roots=%d verifiers=%d status=%s reason=%s transcript=%s diagnostics=%s"
                                      roots verifiers (niwa-goal-status goal)
                                      (niwa-goal-reason goal)
                                      (buffer-substring-no-properties (max (point-min) (- (point-max) 1800)) (point-max))
                                      niwa-test--captured)
          (and (eq 'complete (niwa-goal-status goal))
               (not (niwa-turn-busy-p buffer))))
        (should (= 2 roots))
        (should (= 2 verifiers))
        (should (= 2 (niwa-goal-turns-run goal)))
        (should (= 60 (niwa-goal-tokens-used goal)))
        (should (string-search "goal-verification-failed" (plist-get (cadr decisions) :stopReason)))
        (should (string-search "completion verification returned FAIL" (buffer-string)))
        (should (string-search "Implement the independently checked fixture" (prin1-to-string verifier-prompts)))
        (should-not (string-search "Untrusted implementer assertion" (prin1-to-string verifier-prompts))))
        (dolist (entry (niwa-session-agent-registry session))
          (when-let* ((child-buffer (niwa-agent-record-conversation-buffer (cdr entry)))
                      ((buffer-live-p child-buffer)))
            (kill-buffer child-buffer)))))))

